---
import "../../styles/tokens.css";
import "../../styles/global.css";
import CurrentEvidenceNotice from "../review/CurrentEvidenceNotice.astro";
import CurrentOperationsNotice from '../review/CurrentOperationsNotice.astro';
import BacklogResearchNotice from '../review/BacklogResearchNotice.astro';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  canonical?: string;
}

const {
  title = "FTFN",
  description = "FTFN is a future-state intelligence platform tracking possibility, urgency, and the stack of dependencies behind what comes next.",
  robots = "index, follow",
  canonical,
} = Astro.props;
const canonicalUrl = canonical ? new URL(canonical, Astro.url).href : Astro.url.href;
const socialImageUrl = new URL("/og.png", Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="FTFN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FTFN Public Reference — Possibility. Urgency. Dependencies." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="brand" href="/">FTFN</a>
          <nav class="nav" aria-label="Primary">
            <a href="/signals/">Signals</a>
            <a href="/reference/">Reference</a>
            <a href="/reference/explore/1/">Explore</a>
            <a href="/review/">Review</a>
            <a href="/atlas/">Atlas</a>
            <a href="/research/">Research</a>
            <a href="/briefings/">Briefings</a>
            <a href="/method/">Method</a>
            <a href="/about/">About</a>
          </nav>
        </div>
      </header>
      <main class="site-main" id="main-content" tabindex="-1">
        <CurrentEvidenceNotice />
        <CurrentOperationsNotice />
        <BacklogResearchNotice />
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__inner">
          <p>42 is possibility. 59 is urgency. Civilization is a choice.</p>
          <p>
            <a href="/method/">Method and publication policy</a>
            · <a href="/updates/">Updates and corrections</a>
          </p>
          <p><a href="/data/">Public data exports</a></p>
        </div>
      </footer>
    </div>
  </body>
</html>
