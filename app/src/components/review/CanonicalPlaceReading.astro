---
import {canonicalPlaceReadings as edition,canonicalPlaceReview,placeReadingSources,placeReadingContext,placeReadingRelatedContexts,placeReadingAssignedGateContexts} from '../../lib/canonical-place-readings.mjs';
interface Props {record:(typeof edition.records)[number]}
const {record}=Astro.props;
const sources=placeReadingSources(record),context=placeReadingContext(record);
const relatedContexts=placeReadingRelatedContexts(record);
const assignedContexts=placeReadingAssignedGateContexts(record);
const decision=canonicalPlaceReview.records.find(r=>r.record_id===record.record_id)!;
---
<article class="page-section place-reading" data-canonical-place-reading={record.record_id}>
 <div class="eyebrow">{record.kind==='Context'?'Dated system context':'Dated place synthesis'} · {edition.review_date}</div>
 <h2>{record.title}</h2><p class="lede">{record.answer}</p>
 <p data-place-reading-review>Written and AI self-reviewed by Codex on {edition.review_date} under the <a href="/method/editorial-review/">owner-authorized review policy</a>. This reuses the dated inspections below; no new external source check or independent review is claimed.</p>
 <section data-place-reading-scope={record.kind}><h3>{record.kind==='Context'?'System context boundary':'Place boundary'}</h3><p>{record.scope}</p><p>{record.kind==='Context'?'This is retained system context, excluded from the eligible-place target. It adds zero counted places and no project-stage change or operating outcome.':'This is the same existing place identity. No additional place count, place-level stage, project-stage change or operating outcome is admitted.'}</p></section>
 {record.sections.map((section,index)=><section data-place-reading-section={index}><div class="eyebrow">{section.type}</div><h3>{section.heading}</h3><p>{section.text}</p>{section.source_ids.length>0&&<p class="citations">Retained source checks: {section.source_ids.map((id,i)=><>{i>0?' · ':''}<a href={`#place-source-${id}`}>{sources.find(s=>s.id===id)!.title}</a></>)}</p>}</section>)}
 {context&&<aside data-place-reading-context={context.receipt_id}><h3>{record.context_role}</h3><p>Latest saved inspection {context.source_checked_date} · {context.decision_status} · next related checkpoint {context.next_check_date}.</p><p>{context.next_action}</p><p>The full dated receipt remains above this reading. This appointment belongs to the named gate or companion, not every project in the place.</p></aside>}
 {relatedContexts.map(({label,relation,receipt})=><aside data-place-related-companion={receipt.receipt_id}><h3>{label}</h3><p>{relation}</p><p>Latest saved inspection {receipt.source_checked_date} · {receipt.decision_status} · next companion checkpoint {receipt.next_check_date}.</p><p>{receipt.bounded_finding}</p><p>{receipt.next_action}</p><a href={receipt.gate_route}>Read the separate gate and its retained receipts</a></aside>)}
 {assignedContexts.map(({label,relation,receipt})=><aside data-place-assigned-gate={receipt.receipt_id}><h3>{label}</h3><p>{relation}</p><p>Latest saved inspection {receipt.source_checked_date} · {receipt.decision_status} · next independent checkpoint {receipt.next_check_date}.</p><p>{receipt.bounded_finding}</p><p>{receipt.next_action}</p><a href={receipt.gate_route}>Read this independent gate and its retained receipts</a></aside>)}
 <section><h3>Next decisive evidence</h3><ul>{record.next_artifacts.map(item=><li>{item}</li>)}</ul></section>
 <section><h3>Retained source checks</h3><p>Inspection dates, publication dates and the November 22 synthesis date remain distinct. The notes below preserve exactly what each saved review retrieved or could not retrieve.</p><ol>{sources.map(source=><li id={`place-source-${source.id}`} data-place-reading-source={source.id}><p><a href={source.check.url}>{source.title}</a> · inspected {source.check.accessed_date}{source.check.source_date?` · recorded source date ${source.check.source_date}`:''}</p><p>{source.check.finding}</p><details><summary>Location and inspection limits</summary><p>{source.check.locator}</p><p>{source.check.access_result}</p><p>{source.check.limitation}</p><p>Retained receipt: {source.receipt_id}</p></details></li>)}</ol></section>
 <details data-place-reading-assessment={record.record_id}><summary>Exact-version AI assessment</summary><p>{decision.decision}</p><ul>{decision.findings.map(f=><li>{f}</li>)}</ul><p>Assessed text SHA-256: <code>{decision.sha256}</code></p><a href="/data/build-decisions.json">Download the reading, retained-source bindings and assessment</a></details>
 <nav aria-label="Related and historical accounts"><h3>Related readings</h3><ul>{record.related.map(link=><li><a href={link.route}>{link.title}</a></li>)}<li><a href={record.prior_route}>Earlier Atlas profile and its retained evidence</a></li></ul><p>These linked records retain their own scopes and review decisions.</p></nav>
</article>
<style>.place-reading{max-width:76ch;margin-inline:auto;line-height:1.75;overflow-wrap:anywhere}section,aside,nav{margin-block:1.75rem}.citations{font-size:.9rem}li{margin-block:.6rem}summary{cursor:pointer}summary:focus-visible{outline:3px solid currentColor;outline-offset:4px}code{overflow-wrap:anywhere}</style>
