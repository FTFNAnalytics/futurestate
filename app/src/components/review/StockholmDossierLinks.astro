---
import {stockholmDossiers,stockholmAcquisitionFor} from '../../lib/stockholm-named-dossiers.mjs';
interface Props {recordId:string}
const record=stockholmAcquisitionFor(Astro.props.recordId);
---
{record&&<section class="page-section prose-page" data-current-stockholm-acquisition={record.historical_acquisition.record_id}>
  <h2>Current named account</h2>
  <p><a href={record.route}>{record.title}</a> was authored and AI self-reviewed {stockholmDossiers.inspected_date}. {record.scope}</p>
  <p>{record.historical_acquisition.decision}. The original acquisition record below is retained history; its empty identity fields do not erase this later named account. No operating outcome, independent review, production acceptance or launch is admitted.</p>
</section>}
