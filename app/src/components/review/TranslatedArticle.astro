---
import {getCollection} from 'astro:content';
import ReviewHeader from './ReviewHeader.astro';
import {translatedReaders} from '../../lib/translated-readers.mjs';
import {readerSourceReviewContexts} from '../../lib/reader-presentation.mjs';
import {currentEvidenceLedger} from '../../lib/current-evidence.mjs';
import operations from '../../data/phase-207-current-operations.json';
import translations from '../../data/ai-reviewed-translations.json';
interface Props { article: typeof translations.records[number]; }
const {article}=Astro.props;
const ui=article.ui;
const sources=await getCollection('sources');
const byId=new Map(sources.map(source=>[source.data.id,source.data]));
const contexts=readerSourceReviewContexts(article,currentEvidenceLedger,operations,{route:Astro.url.pathname});
const alternatives=translatedReaders.filter(r=>r.topic_id===article.topic_id&&r.record_id!==article.record_id);
const anchor=(index:number)=>`${article.record_id.toLowerCase()}-section-${index+1}`;
---
<article class="translated-reader" lang={article.locale} data-translated-reader={article.record_id} data-translation-sha256={article.sha256}>
  <ReviewHeader eyebrow={ui.eyebrow} title={article.title} summary={article.overview} />
  <div class="page-section prose-page">
    <p><strong>{ui.status}</strong></p>
    <p data-translation-review>{article.review_notice}</p>
    <nav aria-label={ui.alternatives}><ul>
      <li><a href={article.english_route} hreflang="en">{ui.english}</a></li>
      {alternatives.map(other=><li><a href={other.route} lang={other.locale} hreflang={other.locale}>{other.ui.language}</a></li>)}
    </ul></nav>
    {contexts.length>0&&<aside aria-label={ui.contextTitle} data-translation-source-context>
      <h2>{ui.contextTitle}</h2><p>{ui.contextBoundary}</p>
      <div lang="en">{contexts.map(context=><section data-reader-source-review={context.id}>
        <h3><a href={context.route}>{context.title}</a></h3>
        <p>{context.summary}</p><p>{context.kind}. Checked {context.checked_date}.{context.next_check_date&&` Next bounded check ${context.next_check_date}.`}</p>
        <p>Cited sources: {context.matched_source_ids.map((id,i)=><>{i>0?'; ':''}<a href={`/atlas/sources/${id}/`}>{byId.get(id)!.name}</a></>)}</p>
      </section>)}</div>
    </aside>}
    <nav aria-label={ui.contents}><ul>{article.sections.map((section,index)=><li><a href={`#${anchor(index)}`}>{section.heading}</a></li>)}<li><a href="#translation-sources">{ui.sources}</a></li></ul></nav>
    {article.sections.map((section,index)=><section><h2 id={anchor(index)} tabindex="-1">{section.heading}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>)}
    <section><h2 id="translation-sources" tabindex="-1">{ui.sources}</h2><p>{ui.sourceBoundary}</p>
      <ul>{article.sources.map(source=><li data-reader-source={source.id}><a href={source.url} lang={'language' in source?String(source.language):article.locale}>{source.label}</a> · <a href={`/atlas/sources/${source.id}/`}>{ui.sourceNotes}</a></li>)}</ul>
    </section>
    <details><summary>{ui.contract}</summary><p>{ui.contractBoundary}</p><p><a href={article.historical_contract.route} hreflang="en">{article.record_id} · {ui.contract}</a></p><p lang="en">Translated English record: <code>{article.source_record_id}</code>. SHA-256: <code>{article.source_record_sha256}</code>. Preserved canonical-contract digest: <code>{article.historical_contract.canonical_content_digest}</code>.</p></details>
    <p><a href="/reference/accessible-editions/" hreflang="en">{ui.back}</a> · <a href="/data/build-decisions.json">{ui.export}</a></p>
  </div>
</article>
<style>
  .translated-reader :global(.prose-page){max-width:76ch;margin-inline:auto;line-height:1.75;overflow-wrap:anywhere;}
  .translated-reader :global(h2){margin-top:2rem;}
  summary{cursor:pointer;padding:1rem 0;}
  summary:focus-visible,h2:focus-visible{outline:3px solid currentColor;outline-offset:4px;}
</style>
