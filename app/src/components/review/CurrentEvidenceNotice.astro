---
import { evidenceReceiptsForRoute, currentEvidenceLedger } from '../../lib/current-evidence.mjs';
const receipts = (Astro.props.recordId ? currentEvidenceLedger.receipts.filter(receipt => receipt.affected_record_ids.includes(Astro.props.recordId)) : evidenceReceiptsForRoute(Astro.url.pathname)).sort((a,b)=>b.decision_date.localeCompare(a.decision_date));
---
{receipts.length > 0 && <aside class="page-section prose-page" aria-label="Dated evidence updates" data-current-evidence-notice>
  <h2>Dated evidence checks and corrections</h2>
  <p>Read these dated findings alongside the preserved earlier record below. A current-account correction is not independent qualification approval or authorization to publish.</p>
  {receipts.map(receipt => <article data-evidence-receipt={receipt.receipt_id}>
    <h3><a href={receipt.gate_route}>{receipt.receipt_type} · {receipt.cycle_item_id.replace('60-CYCLE-', '').replaceAll('-', ' ')}</a></h3>
    <p>{receipt.bounded_finding}</p>
    <p>Signal retained {receipt.underlying_signal_status}. Scheduled check: {receipt.scheduled_check_date}; {'follow_up_scheduled_date' in receipt&&`follow-up appointment: ${receipt.follow_up_scheduled_date}; `}actual review: {receipt.source_checked_date}; next bounded check: {receipt.next_check_date}. {receipt.counts_as_cycle_decision === false && 'Separate companion review; the original cycle decision is retained.'}{'review_kind' in receipt&&receipt.review_kind==='bounded_followup'&&' Dated follow-up on the existing gate; the earlier receipt remains history and no cycle identity is added.'}</p>
    {receipt.formal_artifact && <p><a href={receipt.formal_artifact.url}>Read the formal FAA instrument</a>. Issued {receipt.formal_artifact.issued_date}; effective {receipt.formal_artifact.effective_date}; expiry {receipt.formal_artifact.expiration_date}. Retrieved on {receipt.source_checked_date}.</p>}
    <details><summary>Evidence boundary and receipt</summary><p>{receipt.evidence_boundary}</p><p>Receipt: <code>{receipt.receipt_id}</code>. Local source projection recorded; Git-backed release held.</p>{'validation_boundary_at_recording' in receipt&&<p>{receipt.validation_boundary_at_recording}</p>}<a href="/data/current-evidence-decisions.json">Inspect checked sources and propagation assignments</a></details>
  </article>)}
</aside>}
