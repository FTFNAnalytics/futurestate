---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  phase?: number;
}

const { eyebrow, title, summary, phase } = Astro.props;
---

<header class="page-section review-hero">
  <div class="eyebrow">{phase ? `Phase ${phase} · ${eyebrow}` : eyebrow}</div>
  <h1>{title}</h1>
  <p class="lede">{summary}</p>
