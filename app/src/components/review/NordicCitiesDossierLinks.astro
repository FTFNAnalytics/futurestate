---
import {nordicCitiesDossiers,nordicCitiesAcquisitionFor} from '../../lib/nordic-cities-named-dossiers.mjs';
interface Props {recordId:string}
const record=nordicCitiesAcquisitionFor(Astro.props.recordId);
---
{record?.historical_acquisition&&<section class="page-section prose-page" data-current-nordic-cities-acquisition={record.historical_acquisition.record_id}>
  <h2>Current named account</h2>
  <p><a href={record.route}>{record.title}</a> was authored and AI self-reviewed {nordicCitiesDossiers.inspected_date}. {record.scope}</p>
  <p>{record.historical_acquisition.decision}. The original acquisition record below is retained history; its empty identity fields do not erase this later named account. No comparable outcome series, independent review, production acceptance or launch is admitted.</p>
</section>}
