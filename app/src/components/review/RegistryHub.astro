---
import ReviewHeader from "./ReviewHeader.astro";
import MetaPill from "../ui/MetaPill.astro";
import readerEdition from '../../data/phase-204-reader-completion.json';
import {annualCaseTitle, annualCaseOverview} from '../../lib/annual-case-reviews.mjs';
import {placeIdentityTitle, placeIdentityNotes} from '../../lib/place-identity-reviews.mjs';

interface Props {
  registry: any;
  phase: number;
  release: string;
  items: any[];
}

const { registry, phase, release, items } = Astro.props;
const itemId = (item: any) => Object.entries(item).find(([key]) => key.endsWith("_id"))?.[1] ?? item.slug ?? "record";
const readerFor = (item: any) => {
  if (!Astro.url.pathname.startsWith('/reference/')) return null;
  const article = readerEdition.records.find(article => article.record_id === itemId(item));
  return article ? {...article, title:annualCaseTitle(article, {route:item.route}), overview:annualCaseOverview(article, {route:item.route})} : null;
};
const readerCount = items.filter(item => readerFor(item)).length;
const itemTitle = (item: any) => placeIdentityTitle(item) ?? item.title ?? item.requirement ?? item.label ?? item.question ?? item.institution_name ?? item.project_name ?? item.place_name ?? itemId(item);
const itemState = (item: any) => item.state ?? item.verdict ?? item.decision_state ?? item.decision_status ?? item.release_state ?? item.audit_state ?? item.candidate_state ?? item.disposition_state ?? item.review_result ?? item.compatibility_decision ?? item.preservation_state ?? item.operation_state ?? item.board_state ?? item.matrix_state ?? item.packet_state ?? item.dossier_state ?? item.brief_state ?? item.runbook_state ?? item.baseline_packet_state ?? item.guide_state ?? item.report_state ?? item.map_state ?? item.triage_state ?? item.content_readiness ?? item.rereview_verdict ?? item.mission_decision_state ?? item.desk_state ?? item.resource_state ?? item.mission_state ?? item.edition_state ?? (Object.hasOwn(item, "current_stage") ? item.current_stage ?? "Stage not established" : null) ?? item.review_state ?? item.profile_state ?? item.identity_state ?? item.outcome_state ?? item.answer_state ?? item.case_kind ?? item.record_kind ?? item.build_status ?? "Published record";
const itemSummary = (item: any) => item.summary ?? item.current_read ?? item.question ?? item.thesis ?? item.purpose ?? item.focus ?? item.orientation ?? item.reader_bridge ?? item.reader_brief ?? item.conversion_question ?? item.rationale ?? item.evidence_identity ?? item.comparable_claim ?? item.prohibited_comparison ?? item.evidence_note ?? item.reason ?? item.readiness_basis ?? item.open_boundary ?? item.unresolved_boundary ?? item.unresolved_bridge ?? item.decisive_next_action ?? item.exact_next_artifact ?? item.next_artifact ?? item.next_action ?? item.next_record ?? item.check_result ?? item.interpretation_boundary ?? item.boundary ?? "Inspect the complete record below for its evidence and publication boundary.";
const itemRoute = (item: any) => item.route && !item.route.includes("#") ? item.route : null;
const countEntries = Object.entries(registry.counts ?? {}).slice(0, 4);
const readable = (key: string) => key.replaceAll("_", " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
const summaryKeys = new Set(["slug", "title", "route", "summary", "current_read", "question", "thesis", "purpose", "focus", "orientation", "reader_brief", "conversion_question", "rationale", "evidence_identity", "comparable_claim", "prohibited_comparison", "evidence_note", "reason", "readiness_basis", "open_boundary", "unresolved_boundary", "unresolved_bridge", "decisive_next_action", "exact_next_artifact", "next_artifact", "next_action", "next_record", "check_result", "interpretation_boundary", "boundary"]);
const detailEntries = (item: any) => Object.entries(item).filter(([key]) => !summaryKeys.has(key));
const summaryPreview = (item: any) => {
  const value = String(itemSummary(item));
  if (value.length <= 720) return value;
  return `${value.slice(0, 716).replace(/\s+\S*$/, "").trimEnd()}…`;
};
const linkFor = (key: string, value: unknown) => {
  if (typeof value !== "string") return null;
  if (/^https?:\/\//.test(value)) return value;
  if (/route$/.test(key) && value.startsWith("/")) return value;
  if (/source_ids?$/.test(key) && value.startsWith("source-")) return `/atlas/sources/${value}/`;
  return null;
};
const external = (href: string) => /^https?:\/\//.test(href);
---

<ReviewHeader eyebrow={`${release} public intelligence program`} title={registry.title} summary={registry.summary} phase={phase} />

{readerCount > 0 && <section class="page-section prose-page"><h2>{readerCount} expanded reader texts</h2><p>The September 10 reader layer appears first on each available article. Independent subject and accessibility review remain pending. Counts and research contracts below preserve the September 1 baseline; they are not claims of newly admitted evidence or approved translations.</p></section>}

<section class="page-section">
  <div class="metric-strip" aria-label={`Phase ${phase} counts`}>
    {countEntries.map(([label, value]) => <div class="metric"><strong>{typeof value === "number" ? value.toLocaleString() : value}</strong><span>{label.replaceAll("_", " ")}</span></div>)}
  </div>
</section>

<section class="page-section briefing-band">
  <div class="briefing-band__copy">
    <div class="eyebrow">Governing boundary</div>
    <h2>Complete content, explicit stopping points.</h2>
    <p>{registry.publication_boundaries?.[0]}</p>
  </div>
  <article class="record-card record-card--featured">
    <MetaPill label={registry.build_status ?? "Complete locally"} tone="review" />
    <h3>Machine-readable contract</h3>
    <p>Every displayed record is available in the schema-1.0 phase export.</p>
    <a class="inline-link" href={registry.routes.public_export}>Open Phase {phase} JSON</a>
  </article>
</section>

<section class="page-section">
  <div class="section-heading"><div><div class="eyebrow">Phase {phase} record set</div><h2>{items.length.toLocaleString()} inspectable records.</h2><p>IDs, upstream joins, evidence states, open boundaries, and next actions stay attached to each record.</p></div></div>
  <div class="signal-grid">
    {items.map((item) => (
      <article class="record-card" id={item.slug ?? String(itemId(item)).toLowerCase()}>
        <div class="meta-row"><MetaPill label={String(itemId(item))} /><MetaPill label={readerFor(item) ? 'Reader draft · review pending' : String(itemState(item))} tone="review" /></div>
        <h3>{itemRoute(item) ? <a href={itemRoute(item)}>{readerFor(item)?.title ?? itemTitle(item)}</a> : itemTitle(item)}</h3>
        <p>{readerFor(item)?.overview ?? summaryPreview(item)}</p>
        {placeIdentityNotes(item).length > 0 && <p data-place-identity-card={String(itemId(item))}>September 22 location check: {placeIdentityNotes(item).find(n => n.record_id === itemId(item))?.finding ?? 'Related place notes distinguish project locations from geographic boundaries. Read the dated notes before using this comparison.'}</p>}
        {itemRoute(item) && <a class="inline-link" href={itemRoute(item)}>Open complete record</a>}
        {!itemRoute(item) && (
          <details>
            <summary>Inspect complete record</summary>
            <dl>
              {detailEntries(item).map(([key, value]: [string, any]) => (
                <>
                  <dt><strong>{readable(key)}</strong></dt>
                  <dd>
                    {Array.isArray(value) ? (
                      value.length ? <div class="source-list">{value.map((entry: any) => entry && typeof entry === "object" ? <div class="source-row">{Object.entries(entry).map(([childKey, childValue]: [string, any]) => <p><strong>{readable(childKey)}:</strong> {Array.isArray(childValue) ? childValue.map((nested, index) => <>{index > 0 && " · "}{linkFor(childKey, nested) ? <a href={linkFor(childKey, nested)!}>{String(nested)}</a> : String(nested)}</>) : childValue && typeof childValue === "object" ? JSON.stringify(childValue) : linkFor(childKey, childValue) ? <a href={linkFor(childKey, childValue)!} target={external(linkFor(childKey, childValue)!) ? "_blank" : undefined} rel={external(linkFor(childKey, childValue)!) ? "noreferrer" : undefined}>{String(childValue)}</a> : String(childValue ?? "Not established")}</p>)}</div> : <div class="source-row"><span>{linkFor(key, entry) ? <a href={linkFor(key, entry)!}>{String(entry)}</a> : String(entry)}</span></div>)}</div> : "None recorded"
                    ) : value && typeof value === "object" ? (
                      <div class="source-row">{Object.entries(value).map(([childKey, childValue]: [string, any]) => <p><strong>{readable(childKey)}:</strong> {Array.isArray(childValue) ? childValue.map((nested, index) => <>{index > 0 && " · "}{linkFor(childKey, nested) ? <a href={linkFor(childKey, nested)!}>{String(nested)}</a> : String(nested)}</>) : childValue && typeof childValue === "object" ? JSON.stringify(childValue) : linkFor(childKey, childValue) ? <a href={linkFor(childKey, childValue)!} target={external(linkFor(childKey, childValue)!) ? "_blank" : undefined} rel={external(linkFor(childKey, childValue)!) ? "noreferrer" : undefined}>{String(childValue)}</a> : String(childValue ?? "Not established")}</p>)}</div>
                    ) : linkFor(key, value) ? <a href={linkFor(key, value)!} target={external(linkFor(key, value)!) ? "_blank" : undefined} rel={external(linkFor(key, value)!) ? "noreferrer" : undefined}>{String(value)}</a> : String(value ?? "Not established")}
                  </dd>
                </>
              ))}
            </dl>
          </details>
        )}
      </article>
    ))}
  </div>
</section>

<section class="page-section prose-page">
  <h2>Publication boundaries</h2>
  <ul>{registry.publication_boundaries?.map((boundary: string) => <li>{boundary}</li>)}</ul>
  <p><a href={`/review/${release}/`}>Return to the {release} edition</a> · <a href="/data/">Browse public data</a></p>
</section>
