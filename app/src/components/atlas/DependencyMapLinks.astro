---
import PagedShelf from '../review/PagedShelf.astro';
import {getShelfCatalog} from '../../lib/shelf-catalog';
import {readingShelfKey} from '../../lib/reading-shelf-relations.mjs';
interface Props {
  recordId:string;
  kind?:'signal-maps'|'briefing';
  title?:string;
  description?:string;
}
const {recordId,kind='signal-maps',title='Dependency maps using this signal.',description='These maps explicitly cite this signal ID. A backlink is not independent verification of its claim.'}=Astro.props;
const shelf=readingShelfKey(kind,recordId),records=(await getShelfCatalog())[shelf];
if(kind==='briefing'&&!records)throw new Error(`Missing briefing relationship archive: ${recordId}`);
---
{records&&records.length>0&&<section class="page-section" data-reading-relationships={shelf}>
  <h2>{title}</h2>
  <p>{description}</p>
  <PagedShelf records={records} kind={shelf} limit={20} headingLevel={3}/>
</section>}
