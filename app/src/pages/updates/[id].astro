---
import {getCollection} from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import UpdateReceipt from '../../components/review/UpdateReceipt.astro';
export async function getStaticPaths(){return (await getCollection('updates')).map(update=>({params:{id:update.data.id},props:{update}}));}
const {update}=Astro.props;
---
<BaseLayout title={`${update.data.title} | FTFN`} description={update.data.summary}>
  <section class="page-section"><h1 class="page-title">{update.data.title}</h1><p><a href="/updates/">All updates and corrections</a>. This is a dated historical receipt, not a claim that a source was checked again today.</p><UpdateReceipt update={update}/></section>
</BaseLayout>
