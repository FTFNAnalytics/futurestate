---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PagedShelf from '../../components/review/PagedShelf.astro';
import {getShelfCatalog} from '../../lib/shelf-catalog';
const {updates}=await getShelfCatalog();
---
<BaseLayout title="Updates and Corrections | FTFN" description="The complete, dated FTFN history of corrections, source checks and publication decisions.">
  <section class="page-section"><h1 class="page-title">Updates and corrections</h1>
    <p class="lede">Evidence decisions should remain visible, including checks that change nothing. Search all {updates.length} dated entries by subject, receipt ID or affected record. Open any entry for its complete evidence note and decision history.</p>
    <p>A correction repairs an inaccurate claim. A source refresh records an evidence update. A publication decision is distinct from source ingestion. A no-material-change receipt states what was checked and retained without claiming that a missing artifact does not exist.</p>
    <p>Dates and outcomes below describe the recorded decisions, not new checks performed by this page. Nothing here creates an automated publishing approval.</p>
    <p><a href="/data/signals.json">Historical Published signal export</a> · <a href="/data/sources.json">Source metadata</a> · <a href="/data/shelves/updates.json">Searchable update index</a></p>
    <PagedShelf records={updates} kind="updates"/>
  </section>
</BaseLayout>
