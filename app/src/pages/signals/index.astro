---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PagedShelf from '../../components/review/PagedShelf.astro';
import {getShelfCatalog} from '../../lib/shelf-catalog';
import ledger from '../../data/phase-206-editorial-classification.json';
const {signals}=await getShelfCatalog();
---
<BaseLayout title="Signals | FTFN">
  <section class="page-section">
    <h1 class="page-title">Structured developments across the future stack.</h1>
    <p class="lede">Browse by question, topic and evidence state. The complete shelf is paginated; search covers every included record.</p>
    <p><a href="/method/editorial-review/">{ledger.records.length} records are excluded: {ledger.remaining_original_cohort_reviews} original candidates and {ledger.remaining_additional_cohort_reviews} additional workflow-origin records await review; {ledger.individually_reviewed} have classification decisions but retain their holds. Browse their separate classification archive.</a> Historical publication labels are preserved separately. In Review records remain labeled; their inclusion is not publication approval.</p>
    <PagedShelf records={signals} kind="signals"/>
  </section>
</BaseLayout>
