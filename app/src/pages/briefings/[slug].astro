---
import {projectBriefing} from "../../lib/reference-attribution.mjs";
import { getCollection, render } from "astro:content";
import DependencyMapLinks from "../../components/atlas/DependencyMapLinks.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import ReferenceAttributionNotice from "../../components/review/ReferenceAttributionNotice.astro";
import MetaPill from "../../components/ui/MetaPill.astro";
import {
  formatDate,
  getClaimScopeNote,
  getLocalEvidenceNote,
  getStatusNote,
  getStatusTone
} from "../../lib/editorial";

export async function getStaticPaths() {
  const briefings = await getCollection("briefings").then(records => records.map(projectBriefing));

  return briefings.map((briefing) => ({
    params: { slug: briefing.data.slug },
    props: { briefing }
  }));
}

const { briefing } = Astro.props;
const { Content } = await render(briefing);
const briefingDate = briefing.data.published_date ?? briefing.data.captured_date;
const briefingSignalIds = new Set(briefing.data.signal_ids);
const briefingEvidenceGapIds = new Set(briefing.data.evidence_gap_ids);
const evidenceGapSummary =
  briefingEvidenceGapIds.size > 0 ? `${briefingEvidenceGapIds.size} linked gap${briefingEvidenceGapIds.size === 1 ? "" : "s"}` : "No linked gaps";
const lastReviewedSummary = briefing.data.last_reviewed_date
  ? formatDate(briefing.data.last_reviewed_date)
  : "Not recorded";
const robots = briefing.data.record_status === "Published" ? "index, follow" : "noindex, follow";
---

<BaseLayout title={`${briefing.data.title} | FTFN`} description={briefing.data.summary} robots={robots}>
  <article class="page-section">
    <div class="eyebrow">Briefing</div>
    <h1 class="page-title">{briefing.data.title}</h1>
    <p class="lede">{briefing.data.summary}</p>
    <div class="meta-row">
      <MetaPill label={briefing.data.record_status} tone={getStatusTone(briefing.data.record_status)} />
      <MetaPill label={briefingDate.toISOString().slice(0, 10)} />
      <MetaPill label={`${briefingSignalIds.size} linked signal records`} />
      <MetaPill label={briefing.data.claim_scope} />
      <MetaPill label={briefing.data.local_evidence_level} />
    </div>
  </article>

  <section class="page-section">
    <div class="status-panel">
      <div class="status-item">
        <h2>{briefing.data.record_status}</h2>
        <p>{getStatusNote(briefing.data.record_status, Boolean(briefing.data.editorial_attribution))}</p>
      </div>
      <div class="status-item">
        <h2>Evidence Base</h2>
        <p>FTFN synthesis of linked records. A reference alone does not verify a claim; method notes and historical holds are not external operating evidence.</p>
      </div>
      <div class="status-item">
        <h2>Publication Limit</h2>
        <p>Keep as draft or in review until every referenced claim passes final publication review.</p>
      </div>
      <div class="status-item">
        <h2>{briefing.data.claim_scope}</h2>
        <p>{getClaimScopeNote(briefing.data.claim_scope)}</p>
      </div>
      <div class="status-item">
        <h2>{briefing.data.local_evidence_level}</h2>
        <p>{getLocalEvidenceNote(briefing.data.local_evidence_level)}</p>
      </div>
      <div class="status-item">
        <h2>{evidenceGapSummary}</h2>
        <p>Last reviewed: {lastReviewedSummary}</p>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="grid">
      <div>
        <h2>Top Takeaways</h2>
        <ul>
          {briefing.data.top_takeaways.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h2>Constraint Watch</h2>
        <div class="meta-row">
          {briefing.data.constraint_watch.map((constraint) => (
            <MetaPill label={constraint} tone="urgency" />
          ))}
        </div>
      </div>
      <div>
        <h2>{briefing.data.editorial_attribution ? 'Historical watch list (August 10)' : 'What To Watch Next'}</h2>
        <ul>
          {briefing.data.what_to_watch_next.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <ReferenceAttributionNotice review={briefing.data.editorial_attribution} />
  {briefing.data.editorial_attribution && <section class="page-section"><h2>Historical briefing text follows</h2><p>The original proof heading, takeaways and watch list describe the August 10 workflow snapshot. They do not establish current production readiness or today's operating calendar.</p></section>}
  <section class="page-section prose">
    <Content />
  </section>

  <DependencyMapLinks
    kind="briefing"
    recordId={briefing.data.id}
    title="Referenced records and related maps"
    description="Signals and evidence gaps are direct references from this briefing. Maps appear through shared signal or evidence-gap IDs, not because they cite this briefing or independently verify it. Historical methods and research dockets remain labeled with their classifications and feed holds."
  />
</BaseLayout>
