---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PagedShelf from '../../components/review/PagedShelf.astro';
import {getShelfCatalog} from '../../lib/shelf-catalog';

const {briefings}=await getShelfCatalog();
---

<BaseLayout title="Briefings | FTFN">
  <section class="page-section">
    <div class="eyebrow">Briefings</div>
    <h1 class="page-title">Synthesis across signals and constraints.</h1>
    <p class="lede">
      FTFN syntheses of developments, research questions and methods. Historical
      workflow briefings are not current external developments or source checks.
    </p>
  </section>

  <section class="page-section">
    <PagedShelf records={briefings} kind="briefings" />
  </section>
</BaseLayout>
