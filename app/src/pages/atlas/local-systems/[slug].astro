---
import {getCollection,render} from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import {placeReadingForPriorRoute} from '../../../lib/canonical-place-readings.mjs';
import {regionalReadingForPriorRoute} from '../../../lib/canonical-regional-readings.mjs';
import ReaderPathwaySummary from '../../../components/atlas/ReaderPathwaySummary.astro';
import CurrentEvidenceNotice from '../../../components/review/CurrentEvidenceNotice.astro';
import CurrentOperationsNotice from '../../../components/review/CurrentOperationsNotice.astro';
import PagedShelf from '../../../components/review/PagedShelf.astro';
import {getShelfCatalog} from '../../../lib/shelf-catalog';
import {getLocalEvidenceNote} from '../../../lib/editorial';
import {createMarkdownProcessor} from '@astrojs/markdown-remark';
import GoldenMarsReviewNotice from '../../../components/review/GoldenMarsReviewNotice.astro';
import {projectGoldenMarsSystemBody} from '../../../lib/golden-mars-wider-review.mjs';
import retainedGoldenMarsSystem from '../../../content/local-systems/local-northern-virginia-data-center-corridor.mdx?raw';
export async function getStaticPaths(){return (await getCollection('localSystems')).map(system=>({params:{slug:system.data.slug},props:{system}}));}
const {system}=Astro.props;const {Content}=await render(system);
const currentPlaceReading=placeReadingForPriorRoute(Astro.url.pathname)??regionalReadingForPriorRoute(Astro.url.pathname);
const kind=`local-${system.data.slug}`,records=(await getShelfCatalog())[kind];
const pathways=(await getCollection('readerPathways')).filter(p=>p.data.local_system_ids.includes(system.data.id));
const gaps=(await getCollection('evidenceGaps')).filter(g=>system.data.evidence_gap_ids.includes(g.data.id));
const date=(d:Date)=>d.toISOString().slice(0,10);
const citedCount=records.filter(r=>r.filters.relationship?.includes('Cited by local profile')).length;
const candidateCount=records.filter(r=>r.filters.relationship?.includes('Geography/role candidate — not cited by this profile')).length;
const revisedBody=projectGoldenMarsSystemBody(system.data.id,retainedGoldenMarsSystem);
let currentBodyHtml='',originalBodyHtml='';
if(revisedBody){
  const processor=await createMarkdownProcessor({gfm:true,smartypants:false});
  currentBodyHtml=(await processor.render(revisedBody.current)).code;
  originalBodyHtml=(await processor.render(revisedBody.original)).code.replace(/ id="([^"]*)"/g,' id="retained-$1"').replace(/ href="#/g,' href="#retained-');
}
---
<BaseLayout title={`${system.data.name} | FTFN`} description={system.data.summary}>
  <section class="page-section" data-local-overview={system.data.id}>
    <h1 class="page-title">{system.data.name}</h1><p class="lede">{system.data.summary}</p>
    <p>{system.data.system_type} · {system.data.geography} · {system.data.local_evidence_level}{system.data.last_reviewed_date?` · Recorded review ${date(system.data.last_reviewed_date)}`:''}</p>
    <CurrentEvidenceNotice recordId={system.data.id}/><CurrentOperationsNotice recordId={system.data.id}/>
    <p><a href="#local-records">Explore all {records.length} linked records</a> · <a href="#system-narrative">{revisedBody?'Read the system narrative and dated correction':'Read the complete preserved system narrative'}</a></p>
    {system.data.id==='local-ontario-real-estate'&&<p><a href="/reference/global-places-ii/ontario-real-estate/">Read the expanded Ontario place draft</a> — independent review pending.</p>}
  </section>
  <GoldenMarsReviewNotice recordId={system.data.id}/>
  {currentPlaceReading&&<aside class="page-section" data-current-place-reading-link={currentPlaceReading.record_id}><h2>Later dated place synthesis</h2><p><a href={currentPlaceReading.route}>{currentPlaceReading.title}</a> — November 22, 2026. This reading reuses retained inspections; the profile below and its project links keep their own scope and review history.</p></aside>}
  <section class="page-section"><h2>Current equilibrium and constraints</h2><p>{system.data.current_equilibrium}</p><p><strong>Core constraints:</strong> {system.data.core_constraints.join(' · ')}</p><p>{getLocalEvidenceNote(system.data.local_evidence_level)}</p></section>
  {pathways.map(pathway=><ReaderPathwaySummary pathway={pathway}/>)}
  <section class="page-section" id="local-records"><h2>Explore this local system</h2>
    <p>{citedCount} sources are explicitly cited by this profile; {candidateCount} additional sources are geography/role suggestions only. Filter by relationship to distinguish them. A shared geography does not establish project-level support or local outcomes.</p>
    <p>Dependency maps require an explicit local-system ID; signals require the named receiving system and remain subject to current classification exclusions. Source freshness is metadata, not a new check. <a href="/method/editorial-review/">Open the separate classification archive.</a></p>
    <PagedShelf records={records} kind={kind} limit={20} headingLevel={3}/>
  </section>
  {gaps.length>0&&<section class="page-section"><h2>Evidence gaps</h2><div class="grid">{gaps.map(g=><article class="record-card" data-overview-card={g.data.id}><h3><a href={`/atlas/evidence-gaps/${g.data.slug}/`}>{g.data.title}</a></h3><p>{g.data.next_action}</p><p>{g.data.status} · {g.data.priority}</p></article>)}</div></section>}
  <section class="page-section two-column-section">
    <div><h2>Key industries</h2><ul>{system.data.key_industries.map(v=><li>{v}</li>)}</ul><h2>Actors with authority</h2><ul>{system.data.actors_with_authority.map(v=><li>{v}</li>)}</ul></div>
    <div><h2>Second-order effects to examine</h2><ul>{system.data.likely_second_order_effects.map(v=><li>{v}</li>)}</ul><h2>Missing data</h2><ul>{system.data.missing_data.map(v=><li>{v}</li>)}</ul></div>
  </section>
  <section class="page-section prose" id="system-narrative">
    {revisedBody?<>
      <div data-golden-mars-current-system={system.data.id} set:html={currentBodyHtml}/>
      <details data-golden-mars-original-system={system.data.id}><summary>Original system narrative · retained August 11 review</summary><div set:html={originalBodyHtml}/></details>
    </>:<Content/>}
  </section>
</BaseLayout>
