---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import PagedShelf from '../../../components/review/PagedShelf.astro';
import {getShelfData} from '../../../lib/shelf-catalog';
const {sourceRows,shelves,asOfDate}=await getShelfData();
const count=(status:string)=>sourceRows.filter(r=>r.freshness.status===status).length;
const lanes=[...new Set(sourceRows.flatMap(r=>r.source.watch_lanes??[]))].sort() as string[];
const laneRows=lanes.map(lane=>{const rows=sourceRows.filter(r=>(r.source.watch_lanes??[]).includes(lane));return {lane,count:rows.length,due:rows.filter(r=>r.freshness.status==='Review due').length,next:rows[0]};});
const groups=[{id:'review-due',label:'Review due',status:'Review due'},{id:'watch-soon',label:'Watch soon',status:'Watch soon'},{id:'current-high-priority',label:'Within window / high priority',status:'Current',priority:'High'},{id:'current-maintenance',label:'Within window / other priorities',status:'Current',priority:'other'}];
---
<BaseLayout title="Source Monitor | FTFN" description="A bounded, searchable source-review queue with explicit metadata and source-currency limits.">
  <section class="page-section"><h1 class="page-title">A review queue for the evidence layer.</h1>
    <p class="lede" data-source-review-as-of={asOfDate}>Browse all {shelves.sources.length} sources without loading the whole inventory. The queue is calculated from recorded metadata as of {asOfDate}; generating this page does not check a source or refresh its date.</p>
    <p>Reconcile later exact-artifact receipts and independent appointments before choosing a live check. A raw profile-age warning is not an instruction to repeat a completed review.</p>
    <p>“Current” means within the displayed review window, not factually verified. A missing declared cadence uses the documented fallback window and stays labeled. “Probe ready” means endpoint metadata exists, not that a probe ran.</p>
    <dl class="summary-grid"><div><dt>Review due</dt><dd>{count('Review due')}</dd></div><div><dt>Watch soon</dt><dd>{count('Watch soon')}</dd></div><div><dt>Within review window</dt><dd>{count('Current')}</dd></div><div><dt>Endpoint metadata: probe ready</dt><dd>{sourceRows.filter(r=>r.health.status==='Probe ready').length}</dd></div><div><dt>Endpoint metadata: manual review</dt><dd>{sourceRows.filter(r=>r.health.status==='Manual review').length}</dd></div><div><dt>Missing declared cadence or owner</dt><dd>{sourceRows.filter(r=>!r.declared||!r.source.source_owner).length}</dd></div></dl>
    <p><a href="#review-queue">Search the queue</a> · <a href="/atlas/source-coverage/">Source coverage</a> · <a href="/method/">Evidence method</a></p>
  </section>
  <section class="page-section"><h2>Review groups</h2>
    {groups.map(group=><div id={group.id}><h3>{group.label}</h3><p>{sourceRows.filter(r=>r.freshness.status===group.status&&(!group.priority||(group.priority==='other'?r.source.capture_priority!=='High':r.source.capture_priority===group.priority))).length} source records. Use the review-cadence and priority filters below; no group is a publication recommendation.</p></div>)}
  </section>
  <section class="page-section"><h2>Watch-lane review map</h2><p>Each lane links to its first queued source. This is a metadata-driven next action, not newly acquired evidence.</p>
    <div class="table-wrap"><table><thead><tr><th scope="col">Watch lane</th><th scope="col">Sources</th><th scope="col">Review due</th><th scope="col">First queued source</th></tr></thead><tbody>{laneRows.map(r=><tr><th scope="row">{r.lane}</th><td>{r.count}</td><td>{r.due}</td><td><a href={`/atlas/sources/${r.next.source.id}/`}>{r.next.source.name}</a><p>{r.next.nextAction}</p></td></tr>)}</tbody></table></div>
  </section>
  <section class="page-section" id="review-queue"><h2>Search every source record</h2><PagedShelf records={shelves.sources} kind="sources" headingLevel={3}/></section>
</BaseLayout>
<style>.summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;}dt{font-weight:600;}dd{margin:0;}td,th{padding:.5rem;text-align:left;vertical-align:top;}table{width:100%;}</style>
