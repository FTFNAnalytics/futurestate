---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import MetaPill from '../../../components/ui/MetaPill.astro';
import PagedShelf from '../../../components/review/PagedShelf.astro';
import {getShelfData} from '../../../lib/shelf-catalog';
const {shelves,sourceRows,asOfDate}=await getShelfData();
const reviewDue=sourceRows.filter(r=>r.freshness.status==='Review due').length;
const watchSoon=sourceRows.filter(r=>r.freshness.status==='Watch soon').length;
const probeReady=sourceRows.filter(r=>r.health.status==='Probe ready').length;
---
<BaseLayout title="Sources | FTFN">
  <section class="page-section">
    <div class="eyebrow">Atlas / Sources</div>
    <h1 class="page-title">The evidence layer behind FTFN records.</h1>
    <p class="lede">Find source profiles, their scope and limitations, recorded review dates and the next check needed. A source listing is not evidence that every claim using it has been independently verified.</p>
    <div class="meta-row"><MetaPill label={`${sourceRows.length} source records`}/><MetaPill label={`${reviewDue} review due`}/><MetaPill label={`${watchSoon} watch soon`}/><MetaPill label={`${probeReady} probe ready`}/><MetaPill label={`Metadata as of ${asOfDate}`}/></div>
    <p data-source-review-as-of={asOfDate}>These are recorded metadata states; rendering this page does not run probes or refresh sources. Fallback review windows are labeled separately from declared cadence. Reconcile later scoped receipts and appointments before choosing a new check.</p>
    <p><a class="inline-link" href="/atlas/source-monitor/">Open source review monitor</a><a class="inline-link" href="/atlas/source-coverage/">Open coverage matrix</a></p>
  </section>
  <section class="page-section"><h2>Search every source profile</h2><PagedShelf records={shelves.sources} kind="sources" headingLevel={3}/></section>
</BaseLayout>
