---
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import atlas from "../../../data/phase-119-deep-project-place-atlas.json";
import localityDossiers from '../../../data/locality-dossiers.json';
import {nevadaPlaces,nevadaDossiers} from '../../../lib/nevada-named-dossiers.mjs';
import {europePlaces,europeDossiers} from '../../../lib/europe-named-dossiers.mjs';
import {southAsiaPlaces,southAsiaDossiers} from '../../../lib/south-asia-named-dossiers.mjs';
import {southernAfricaPlaces,southernAfricaDossiers} from '../../../lib/southern-africa-named-dossiers.mjs';

import {chilePlaces,chileDossiers} from '../../../lib/chile-named-dossiers.mjs';
import {brazilPlaces,brazilDossiers} from '../../../lib/brazil-named-dossiers.mjs';
import {northSeaPlaces,northSeaDossiers} from '../../../lib/north-sea-named-dossiers.mjs';
import {stockholmPlaces,stockholmDossiers} from '../../../lib/stockholm-named-dossiers.mjs';
import {aucklandPlaces,aucklandDossiers} from '../../../lib/auckland-named-dossiers.mjs';
import {tuasPlaces,tuasDossiers} from '../../../lib/tuas-named-dossiers.mjs';
import {portCitiesPlaces,portCitiesDossiers} from '../../../lib/port-cities-named-dossiers.mjs';
import {urbanServicesPlaces,urbanServicesDossiers} from '../../../lib/urban-services-named-dossiers.mjs';
import {nordicCitiesPlaces,nordicCitiesDossiers} from '../../../lib/nordic-cities-named-dossiers.mjs';
import {swissRailCityPlaces,swissRailCityDossiers} from '../../../lib/swiss-rail-city-named-dossiers.mjs';
import {kenyaCorridorPlaces,kenyaCorridorDossiers} from '../../../lib/kenya-corridor-named-dossiers.mjs';
import {gautengMetroPlaces,gautengMetroDossiers} from '../../../lib/gauteng-metro-named-dossiers.mjs';
import {malaysiaMetroPlaces,malaysiaMetroDossiers} from '../../../lib/malaysia-metro-named-dossiers.mjs';
import {colombiaRailPlaces,colombiaRailDossiers} from '../../../lib/colombia-rail-named-dossiers.mjs';
import {moroccoCorridorPlaces,moroccoCorridorDossiers} from '../../../lib/morocco-corridor-named-dossiers.mjs';
import {portugalWaterCitiesPlaces,portugalWaterCitiesDossiers} from '../../../lib/portugal-water-cities-named-dossiers.mjs';
import {italyRailLagoonPlaces,italyRailLagoonDossiers} from '../../../lib/italy-rail-lagoon-named-dossiers.mjs';
import {austriaHousingCitiesPlaces,austriaHousingCitiesDossiers} from '../../../lib/austria-housing-cities-named-dossiers.mjs';
import {ruhrWaterCityPlaces,ruhrWaterCityDossiers} from '../../../lib/ruhr-water-city-named-dossiers.mjs';
import {koreaEnergyCitiesPlaces,koreaEnergyCitiesDossiers} from '../../../lib/korea-energy-cities-named-dossiers.mjs';
import {istanbulCrossingsPlaces,istanbulCrossingsDossiers} from '../../../lib/istanbul-crossings-named-dossiers.mjs';
import {finlandMetroCitiesPlaces,finlandMetroCitiesDossiers} from '../../../lib/finland-metro-cities-named-dossiers.mjs';
import {andesMetroCityPlaces,andesMetroCityDossiers} from '../../../lib/andes-metro-city-named-dossiers.mjs';
import {czechMetroCitiesPlaces,czechMetroCitiesDossiers} from '../../../lib/czech-metro-cities-named-dossiers.mjs';
import {indonesiaRailCityPlaces,indonesiaRailCityDossiers} from '../../../lib/indonesia-rail-city-named-dossiers.mjs';
import {senegalMobilityEnergyPlaces,senegalMobilityEnergyDossiers} from '../../../lib/senegal-mobility-energy-named-dossiers.mjs';
import {kigaliCityPlaces,kigaliCityDossiers} from '../../../lib/kigali-city-named-dossiers.mjs';

const places = atlas.places;
const governed = places.filter((record) => record.coverage.tier_id === "Tier A");
const curated = places.filter((record) => record.coverage.tier_id === "Tier B");
---

<BaseLayout title="Place Atlas | FTFN" description="Read ten AI-reviewed locality accounts alongside fifteen original place systems, with explicit geographic scope, dated evidence and separate project outcomes.">
  <section class="page-section">
    <div class="eyebrow">Atlas / Places</div>
    <h1 class="page-title">Where evidence meets a receiving system.</h1>
    <p class="lede">
      The Place Atlas connects every local portrait to stable identity, explicit evidence rails,
      linked projects, unresolved needs, and stewardship. A place can contain projects at
      different stages, so no project stage is transferred to the wider system.
    </p>
    <div class="meta-row">
      <MetaPill label={`${places.length} place systems`} tone="published" />
      <MetaPill label={`${governed.length} canonical local profiles`} tone="review" />
      <MetaPill label={`${curated.length} curated portraits`} />
    </div>
  </section>

  <section class="page-section">
    <h2>Ten complete locality readings</h2>
    <p>Authored and AI-reviewed {localityDossiers.authored_date}. Each account uses one already eligible place identity and keeps its original record below the current article. These ten readings and the fifteen original systems below do not imply completion of the 70-place target or blanket acceptance of older claims.</p>
    <p><a href="/method/portfolio-decisions/">Geographic scopes and counting decisions</a> · <a href="/reference/explore/1/?kind=Place">Search place accounts</a></p>
    <div class="grid">{localityDossiers.records.map(record=><article class="record-card" data-locality-index={record.record_id}><div class="eyebrow">{record.record_id}</div><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p><p class="card-note">{record.scope}</p></article>)}</div>
  </section>

  <section class="page-section">
    <h2>Humboldt County and the Nevada receiving system</h2>
    <p>Added {nevadaDossiers.inspected_date}: a county-level account with separate housing, access and planning evidence. It is not a second name for the wider Nevada materials corridor.</p>
    <div class="grid">{nevadaPlaces.map(record=><article class="record-card" data-nevada-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div>
  </section>
  <section class="page-section"><h2>Somerset housing and local obligations</h2><p>Reviewed {europeDossiers.inspected_date}. One exact local-authority area, with housing demand and project outcomes kept separate.</p><div class="grid">{europePlaces.map(record=><article class="record-card" data-europe-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Greater Mumbai streets and service dependencies</h2><p>Reviewed {southAsiaDossiers.inspected_date}. The municipal boundary remains distinct from the wider metropolitan network.</p><div class="grid">{southAsiaPlaces.map(record=><article class="record-card" data-south-asia-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Southern African households and water services</h2><p>Reviewed {southernAfricaDossiers.inspected_date}. A Lesotho district and a South African metropolitan municipality have distinct boundaries and service questions.</p><div class="grid">{southernAfricaPlaces.map(record=><article class="record-card" data-southern-africa-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Copiapó water, households and municipal obligations</h2><p>Reviewed {chileDossiers.inspected_date}. One municipality, with census populations, social-registry indicators and water-rights procedures kept separate.</p><div class="grid">{chilePlaces.map(record=><article class="record-card" data-chile-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>São João da Barra services and coastal decisions</h2><p>Reviewed {brazilDossiers.inspected_date}. One municipality across six districts, with education, sanitation studies and coastal protection kept distinct from industrial scale.</p><div class="grid">{brazilPlaces.map(record=><article class="record-card" data-brazil-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>North Sea municipalities and connected services</h2><p>Reviewed {northSeaDossiers.inspected_date}. Øygarden and Rotterdam each count as one municipality. Mainland access, household services, neighbourhood drainage and industrial water retain their own evidence.</p><div class="grid">{northSeaPlaces.map(record=><article class="record-card" data-north-sea-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Stockholm district services and water delivery</h2><p>Reviewed {stockholmDossiers.inspected_date}. One municipality, with district responsibilities, environmental goals, annual water observations and resident-feedback methods kept within their own boundaries.</p><div class="grid">{stockholmPlaces.map(record=><article class="record-card" data-stockholm-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Auckland regional services and local priorities</h2><p>Reviewed {aucklandDossiers.inspected_date}. One unitary-authority area, with local plans, wastewater and stormwater roles, named flood works and everyday community facilities kept within their own service geographies.</p><div class="grid">{aucklandPlaces.map(record=><article class="record-card" data-auckland-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Singapore’s West Region</h2><p>Reviewed {tuasDossiers.inspected_date}. One named URA planning region, linking homes, transport, industry and public space without transferring national statistics or district targets to the whole region.</p><div class="grid">{tuasPlaces.map(record=><article class="record-card" data-tuas-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Busan and Hamburg municipal systems</h2><p>Reviewed {portCitiesDossiers.inspected_date}. Two distinct places connect mobility, public space, freight and adaptation without treating project footprints or wider metropolitan regions as municipal outcomes.</p><div class="grid">{portCitiesPlaces.map(record=><article class="record-card" data-port-cities-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Madrid and Mexico City public services</h2><p>Reviewed {urbanServicesDossiers.inspected_date}. Two administrative places connect housing, mobility, water and public space. Mexico City retrieval limits remain explicit; historical context is not a live service assessment.</p><div class="grid">{urbanServicesPlaces.map(record=><article class="record-card" data-urban-services-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Copenhagen and Helsinki everyday systems</h2><p>Reviewed {nordicCitiesDossiers.inspected_date}. Two municipal profiles connect transport, heating, water and civic services without relabelling regional totals as city outcomes.</p><div class="grid">{nordicCitiesPlaces.map(record=><article class="record-card" data-nordic-cities-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Zürich municipal services</h2><p>Reviewed {swissRailCityDossiers.inspected_date}. One municipal account separates regional service areas, transport proposals and delivered infrastructure.</p><div class="grid">{swissRailCityPlaces.map(record=><article class="record-card" data-swiss-rail-city-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Nairobi and Mombasa county services</h2><p>Reviewed {kenyaCorridorDossiers.inspected_date}. Two county accounts connect local mobility, neighbourhood facilities and water-service dependencies.</p><div class="grid">{kenyaCorridorPlaces.map(record=><article class="record-card" data-kenya-corridor-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Johannesburg and Tshwane municipal services</h2><p>Reviewed {gautengMetroDossiers.inspected_date}. Two municipal accounts connect buses, utilities, housing and the stages of service recovery.</p><div class="grid">{gautengMetroPlaces.map(record=><article class="record-card" data-gauteng-metro-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Kuala Lumpur and Putrajaya city services</h2><p>Reviewed {malaysiaMetroDossiers.inspected_date}. Two distinct municipal accounts connect planning, local mobility, water infrastructure and service responsibilities.</p><div class="grid">{malaysiaMetroPlaces.map(record=><article class="record-card" data-malaysia-metro-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Bogotá’s everyday service connections</h2><p>Reviewed {colombiaRailDossiers.inspected_date}. One capital-district account connects transport construction, care, housing stages and regional water dependencies.</p><div class="grid">{colombiaRailPlaces.map(record=><article class="record-card" data-colombia-rail-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Tangier and Casablanca’s local systems</h2><p>Reviewed {moroccoCorridorDossiers.inspected_date}. Two distinct communes connect transport access with public space, service contracts and environmental planning.</p><div class="grid">{moroccoCorridorPlaces.map(record=><article class="record-card" data-morocco-corridor-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Lisbon and Porto’s municipal services</h2><p>Reviewed {portugalWaterCitiesDossiers.inspected_date}. Two distinct cities connect drainage and local maintenance with climate adaptation and household support.</p><div class="grid">{portugalWaterCitiesPlaces.map(record=><article class="record-card" data-portugal-water-cities-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Venice’s island and mainland services</h2><p>Reviewed {italyRailLagoonDossiers.inspected_date}. One municipality retains distinct adaptation, waste, fire-water and transport service areas.</p><div class="grid">{italyRailLagoonPlaces.map(record=><article class="record-card" data-italy-rail-lagoon-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Vienna and Graz municipal services</h2><p>Reviewed {austriaHousingCitiesDossiers.inspected_date}. Two municipalities connect housing access and renewal with water and energy systems, keeping regional and municipal-group scopes distinct.</p><div class="grid">{austriaHousingCitiesPlaces.map(record=><article class="record-card" data-austria-housing-cities-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Dortmund housing and municipal services</h2><p>Reviewed {ruhrWaterCityDossiers.inspected_date}. One municipality connects housing pressure, heat planning, flood mapping and park services without turning models or equipment counts into measured outcomes.</p><div class="grid">{ruhrWaterCityPlaces.map(record=><article class="record-card" data-ruhr-water-city-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Seoul and Incheon services</h2><p>Reviewed {koreaEnergyCitiesDossiers.inspected_date}. Two metropolitan municipalities connect water, housing, energy, transport and island care while preserving service categories and delivery stages.</p><div class="grid">{koreaEnergyCitiesPlaces.map(record=><article class="record-card" data-korea-energy-cities-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Istanbul municipal services</h2><p>Reviewed {istanbulCrossingsDossiers.inspected_date}. One metropolitan municipality connects water, housing, childcare, accessibility and building-risk screening while preserving provider responsibilities and evidence limits.</p><div class="grid">{istanbulCrossingsPlaces.map(record=><article class="record-card" data-istanbul-crossings-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Espoo and Tampere municipal systems</h2><p>Reviewed {finlandMetroCitiesDossiers.inspected_date}. Two municipalities connect climate, water, housing and childcare while keeping regional utilities, future budgets and actual service conditions distinct.</p><div class="grid">{finlandMetroCitiesPlaces.map(record=><article class="record-card" data-finland-metro-cities-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Quito metropolitan services</h2><p>Reviewed {andesMetroCityDossiers.inspected_date}. Water maintenance, educational transitions, property regularization and rural works retain their own delivery stages and service boundaries.</p><div class="grid">{andesMetroCityPlaces.map(record=><article class="record-card" data-andes-metro-city-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Prague and Brno municipal services</h2><p>Reviewed {czechMetroCitiesDossiers.inspected_date}. Two municipal accounts connect water, housing, childcare, heat and transport maintenance without turning plans or service rules into universal delivered outcomes.</p><div class="grid">{czechMetroCitiesPlaces.map(record=><article class="record-card" data-czech-metro-cities-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Bandung water and neighbourhood services</h2><p>Reviewed {indonesiaRailCityDossiers.inspected_date}. The municipality's water and waste account separates policy, supply areas, loss-reduction targets, maintenance effects and proposed composting from delivered household outcomes.</p><div class="grid">{indonesiaRailCityPlaces.map(record=><article class="record-card" data-indonesia-rail-city-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Dakar regional services</h2><p>Reviewed {senegalMobilityEnergyDossiers.inspected_date}. One administrative-region account connects transport, sanitation, water preparation and drainage, retaining the boundaries of neighbourhood projects and multi-region programs.</p><div class="grid">{senegalMobilityEnergyPlaces.map(record=><article class="record-card" data-senegal-mobility-energy-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section"><h2>Kigali city services and dependencies</h2><p>Reviewed {kigaliCityDossiers.inspected_date}. One city account connects external water supply, mobility investment, waste measurement and wetland restoration while preserving their different delivery stages.</p><div class="grid">{kigaliCityPlaces.map(record=><article class="record-card" data-kigali-city-index={record.record_id}><h3><a href={record.route}>{record.title}</a></h3><p>{record.answer}</p></article>)}</div></section>
  <section class="page-section review-columns">
    {atlas.coverage_tiers.map((tier) => (
      <article><div class="eyebrow">{tier.tier_id}</div><h2>{tier.tier_id === "Tier A" ? "Governed local profiles" : "Curated place portraits"}</h2><p>{tier.place_definition}</p></article>
    ))}
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Tier A</div><h2>Canonical local-system profiles.</h2></div></div>
    <div class="grid">{governed.map((place) => <article class="record-card"><div class="meta-row"><MetaPill label={place.canonical_id} /><MetaPill label={place.coverage.label} tone="review" /></div><h3><a href={place.routes.atlas}>{place.title}</a></h3><p>{place.geography}</p><p class="card-note">{place.relationships.related_project_ids.length} linked project file{place.relationships.related_project_ids.length === 1 ? "" : "s"}</p></article>)}</div>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Tier B</div><h2>Curated portraits awaiting governed promotion.</h2></div></div>
    <div class="grid">{curated.map((place) => <article class="record-card"><div class="meta-row"><MetaPill label={place.canonical_id} /><MetaPill label={place.coverage.label} /></div><h3><a href={place.routes.atlas}>{place.title}</a></h3><p>{place.geography}</p><p class="card-note">{place.update_status}</p></article>)}</div>
  </section>

  <section class="page-section prose-page"><h2>Publication boundary</h2><p>{atlas.interpretation_boundary}</p><p><a class="inline-link" href={atlas.routes.public_export}>Download the canonical Atlas registry</a></p></section>
</BaseLayout>
