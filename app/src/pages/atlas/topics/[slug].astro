---
import {getCollection} from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import ReaderPathwaySummary from '../../../components/atlas/ReaderPathwaySummary.astro';
import PagedShelf from '../../../components/review/PagedShelf.astro';
import {getShelfCatalog} from '../../../lib/shelf-catalog';
import editorial from '../../../data/phase-205-216-current-editorial.json';
export async function getStaticPaths(){return (await getCollection('topics')).map(topic=>({params:{slug:topic.data.slug},props:{topic}}));}
const {topic}=Astro.props;
const kind=`topic-${topic.data.slug}`;
const records=(await getShelfCatalog())[kind];
const pathways=(await getCollection('readerPathways')).filter(p=>p.data.topic_ids.includes(topic.data.id));
const latestSignals=records.filter(r=>r.filters.kind.includes('Signal')&&r.filters.status.includes('Published')).slice(0,3);
const latestDocuments=records.filter(r=>r.filters.kind.includes('Research document')).slice(0,3);
const guide=editorial.records.find(r=>r.kind==='Topic'&&'topic' in r&&r.topic===topic.data.name);
---
<BaseLayout title={`${topic.data.name} | FTFN`} description={topic.data.summary}>
  <section class="page-section" data-topic-overview={topic.data.id}>
    <h1 class="page-title">{topic.data.name}</h1><p class="lede">{topic.data.summary}</p>
    <p><strong>Constraints:</strong> {topic.data.primary_constraints.join(' · ')}</p>
    <p><a href="#topic-records">Browse all {records.length} connected records</a> · <a href="/reference/explore/1/">Reader guides and questions</a></p>
    {guide&&<aside><h2>Read the expanded topic draft</h2><p><a href={guide.route}>{guide.title}</a></p><p>Authored {guide.authored_date}; independent review pending. This is an editorial draft, not an approved topic edition.</p></aside>}
  </section>
  <section class="page-section two-column-section">
    <div><h2>Recent Published signal records</h2><p>These retain historical publication labels and exclude the current classification holds. “Published” does not mean a source was rechecked today.</p>
      {latestSignals.length?<div class="source-list">{latestSignals.map(r=><article class="source-row" data-overview-card={r.id}><h3><a href={r.route}>{r.title}</a></h3><p>{r.summary}</p><p>{r.date} · {r.filters.type?.join(', ')} · {r.filters.evidence?.join(', ')}</p></article>)}</div>:<p>No feed-eligible Published signal is linked to this topic.</p>}
    </div>
    <div><h2>Recent research records</h2><p>Documents remain separate from interpreted signals. Some historical research records describe FTFN methods and await attribution review.</p>
      {latestDocuments.length?<div class="source-list">{latestDocuments.map(r=><article class="source-row" data-overview-card={r.id}><h3><a href={r.route}>{r.title}</a></h3><p>{r.summary}</p><p>{r.date} · {r.filters.documentType?.join(', ')} · {r.filters.capture?.join(', ')}</p></article>)}</div>:<p>No research document is linked to this topic.</p>}
    </div>
  </section>
  {pathways.map(pathway=><ReaderPathwaySummary pathway={pathway}/>)}
  <section class="page-section"><h2>Questions to watch</h2><ul>{topic.data.watch_questions.map(q=><li>{q}</li>)}</ul></section>
  <section class="page-section" id="topic-records">
    <h2>Explore the complete topic shelf</h2>
    <p>Filter by content kind to find signals, research documents, featured sources, organizations, technologies, receiving systems and dependency maps. Topic overlap and source links establish relationships, not demonstrated local outcomes. <a href="/method/editorial-review/">Excluded classification records remain separately accessible.</a></p>
    <PagedShelf records={records} kind={kind} limit={20} headingLevel={3}/>
  </section>
</BaseLayout>
