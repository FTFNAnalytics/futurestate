---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import atlas from "../../../data/phase-119-deep-project-place-atlas.json";
import eventRegistry from "../../../data/phase-62-conversion-event-ledgers.json";
import biographies from "../../../data/phase-127-project-place-conversion-biographies.json";
import readiness from "../../../data/phase-135-atlas-conversion-readiness-audit.json";
import chronicles from "../../../data/phase-136-named-project-chronicles.json";
import eligibility from "../../../data/phase-138-longitudinal-evidence-eligibility.json";

export function getStaticPaths() {
  return atlas.projects.map((record) => ({ params: { slug: record.slug }, props: { projectId: record.atlas_project_id } }));
}

const project = atlas.projects.find((record) => record.atlas_project_id === Astro.props.projectId)!;
const biography = biographies.project_biographies.find((record) => record.atlas_project_id === project.atlas_project_id)!;
const owner = atlas.update_owners.find((record) => record.owner_id === project.update_owner_id)!;
const relatedPlaces = project.relationships.related_place_ids.map((id) => atlas.places.find((record) => record.atlas_place_id === id)).filter(Boolean);
const signals = await getCollection("signals");
const signalById = new Map(signals.map((record) => [record.data.id, record]));
const selectedSignals = project.evidence_rails.signal_ids.map((id) => signalById.get(id)).filter(Boolean);
const sources = await getCollection("sources");
const sourceById = new Map(sources.map((record) => [record.data.id, record]));
const selectedSources = project.evidence_rails.source_ids.map((id) => sourceById.get(id)).filter(Boolean);
const events = project.chronology.event_ids.map((id) => eventRegistry.events.find((record) => record.event_id === id)).filter(Boolean);
const chronicle = chronicles.project_chronicles.find((record) => record.atlas_project_id === project.atlas_project_id)!;
const readinessRecord = readiness.readiness_records.find((record) => record.entity_id === project.atlas_project_id)!;
const eligibilityRecord = eligibility.eligibility_records.find((record) => record.entity_id === project.atlas_project_id)!;
---

<BaseLayout title={`${project.title} | FTFN Project Atlas`} description={project.editorial_question}>
  <section class="page-section">
    <div class="eyebrow">Atlas / Projects / {project.canonical_id}</div>
    <h1 class="page-title">{project.title}</h1>
    <p class="lede">{project.editorial_question}</p>
    <div class="meta-row">
      <MetaPill label={project.coverage.label} tone={project.coverage.tier_id === "Tier A" ? "review" : "default"} />
      <MetaPill label={`Record ${project.atlas_project_id}`} />
      <MetaPill label={`Phase 127 · ${biography.biography_id}`} tone="possibility" />
      <MetaPill label={project.entity_kind} />
      <MetaPill label={`Reviewed ${project.last_reviewed_date}`} />
    </div>
  </section>

  <section class="page-section briefing-band">
    <div class="briefing-band__copy">
      <div class="eyebrow">Current conversion stage</div>
      <h2>{project.conversion.current_stage}</h2>
      <p>{project.conversion.stage_basis}</p>
    </div>
    <article class="record-card record-card--featured">
      <div class="eyebrow">Coverage basis</div>
      <h3>{project.coverage.tier_id}: {project.coverage.label}</h3>
      <p>{project.coverage.basis}</p>
      <div class="meta-row"><MetaPill label={project.update_status} tone="review" /></div>
    </article>
  </section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">v0.8 named project chronicle · {chronicle.chronicle_id}</div><h2>The complete conversion account is now a maintained public file.</h2><p>{chronicle.unresolved_bridge}</p></div><MetaPill label={chronicle.coverage_tier} tone="review" /></div><div class="button-row"><a class="inline-link" href={chronicle.route}>Open the v0.8 chronicle</a><a class="inline-link" href="/review/v08/projects/">Browse all project chronicles</a></div></section>

  <section class="page-section review-columns">
    <article><div class="eyebrow">Phase 135 · {readinessRecord.readiness_id}</div><h2>{readinessRecord.content_readiness}</h2><p>{readinessRecord.readiness_basis}</p><p class="card-note">{readinessRecord.blocking_boundary}</p><a class="inline-link" href="/review/v08/readiness/">Inspect Atlas readiness audits</a></article>
    <article><div class="eyebrow">Phase 138 · {eligibilityRecord.eligibility_id}</div><h2>{eligibilityRecord.candidate_state}</h2><p>{eligibilityRecord.next_record}</p><p class="card-note">Series admitted: no · observation values: 0</p><a class="inline-link" href="/review/v08/longitudinal/">Inspect longitudinal eligibility</a></article>
  </section>

  <section class="page-section review-columns">
    <article>
      <div class="eyebrow">Unresolved gate</div>
      <h2>Where the claim stops.</h2>
      <p>{project.conversion.unresolved}</p>
      <p class="card-note">{project.conversion.unresolved_gate}</p>
    </article>
    <article>
      <div class="eyebrow">Exact next artifact</div>
      <h2>What can move this file.</h2>
      <p>{project.conversion.exact_next_artifact}</p>
      {project.conversion.next_check_date && <MetaPill label={`Next check ${project.conversion.next_check_date}`} tone="urgency" />}
      {project.conversion.reopening_trigger && <p class="card-note">Trigger: {project.conversion.reopening_trigger}</p>}
    </article>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Phase 127 · Conversion biography · {biography.biography_id}</div>
        <h2>A deeper account of the same bounded project file.</h2>
        <p>{biography.interpretation_boundary}</p>
      </div>
      <MetaPill label={`${biography.narrative_metrics.authored_word_count.toLocaleString()} authored words`} tone="possibility" />
    </div>
    <div class="source-list">
      {biography.narrative_sections.map((section) => (
        <article class="source-row">
          <div class="eyebrow">{section.section_id}</div>
          <h3>{section.heading}</h3>
          <p>{section.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Eight-stage evidence passport</div>
        <h2>Repository coverage, not a progress score.</h2>
        <p>Every stage keeps the Phase 116 identity and question. Governed upstream republishes an existing Phase 61–64 cell; Published context remains context; Not established is bounded to this repository.</p>
      </div>
      <MetaPill label={`${biography.stage_cells.length} independent cells`} tone="review" />
    </div>
    <div class="grid">
      {biography.stage_cells.map((cell) => (
        <article class="record-card">
          <div class="meta-row"><MetaPill label={cell.cell_id} /><MetaPill label={cell.state} tone={cell.state === "Governed upstream" ? "review" : cell.state === "Published context" ? "published" : "default"} /></div>
          <h3>{cell.sequence}. {cell.label}</h3>
          <p>{cell.basis}</p>
          <p class="card-note">{cell.question}</p>
          {cell.governed_lineage.phase_62_event_ids.length > 0 && <p class="card-note">Governed events: {cell.governed_lineage.phase_62_event_ids.join(", ")}</p>}
          {cell.published_context_signal_ids.length > 0 && <p class="card-note">Published context: {cell.published_context_signal_ids.join(", ")}</p>}
        </article>
      ))}
    </div>
    <p><a class="inline-link" href="/review/fieldbook/delivery-biographies/">Open all Phase 127 delivery biographies</a></p>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Chronology</div><h2>{project.chronology.chronology_type}</h2><p>{project.chronology.boundary}</p></div><MetaPill label={`${events.length || selectedSignals.length} records`} /></div>
    {events.length > 0 ? (
      <ol class="timeline-list">
        {events.map((event) => (
          <li>
            <div class="meta-row"><MetaPill label={event!.event_date} /><MetaPill label={event!.materiality} /></div>
            <h3>{event!.title}</h3>
            <p>{event!.evidence_artifact}</p>
            <p class="card-note">{event!.prior_stage} → {event!.current_stage}</p>
          </li>
        ))}
      </ol>
    ) : (
      <ol class="timeline-list">
        {selectedSignals.map((signal) => (
          <li>
            <div class="meta-row"><MetaPill label={signal!.data.captured_date.toISOString().slice(0, 10)} /><MetaPill label={signal!.data.maturity_level} /></div>
            <h3><a href={`/signals/${signal!.data.slug}/`}>{signal!.data.title}</a></h3>
            <p>{signal!.data.summary}</p>
          </li>
        ))}
      </ol>
    )}
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Evidence rails</div><h2>Signals and sources linked by stable ID.</h2></div><MetaPill label={`${selectedSignals.length} signals · ${selectedSources.length} sources`} tone="possibility" /></div>
    <div class="signal-grid">
      {selectedSignals.map((signal) => (
        <article class="record-card"><div class="meta-row"><MetaPill label={signal!.data.id} /><MetaPill label={signal!.data.record_status} tone="published" /></div><h3><a href={`/signals/${signal!.data.slug}/`}>{signal!.data.title}</a></h3><p>{signal!.data.summary}</p></article>
      ))}
    </div>
    <div class="source-list">
      {selectedSources.map((source) => (
        <article class="source-row"><h3><a href={`/atlas/sources/${source!.data.id}/`}>{source!.data.name}</a></h3><p>{source!.data.source_type} · checked {source!.data.last_checked_date.toISOString().slice(0, 10)}</p></article>
      ))}
    </div>
  </section>

  {relatedPlaces.length > 0 && (
    <section class="page-section">
      <div class="section-heading"><div><div class="eyebrow">Receiving systems</div><h2>Related places remain separate evidence scopes.</h2></div></div>
      <div class="grid">{relatedPlaces.map((place) => <article class="record-card"><h3><a href={place!.routes.atlas}>{place!.title}</a></h3><p>{place!.geography}</p><MetaPill label={place!.coverage.label} /></article>)}</div>
    </section>
  )}

  <section class="page-section review-columns">
    <article><div class="eyebrow">Relationship ledger</div><h2>Upstream records</h2><p>Phase 61 files: {project.relationships.phase_61_file_ids.length || "none"}<br />Phase 62 events: {project.relationships.phase_62_event_ids.length}<br />Phase 63 gates: {project.relationships.phase_63_gate_ids.length}<br />Phase 60 cycle links: {project.relationships.phase_60_cycle_ids.length}</p></article>
    <article><div class="eyebrow">Stewardship</div><h2>{owner.role}</h2><p>{project.update_status}</p><p><a class="inline-link" href={project.routes.prior_casebook}>Open the prior editorial casebook</a></p></article>
  </section>

  <section class="page-section prose-page"><h2>Interpretation boundary</h2><p>{project.interpretation_boundary}</p><p class="card-note">Stop rule: {project.conversion.stop_rule}</p><p><a class="inline-link" href="/atlas/projects/">Return to the Project Atlas</a></p></section>
</BaseLayout>
