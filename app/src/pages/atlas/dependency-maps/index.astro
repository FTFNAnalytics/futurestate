---
import {getCollection} from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import PagedShelf from '../../../components/review/PagedShelf.astro';
import {getShelfCatalog} from '../../../lib/shelf-catalog';
const maps=await getCollection('dependencyMaps');
const records=(await getShelfCatalog())['atlas-maps-all'];
const anchor=(s:string)=>s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const groups=(field:'map_type'|'primary_topic'|'record_status')=>[...new Set(maps.map(m=>m.data[field]))].sort().map(label=>({label,count:maps.filter(m=>m.data[field]===label).length}));
const types=groups('map_type'),topics=groups('primary_topic'),states=groups('record_status');
const gaps=new Set(maps.flatMap(m=>m.data.evidence_gap_ids));
const filterLink=(key:string,value:string)=>`/browse/atlas-maps-all/1/?shelf=atlas-maps-all&${key}=${encodeURIComponent(value)}`;
---
<BaseLayout title="Dependency Maps | FTFN" description="Qualitative relationships, evidence limits and exact cited records.">
  <section class="page-section">
    <div class="eyebrow">Atlas / Dependency Maps</div><h1 class="page-title">Follow the dependency question.</h1>
    <p class="lede">Maps connect records across technologies, sources, receiving systems and evidence gaps. They are qualitative interpretations, not scores, proof of delivery or evidence-gap resolution.</p>
    <p>{maps.length} maps · {types.length} map types · {topics.length} primary topics · {gaps.size} linked evidence gaps.</p>
    <p>Every map retains its question, explicit record IDs, nodes, links, confidence labels, interpretation limits and next evidence request on its own page.</p>
  </section>
  <section class="page-section"><h2>Search every map</h2><PagedShelf records={records} kind="atlas-maps-all" limit={20} headingLevel={3}/></section>
  <section class="page-section"><h2>Browse by type</h2><ul>{types.map(g=><li id={`type-${anchor(g.label)}`}><a href={filterLink('type',g.label)}>{g.label}: {g.count}</a></li>)}</ul></section>
  <section class="page-section"><h2>Browse by topic</h2><ul>{topics.map(g=><li id={`topic-${anchor(g.label)}`}><a href={filterLink('topic',g.label)}>{g.label}: {g.count}</a></li>)}</ul></section>
  <section class="page-section"><h2>Record states</h2><ul>{states.map(g=><li><a href={filterLink('status',g.label)}>{g.label}: {g.count}</a></li>)}</ul><p>Filtered search requires JavaScript; the numbered static pages above retain every map without JavaScript. A publication label is not current evidence acceptance.</p></section>
</BaseLayout>
