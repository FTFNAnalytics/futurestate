---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import {readerCatalog} from '../../../lib/reader-catalog.mjs';
export function getStaticPaths(){return Array.from({length:Math.ceil(readerCatalog.length/40)},(_,i)=>({params:{page:String(i+1)},props:{page:i+1}}));}
const {page}=Astro.props;
const pageCount=Math.ceil(readerCatalog.length/40);
const records=readerCatalog.slice((page-1)*40,page*40);
const kinds=[...new Set(readerCatalog.map(r=>r.kind))].sort();
---
<BaseLayout title="Explore the reference | FTFN" description="Browse dated essays, topic editions, project and place cases, and direct answers with visible evidence limits.">
  <section class="page-section"><div class="eyebrow">FTFN Reference</div><h1 class="page-title">Find an answer. Follow its evidence.</h1>
    <p class="lede">{readerCatalog.length} reader bindings, including reused report essays. These are local editorial drafts with visible review status, not {readerCatalog.length} independently approved articles.</p>
    <form id="reader-search" class="filter-panel" method="get"><label>Search all reader editions<input name="q" type="search" /></label><label>Content type<select name="kind"><option value="">All types</option>{kinds.map(kind=><option>{kind}</option>)}</select></label><button class="button" type="submit">Search</button></form>
    <noscript><p>Search requires JavaScript. All entries remain accessible using the numbered pages below.</p></noscript>
    <p id="reader-status" role="status">Page {page} of {pageCount}. {records.length} entries.</p>
    <div id="reader-results" class="grid">{records.map(r=><article class="record-card"><div class="eyebrow">{r.kind}</div><h2><a href={r.route} lang={'language' in r ? r.language : 'en'}>{r.title}</a></h2><p lang={'language' in r ? r.language : 'en'}>{r.summary}</p><p class="muted">{r.date} · {r.status}</p></article>)}</div>
    <button id="more-results" class="button" hidden>Show next 40 results</button>
    <nav aria-label="Reader catalog pages" class="button-row">{Array.from({length:pageCount},(_,i)=><a href={`/reference/explore/${i+1}/`} aria-current={page===i+1?'page':undefined}>Page {i+1}</a>)}</nav>
  </section>
</BaseLayout>
<script>
  import {searchReaders} from '../../../lib/reader-search.mjs';
  const form=document.querySelector<HTMLFormElement>('#reader-search')!;
  const results=document.querySelector<HTMLElement>('#reader-results')!;
  const status=document.querySelector<HTMLElement>('#reader-status')!;
  const more=document.querySelector<HTMLButtonElement>('#more-results')!;
  let matches:any[]=[];let shown=0;let catalog:any[]|null=null;
  function append(){const slice=matches.slice(shown,shown+40);for(const r of slice){const card=document.createElement('article');card.className='record-card';const h=document.createElement('h2');const a=document.createElement('a');a.href=r.route;a.textContent=r.title;a.lang=r.language??'en';h.append(a);const p=document.createElement('p');p.textContent=r.summary;p.lang=r.language??'en';const note=document.createElement('p');note.textContent=`${r.kind} · ${r.date} · ${r.status}`;card.append(h,p,note);results.append(card);}shown+=slice.length;more.hidden=shown>=matches.length;status.textContent=matches.length?`${shown} of ${matches.length} matches shown.`:'No matching reader editions. Try fewer words or a different content type.';}
  async function search(push=false){const params=new URLSearchParams(new FormData(form) as any);if(push)history.pushState(null,'',`${location.pathname}?${params}`);status.textContent='Searching…';try{if(!catalog){const response=await fetch('/data/reader-catalog.json');if(!response.ok)throw new Error();catalog=(await response.json()).records;}matches=searchReaders(catalog,params.get('q')??'',params.get('kind')??'');shown=0;results.replaceChildren();append();}catch{status.textContent='Search could not load. Use the numbered pages to browse; your query is preserved.';}}
  function restore(){const params=new URLSearchParams(location.search);(form.elements.namedItem('q') as HTMLInputElement).value=params.get('q')??'';(form.elements.namedItem('kind') as HTMLSelectElement).value=params.get('kind')??'';if(location.search)void search();}
  form.addEventListener('submit',event=>{event.preventDefault();void search(true);});more.addEventListener('click',()=>append());window.addEventListener('popstate',()=>{if(location.search)restore();else location.reload();});restore();
</script>
