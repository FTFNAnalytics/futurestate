---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import MetaPill from "../../components/ui/MetaPill.astro";

const collections = (await getCollection("researchCollections"))
  .filter((collection) => collection.data.record_status === "Published")
  .sort((a, b) =>
    b.data.captured_date.valueOf() - a.data.captured_date.valueOf()
    || b.data.title.localeCompare(a.data.title)
  );
const documents = (await getCollection("researchDocuments")).sort((a, b) => {
  const dateA = a.data.publication_date?.valueOf() ?? a.data.captured_date.valueOf();
  const dateB = b.data.publication_date?.valueOf() ?? b.data.captured_date.valueOf();
  return dateB - dateA || a.data.title.localeCompare(b.data.title);
});
const sources = await getCollection("sources");
const sourceById = new Map(sources.map((source) => [source.data.id, source]));
const collectionById = new Map(collections.map((collection) => [collection.data.id, collection]));
const sourceCount = new Set(documents.map((document) => document.data.source_id)).size;
const topicCount = new Set(documents.flatMap((document) => document.data.primary_topics)).size;
const documentTopics = [...new Set(documents.flatMap((document) => document.data.primary_topics))].sort();
const documentTypes = [...new Set(documents.map((document) => document.data.document_type))].sort();
const captureStatuses = [...new Set(documents.map((document) => document.data.capture_status))].sort();
const publishers = [...new Set(documents.map((document) => document.data.publisher))].sort();
---

<BaseLayout
  title="Research Collections | FTFN"
  description="Reviewed collections of primary documents that expose the research priorities, policy direction, and enabling systems behind future-state signals."
>
  <section class="page-section hero">
    <div class="hero__copy">
      <div class="eyebrow">ftfn.io / Research</div>
      <h1 class="page-title">Primary documents, organized around the stack.</h1>
      <p class="lede">
        Research Collections bring related source documents together, summarize
        each one, map their recurring dependencies, and preserve the evidence
        limits between stated direction and real implementation.
      </p>
      <div class="button-row">
        {collections[0] && (
          <a class="button" href={`/research/${collections[0].data.slug}/`}>Open latest collection</a>
        )}
        <a class="button button--secondary" href="/method/">Read the method</a>
      </div>
    </div>

    <div class="metric-strip" aria-label="Research collection counts">
      <div class="metric">
        <strong>{collections.length}</strong>
        <span>collections</span>
      </div>
      <div class="metric">
        <strong>{documents.length}</strong>
        <span>documents</span>
      </div>
      <div class="metric">
        <strong>{sourceCount}</strong>
        <span>source profiles</span>
      </div>
      <div class="metric">
        <strong>{topicCount}</strong>
        <span>connected topics</span>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Collections</div>
        <h2>Reviewed document sets.</h2>
      </div>
    </div>
    <div class="grid">
      {collections.map((collection) => {
        const collectionDocuments = documents.filter((document) =>
          collection.data.document_ids.includes(document.data.id)
        );

        return (
          <article class="record-card record-card--featured">
            <div class="meta-row">
              <MetaPill label={`${collectionDocuments.length} documents`} tone="possibility" />
              <MetaPill label={collection.data.record_status} />
            </div>
            <h3><a href={`/research/${collection.data.slug}/`}>{collection.data.title}</a></h3>
            <p>{collection.data.summary}</p>
            <div class="button-row">
              <a class="inline-link" href={`/research/${collection.data.slug}/`}>Read collection</a>
              <a class="inline-link" href={collection.data.download_path} download>Download bundle</a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="page-section" id="document-shelf">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Document Shelf</div>
        <h2>Search across all reviewed primary records.</h2>
        <p>
          Collections preserve a research question. The document shelf separates
          individual records so readers can filter by topic, document type,
          publisher, collection, and capture status.
        </p>
      </div>
      <a class="inline-link" href="/data/">Open data exports</a>
    </div>

    <form class="filter-panel" data-research-filter>
      <label class="filter-panel__search">
        Search
        <input type="search" data-filter="search" placeholder="Title, summary, publisher..." />
      </label>
      <label>
        Topic
        <select data-filter="topic">
          <option value="">All topics</option>
          {documentTopics.map((topic) => <option value={topic}>{topic}</option>)}
        </select>
      </label>
      <label>
        Document type
        <select data-filter="documentType">
          <option value="">All document types</option>
          {documentTypes.map((documentType) => <option value={documentType}>{documentType}</option>)}
        </select>
      </label>
      <label>
        Collection
        <select data-filter="collection">
          <option value="">All collections</option>
          {collections.map((collection) => <option value={collection.data.id}>{collection.data.title}</option>)}
        </select>
      </label>
      <label>
        Publisher
        <select data-filter="publisher">
          <option value="">All publishers</option>
          {publishers.map((publisher) => <option value={publisher}>{publisher}</option>)}
        </select>
      </label>
      <label>
        Capture
        <select data-filter="capture">
          <option value="">All capture types</option>
          {captureStatuses.map((captureStatus) => <option value={captureStatus}>{captureStatus}</option>)}
        </select>
      </label>
      <button class="button button--secondary filter-panel__reset" type="button" data-filter-reset>
        Clear filters
      </button>
    </form>

    <p class="muted" data-research-result-count>{documents.length} documents shown</p>
    <p class="muted" data-research-empty hidden>No research documents match the selected filters.</p>

    <div class="grid">
      {documents.map((document) => {
        const collection = collectionById.get(document.data.collection_id);
        const source = sourceById.get(document.data.source_id);

        return (
          <article
            class="record-card"
            data-research-card
            data-topic={document.data.primary_topics.join("||")}
            data-document-type={document.data.document_type}
            data-collection={document.data.collection_id}
            data-publisher={document.data.publisher}
            data-capture={document.data.capture_status}
            data-search={`${document.data.title} ${document.data.summary} ${document.data.publisher}`.toLowerCase()}
          >
            <div class="meta-row">
              <MetaPill label={document.data.document_type} />
              <MetaPill label={document.data.capture_status} tone={document.data.capture_status === "Official link record" ? "review" : "possibility"} />
            </div>
            <h3><a href={`/research/documents/${document.data.slug}/`}>{document.data.title}</a></h3>
            <p>{document.data.summary}</p>
            <p class="card-note">
              {document.data.publisher}
              {collection && ` · ${collection.data.title}`}
            </p>
            <div class="meta-row">
              {document.data.primary_topics.slice(0, 3).map((topic) => <MetaPill label={topic} />)}
            </div>
            <div class="button-row">
              <a class="inline-link" href={`/research/documents/${document.data.slug}/`}>Read summary</a>
              {source && <a class="inline-link" href={`/atlas/sources/${source.data.id}/`}>Source profile</a>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="page-section briefing-band">
    <div class="briefing-band__copy">
      <div class="eyebrow">Interpretation Boundary</div>
      <h2>Direction is not delivery.</h2>
      <p>
        Strategy documents, budget requests, and broad solicitations can show
        priorities and dependencies. They do not prove appropriations, awards,
        successful research, production capacity, permits, projects, or
        operating outcomes.
      </p>
    </div>
    <article class="record-card">
      <h3>The collection standard</h3>
      <ul class="compact-list">
        <li>Use official or primary government sources.</li>
        <li>Summarize findings without inflating maturity.</li>
        <li>State the implementation evidence still missing.</li>
        <li>Connect documents to source, topic, signal, briefing, and map records.</li>
      </ul>
    </article>
  </section>

  <script is:inline>
    const filterRoot = document.querySelector("[data-research-filter]");

    if (filterRoot) {
      const controls = Array.from(filterRoot.querySelectorAll("[data-filter]"));
      const cards = Array.from(document.querySelectorAll("[data-research-card]"));
      const resultCount = document.querySelector("[data-research-result-count]");
      const emptyState = document.querySelector("[data-research-empty]");
      const resetButton = filterRoot.querySelector("[data-filter-reset]");

      function updateResearchShelf() {
        const activeFilters = Object.fromEntries(
          controls.map((control) => [control.dataset.filter, control.value.trim()])
        );
        let visibleCount = 0;

        for (const card of cards) {
          const isVisible = Object.entries(activeFilters).every(([key, value]) => {
            if (!value) return true;
            if (key === "search") return card.dataset.search?.includes(value.toLowerCase());
            return card.dataset[key]?.split("||").includes(value);
          });

          card.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        }

        if (resultCount) {
          resultCount.textContent = `${visibleCount} document${visibleCount === 1 ? "" : "s"} shown`;
        }
        if (emptyState) emptyState.hidden = visibleCount !== 0;
      }

      controls.forEach((control) => {
        control.addEventListener(control.type === "search" ? "input" : "change", updateResearchShelf);
      });
      resetButton?.addEventListener("click", () => {
        controls.forEach((control) => {
          control.value = "";
        });
        updateResearchShelf();
      });
      updateResearchShelf();
    }
  </script>
</BaseLayout>
