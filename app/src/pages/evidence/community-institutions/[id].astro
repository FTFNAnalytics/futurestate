---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-83-community-institutions-social-infrastructure-collective-resilience-registry.json";
import phase82 from "../../../data/phase-82-household-capability-care-infrastructure-everyday-security-registry.json";

export function getStaticPaths() {
  return [
    ...registry.community_institution_access_trust_continuity_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "institution", record } })),
    ...registry.civic_association_cooperative_mutual_aid_capacity_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "civic", record } })),
    ...registry.local_information_media_public_knowledge_integrity_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "information", record } })),
    ...registry.collective_preparedness_trauma_recovery_resilience_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "resilience", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "institution" | "civic" | "information" | "resilience"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-community-institutions-doctrine-001", "briefing-libraries-schools-clinics-civic-infrastructure-001", "briefing-parks-public-space-belonging-001", "briefing-cultural-faith-indigenous-place-governance-001", "briefing-cooperatives-community-ownership-001", "briefing-mutual-aid-volunteer-capacity-001", "briefing-local-media-information-integrity-001", "briefing-trusted-intermediaries-public-knowledge-001", "briefing-social-isolation-belonging-participation-001", "briefing-neighborhood-preparedness-community-hubs-001", "briefing-collective-trauma-recovery-001", "briefing-long-horizon-collective-resilience-001"];
const mapIds = ["dependency-map-institution-presence-is-not-community-access", "dependency-map-volunteer-count-is-not-mutual-aid-capacity", "dependency-map-information-volume-is-not-public-knowledge", "dependency-map-consultation-is-not-collective-governance", "dependency-map-emergency-plan-is-not-community-preparedness", "dependency-map-reopening-is-not-collective-recovery"];
const state = kind === "institution" ? record.institution_state : kind === "civic" ? record.civic_state : kind === "information" ? record.information_state : record.resilience_state;
const id = kind === "institution" ? record.community_institution_access_trust_continuity_dossier_id : kind === "civic" ? record.civic_association_cooperative_mutual_aid_capacity_ledger_id : kind === "information" ? record.local_information_media_public_knowledge_integrity_register_id : record.collective_preparedness_trauma_recovery_resilience_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase82Record = phase82.neighborhood_access_displacement_crisis_recovery_ledgers.find((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  institution: { label: "Community Institution Access, Trust And Continuity Dossier", gates: record.institution_checks, gateCount: 20, groups: [["Community institution classes", record.community_institution_class_records, "institution_state"], ["Access and trust dimensions", record.institution_access_trust_dimension_records, "dimension_state"], ["Institution continuity safeguards", record.institution_continuity_safeguard_records, "safeguard_state"]], decision: record.institution_decision },
  civic: { label: "Civic Association, Cooperative And Mutual-Aid Capacity Ledger", gates: record.civic_capacity_checks, gateCount: 20, groups: [["Civic network types", record.civic_network_type_records, "network_state"], ["Mutual-aid capacity dimensions", record.mutual_aid_capacity_dimension_records, "capacity_state"], ["Volunteer and worker safeguards", record.volunteer_worker_safeguard_records, "safeguard_state"]], decision: record.capacity_decision },
  information: { label: "Local Information, Media And Public-Knowledge Integrity Register", gates: record.information_integrity_checks, gateCount: 22, groups: [["Information ecosystem functions", record.information_ecosystem_function_records, "function_state"], ["Information integrity safeguards", record.information_integrity_safeguard_records, "safeguard_state"], ["Public-knowledge access modes", record.public_knowledge_access_mode_records, "access_state"]], decision: record.information_decision },
  resilience: { label: "Collective Preparedness, Trauma, Recovery And Resilience Ledger", gates: record.collective_resilience_checks, gateCount: 22, groups: [["Community preparedness capabilities", record.community_preparedness_capability_records, "capability_state"], ["Collective-trauma recovery safeguards", record.collective_trauma_recovery_safeguard_records, "safeguard_state"], ["Institution closure and displacement safeguards", record.institution_closure_displacement_safeguard_records, "safeguard_state"], ["Long-horizon collective resilience tests", record.long_horizon_collective_resilience_test_records, "test_state"]], decision: record.resilience_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 83 community-institutions and collective-resilience contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 community decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 82 recovery ledger</h2><p>{phase82Record ? <a href={'/evidence/household-capability/' + phase82Record.slug + '/'}>{record.neighborhood_access_displacement_crisis_recovery_ledger_id ?? phase82Record.neighborhood_access_displacement_crisis_recovery_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 findings, activations, closures, restorations, remedies, receipts, scores, rankings, or stage changes</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, owner, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Institution presence is not community access; reopening is not collective recovery.</h2><p>No institution admission, access or trust finding, civic-network admission, volunteer allocation, mutual-aid capacity finding, truth classification, content suppression, preparedness activation, closure, restoration, reconstruction, recovery finding, remedy, reviewer identity, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Phase 84 Destination</div><h2>Continue into food systems and community resource security.</h2><p>Phase 84 keeps production, land, water, sovereignty, processing, storage, logistics, procurement, workforce, access, affordability, nutrition, institutional meals, reserves, contamination, circularity, and long-horizon security inactive until this Phase 83 chain is reviewed and receipted.</p></div><article class="record-card"><a class="inline-link" href="/evidence/food-systems/">Open the Phase 84 registry</a></article></section>
</BaseLayout>
