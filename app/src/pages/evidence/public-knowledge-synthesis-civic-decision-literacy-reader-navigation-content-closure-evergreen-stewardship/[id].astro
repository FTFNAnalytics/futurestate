---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-102-public-knowledge-synthesis-civic-decision-literacy-reader-navigation-content-closure-evergreen-stewardship-registry.json";
import phase101 from "../../../data/phase-101-whole-system-futures-scenario-governance-polycrisis-readiness-civilizational-resilience-future-generations-registry.json";

export function getStaticPaths() {
  return [
    ...registry.canonical_public_synthesis_claim_boundary_evidence_lineage_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "synthesis", record } })),
    ...registry.civic_decision_literacy_uncertainty_tradeoff_public_reason_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "literacy", record } })),
    ...registry.reader_navigation_learning_pathway_accessibility_translation_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "navigation", record } })),
    ...registry.content_completeness_maintenance_correction_archive_evergreen_stewardship_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "stewardship", record } }))
  ];
}
const { kind, record } = Astro.props as { kind: "synthesis" | "literacy" | "navigation" | "stewardship"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-public-knowledge-synthesis-decision-literacy-content-stewardship-doctrine-001", "briefing-canonical-synthesis-claim-boundaries-evidence-lineage-001", "briefing-counterevidence-uncertainty-confidence-correction-001", "briefing-facts-findings-inferences-scenarios-judgments-001", "briefing-civic-decision-literacy-authority-options-tradeoffs-001", "briefing-numbers-denominators-risk-causation-public-reason-001", "briefing-distribution-rights-values-disagreement-legitimate-pluralism-001", "briefing-reader-orientation-learning-pathways-progressive-disclosure-001", "briefing-accessibility-plain-language-translation-low-bandwidth-001", "briefing-search-cross-links-comparative-reading-without-ranking-001", "briefing-content-coverage-gaps-quality-debt-maintenance-ownership-001", "briefing-corrections-versioning-archives-refresh-evergreen-stewardship-001"];
const mapIds = ["dependency-map-synthesis-is-not-new-evidence", "dependency-map-explanation-is-not-recommendation-or-authorization", "dependency-map-navigation-is-not-comprehension-or-access", "dependency-map-publication-volume-is-not-content-completeness", "dependency-map-archive-is-not-erasure", "dependency-map-stable-page-is-not-evergreen-truth"];
const state = kind === "synthesis" ? record.synthesis_state : kind === "literacy" ? record.decision_literacy_state : kind === "navigation" ? record.reader_navigation_state : record.content_stewardship_state;
const id = kind === "synthesis" ? record.canonical_public_synthesis_claim_boundary_evidence_lineage_dossier_id : kind === "literacy" ? record.civic_decision_literacy_uncertainty_tradeoff_public_reason_ledger_id : kind === "navigation" ? record.reader_navigation_learning_pathway_accessibility_translation_register_id : record.content_completeness_maintenance_correction_archive_evergreen_stewardship_ledger_id;
const title = id + ": " + record.named_entity;
const upstream = phase101.civilizational_resilience_renewal_future_generations_stewardship_ledgers.find((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  synthesis: { label: "Canonical Public Synthesis, Claim Boundary And Evidence-Lineage Dossier", gates: record.synthesis_checks, gateCount: 20, groups: [["Synthesis classes", record.synthesis_class_records, "class_state"], ["Synthesis dimensions", record.synthesis_dimension_records, "dimension_state"], ["Synthesis safeguards", record.synthesis_safeguard_records, "safeguard_state"]], decision: record.synthesis_decision },
  literacy: { label: "Civic Decision Literacy, Uncertainty, Tradeoff And Public-Reason Ledger", gates: record.decision_literacy_checks, gateCount: 22, groups: [["Literacy classes", record.decision_literacy_class_records, "class_state"], ["Literacy dimensions", record.decision_literacy_dimension_records, "dimension_state"], ["Literacy safeguards", record.decision_literacy_safeguard_records, "safeguard_state"]], decision: record.decision_literacy_decision },
  navigation: { label: "Reader Navigation, Learning Pathway, Accessibility And Translation Register", gates: record.reader_navigation_checks, gateCount: 22, groups: [["Navigation classes", record.reader_navigation_class_records, "class_state"], ["Navigation dimensions", record.reader_navigation_dimension_records, "dimension_state"], ["Navigation safeguards", record.reader_navigation_safeguard_records, "safeguard_state"]], decision: record.reader_navigation_decision },
  stewardship: { label: "Content Completeness, Maintenance, Correction, Archive And Evergreen-Stewardship Ledger", gates: record.content_stewardship_checks, gateCount: 24, groups: [["Stewardship classes", record.content_stewardship_class_records, "class_state"], ["Stewardship dimensions", record.content_stewardship_dimension_records, "dimension_state"], ["Stewardship safeguards", record.content_stewardship_safeguard_records, "safeguard_state"], ["Long-horizon tests", record.long_horizon_content_stewardship_test_records, "test_state"]], decision: record.content_stewardship_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 102 public-knowledge and content-stewardship contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 content-closure decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 101 civilizational-resilience ledger</h2><p>{upstream ? <a href={"/evidence/whole-system-futures-scenario-governance-polycrisis-readiness-civilizational-resilience-future-generations/" + upstream.slug + "/"}>{upstream.civilizational_resilience_renewal_future_generations_stewardship_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Roadmap position</h2><p>Terminal planned content layer; evidence operations continue.</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, decision or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={"/briefings/" + item.data.slug + "/"}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={"/atlas/dependency-maps/" + item.data.slug + "/"}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={"/atlas/sources/" + item.data.id + "/"}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={"/signals/" + item.data.slug + "/"}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>A synthesis is not new evidence; a stable page is not evergreen truth.</h2><p>No evidence, recommendation, reader classification, comprehension, accessibility, translation, completeness, archive, deletion, reviewer, receipt, score, rank or stage change is recorded.</p></div></section>
</BaseLayout>
