---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-86-health-public-health-disability-population-wellbeing-registry.json";
import phase85 from "../../../data/phase-85-housing-shelter-land-use-place-stability-registry.json";
import phase87 from "../../../data/phase-87-education-learning-skills-knowledge-cultural-capability-registry.json";

export function getStaticPaths() {
  return [
    ...registry.primary_preventive_community_care_access_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "access", record } })),
    ...registry.acute_emergency_specialty_behavioral_health_care_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "care", record } })),
    ...registry.public_health_surveillance_prevention_environmental_exposure_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "publicHealth", record } })),
    ...registry.disability_equity_preparedness_population_wellbeing_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "wellbeing", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "access" | "care" | "publicHealth" | "wellbeing"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-health-population-wellbeing-doctrine-001", "briefing-primary-preventive-community-care-access-001", "briefing-acute-emergency-hospital-critical-care-001", "briefing-mental-health-substance-use-harm-reduction-001", "briefing-reproductive-maternal-newborn-child-health-001", "briefing-medicines-diagnostics-health-supply-chains-001", "briefing-public-health-surveillance-vaccination-outbreak-001", "briefing-environmental-occupational-food-water-air-health-001", "briefing-disability-rights-supports-accessible-care-001", "briefing-indigenous-rural-remote-health-jurisdiction-001", "briefing-health-workforce-quality-safety-affordability-001", "briefing-health-preparedness-recovery-population-wellbeing-001"];
const mapIds = ["dependency-map-nominal-capacity-is-not-timely-access", "dependency-map-coverage-is-not-affordable-care", "dependency-map-encounter-is-not-health-outcome", "dependency-map-surveillance-signal-is-not-diagnosis", "dependency-map-emergency-declaration-is-not-readiness", "dependency-map-service-reopening-is-not-population-recovery"];
const state = kind === "access" ? record.access_state : kind === "care" ? record.care_state : kind === "publicHealth" ? record.public_health_state : record.wellbeing_state;
const id = kind === "access" ? record.primary_preventive_community_care_access_dossier_id : kind === "care" ? record.acute_emergency_specialty_behavioral_health_care_ledger_id : kind === "publicHealth" ? record.public_health_surveillance_prevention_environmental_exposure_register_id : record.disability_equity_preparedness_population_wellbeing_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase85Record = phase85.retrofit_climate_disaster_reconstruction_place_stability_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase87Records = [
  ...phase87.early_childhood_school_access_inclusion_learning_dossiers,
  ...phase87.postsecondary_vocational_apprenticeship_affordability_ledgers,
  ...phase87.learning_capability_credential_skills_transition_registers,
  ...phase87.public_knowledge_culture_research_community_learning_ledgers
].filter((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  access: { label: "Primary, Preventive And Community-Care Access Dossier", gates: record.access_checks, gateCount: 20, groups: [["Health-access care settings", record.health_access_care_setting_records, "access_state"], ["Health-access and affordability dimensions", record.health_access_affordability_dimension_records, "dimension_state"], ["Prevention and primary-care safeguards", record.prevention_primary_care_safeguard_records, "safeguard_state"]], decision: record.access_decision },
  care: { label: "Acute, Emergency, Specialty And Behavioral-Health Care Ledger", gates: record.care_checks, gateCount: 20, groups: [["Acute and specialty service classes", record.acute_specialty_service_class_records, "service_state"], ["Clinical quality and safety dimensions", record.clinical_quality_safety_dimension_records, "dimension_state"], ["Health-workforce and continuity safeguards", record.health_workforce_continuity_safeguard_records, "safeguard_state"]], decision: record.care_decision },
  publicHealth: { label: "Public-Health Surveillance, Prevention And Environmental-Exposure Register", gates: record.public_health_checks, gateCount: 22, groups: [["Public-health functions", record.public_health_function_records, "function_state"], ["Surveillance-governance safeguards", record.surveillance_governance_safeguard_records, "safeguard_state"], ["Environmental and occupational-exposure dimensions", record.environmental_occupational_exposure_dimension_records, "dimension_state"]], decision: record.public_health_decision },
  wellbeing: { label: "Disability, Equity, Preparedness And Population-Wellbeing Ledger", gates: record.wellbeing_checks, gateCount: 22, groups: [["Disability-rights and support dimensions", record.disability_rights_support_dimension_records, "dimension_state"], ["Emergency-preparedness capabilities", record.emergency_preparedness_capability_records, "capability_state"], ["Population-wellbeing and equity dimensions", record.population_wellbeing_equity_dimension_records, "dimension_state"], ["Long-horizon population-health tests", record.long_horizon_population_health_test_records, "test_state"]], decision: record.wellbeing_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 86 health and population-wellbeing contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 health decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 85 place-stability ledger</h2><p>{phase85Record ? <a href={'/evidence/housing-place-stability/' + phase85Record.slug + '/'}>{record.retrofit_climate_disaster_reconstruction_place_stability_ledger_id ?? phase85Record.retrofit_climate_disaster_reconstruction_place_stability_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 diagnoses, eligibility or triage decisions, restrictions, classifications, findings, remedies, receipts, scores, rankings, or stage changes</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, diagnosis, finding, owner, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 87 Destination</div><h2>Education, learning, knowledge, and culture remain downstream.</h2></div></div><div class="source-list">{phase87Records.map((item) => <article class="source-row"><div><h3><a href={'/evidence/education-knowledge-culture/' + item.slug + '/'}>{item.named_entity}</a></h3><p>{item.record_kind}</p></div><MetaPill label="Inactive" tone="review" /></article>)}</div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Capacity is not access; service reopening is not population recovery.</h2><p>No eligibility or coverage decision, diagnosis, triage decision, treatment assignment, clinical quality or safety finding, surveillance or exposure finding, restriction, disability classification, preparedness conclusion, recovery or population-wellbeing finding, reviewer identity, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
