---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-89-income-wealth-poverty-social-protection-economic-security-registry.json";
import phase88 from "../../../data/phase-88-work-labor-livelihoods-economic-democracy-registry.json";
import phase90 from "../../../data/phase-90-markets-firms-competition-corporate-power-democratic-economic-governance-registry.json";

export function getStaticPaths() {
  return [
    ...registry.household_income_earnings_tax_transfer_resource_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "income", record } })),
    ...registry.wealth_assets_debt_liabilities_intergenerational_balance_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "wealth", record } })),
    ...registry.poverty_deprivation_social_protection_benefit_access_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "protection", record } })),
    ...registry.economic_security_distribution_shock_mobility_long_horizon_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "security", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "income" | "wealth" | "protection" | "security"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-income-wealth-poverty-social-protection-economic-security-doctrine-001", "briefing-household-income-earnings-resources-001", "briefing-taxes-transfers-redistribution-fiscal-incidence-001", "briefing-wealth-assets-liabilities-balance-sheets-001", "briefing-debt-credit-insolvency-financial-resilience-001", "briefing-poverty-material-deprivation-persistent-hardship-001", "briefing-benefit-eligibility-take-up-denial-appeal-001", "briefing-unemployment-disability-care-child-family-protection-001", "briefing-pensions-retirement-survivor-late-life-security-001", "briefing-inflation-prices-costs-macroeconomic-shocks-001", "briefing-community-wealth-universal-supports-public-options-001", "briefing-intergenerational-mobility-distribution-shared-prosperity-001"];
const mapIds = ["dependency-map-income-transfer-is-not-freedom-from-poverty", "dependency-map-earnings-are-not-household-wealth", "dependency-map-benefit-eligibility-is-not-benefit-access", "dependency-map-aggregate-growth-is-not-shared-prosperity", "dependency-map-asset-ownership-is-not-economic-security", "dependency-map-poverty-exit-is-not-durable-mobility"];
const state = kind === "income" ? record.income_state : kind === "wealth" ? record.wealth_state : kind === "protection" ? record.protection_state : record.security_state;
const id = kind === "income" ? record.household_income_earnings_tax_transfer_resource_dossier_id : kind === "wealth" ? record.wealth_assets_debt_liabilities_intergenerational_balance_ledger_id : kind === "protection" ? record.poverty_deprivation_social_protection_benefit_access_register_id : record.economic_security_distribution_shock_mobility_long_horizon_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase88Record = phase88.livelihood_security_displacement_just_transition_long_horizon_ledgers.find((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  income: { label: "Household Income, Earnings, Tax, Transfer And Resource Dossier", gates: record.income_checks, gateCount: 20, groups: [["Income-source classes", record.income_source_class_records, "source_state"], ["Household-resource adequacy dimensions", record.household_resource_adequacy_dimension_records, "dimension_state"], ["Tax-transfer administration safeguards", record.tax_transfer_administration_safeguard_records, "safeguard_state"]], decision: record.income_decision },
  wealth: { label: "Wealth, Assets, Debt, Liabilities And Intergenerational-Balance Ledger", gates: record.wealth_checks, gateCount: 20, groups: [["Wealth, asset, and liability classes", record.wealth_asset_liability_class_records, "class_state"], ["Wealth-security and distribution dimensions", record.wealth_security_distribution_dimension_records, "dimension_state"], ["Debt, insolvency, and inheritance safeguards", record.debt_insolvency_inheritance_safeguard_records, "safeguard_state"]], decision: record.wealth_decision },
  protection: { label: "Poverty, Deprivation, Social Protection And Benefit-Access Register", gates: record.protection_checks, gateCount: 22, groups: [["Poverty and material-deprivation dimensions", record.poverty_material_deprivation_dimension_records, "dimension_state"], ["Social-protection systems", record.social_protection_system_records, "system_state"], ["Benefit-access, rights, and administration safeguards", record.benefit_access_rights_administration_safeguard_records, "safeguard_state"]], decision: record.protection_decision },
  security: { label: "Economic Security, Distribution, Shock, Mobility And Long-Horizon Ledger", gates: record.security_checks, gateCount: 22, groups: [["Economic-security and shock-response systems", record.economic_security_shock_response_system_records, "system_state"], ["Shared-prosperity and distribution dimensions", record.shared_prosperity_distribution_dimension_records, "dimension_state"], ["Intergenerational-mobility and security safeguards", record.intergenerational_mobility_security_safeguard_records, "safeguard_state"], ["Long-horizon economic-security tests", record.long_horizon_economic_security_test_records, "test_state"]], decision: record.security_decision }
};
const config = configs[kind];
const phase90Records = [
  ...phase90.firm_formation_ownership_control_governance_dossiers,
  ...phase90.market_structure_competition_pricing_conduct_ledgers,
  ...phase90.corporate_power_platform_supply_chain_public_support_registers,
  ...phase90.democratic_economic_governance_rights_remedy_long_horizon_ledgers
].filter((item) => item.cohort_id === record.cohort_id);
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 89 income, wealth, poverty, protection, and economic-security contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 economic-security decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 88 livelihood-security ledger</h2><p>{phase88Record ? <a href={'/evidence/work-labor-livelihoods/' + phase88Record.slug + '/'}>{record.livelihood_security_displacement_just_transition_long_horizon_ledger_id ?? phase88Record.livelihood_security_displacement_just_transition_long_horizon_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 income, tax, transfer, wealth, debt, poverty, deprivation, benefit, sanction, distribution, mobility, shared-prosperity, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 90 Destination</div><h2>Markets, firms, competition, corporate-power, and democratic-governance controls</h2></div></div><div class="source-list">{phase90Records.map((item: any) => <article class="source-row"><div><h3><a href={'/evidence/markets-firms-economic-governance/' + item.slug + '/'}>{item.named_entity}</a></h3><p>Inactive until this Phase 89 chain is independently verified and receipted.</p></div><MetaPill label="Inactive" tone="review" /></article>)}</div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>An income transfer is not freedom from poverty; poverty exit is not durable mobility.</h2><p>No household-resource, tax, transfer, wealth, debt, poverty, deprivation, eligibility, benefit-access, sanction, shared-prosperity, mobility, economic-security, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
