---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-76-cross-case-learning-portfolio-policy-retirement-registry.json";

export function getStaticPaths() {
  return [
    ...registry.institutional_learning_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "learning", record } })),
    ...registry.cross_case_transfer_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "comparison", record } })),
    ...registry.portfolio_governance_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "portfolio", record } })),
    ...registry.policy_supersession_retirement_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "policy", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "learning" | "comparison" | "portfolio" | "policy"; record: any };
const learningById = new Map(registry.institutional_learning_dossiers.map((item) => [item.institutional_learning_dossier_id, item]));
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-cross-case-infrastructure-delivery-001", "briefing-cross-case-public-authority-001", "briefing-cross-case-regulated-autonomy-001", "briefing-cross-case-industrial-capacity-001", "briefing-cross-case-digital-assurance-001", "briefing-cross-case-local-system-burden-001", "briefing-institutional-memory-negative-results-001", "briefing-policy-retirement-decommissioning-001"];
const mapIds = ["dependency-map-audited-decision-is-not-transferable-policy", "dependency-map-portfolio-benefit-is-not-shared-benefit", "dependency-map-supersession-is-not-retirement-or-erasure"];
const state = kind === "learning" ? record.learning_state : kind === "comparison" ? record.comparison_state : kind === "portfolio" ? record.portfolio_state : record.lifecycle_state;
const title = kind === "learning" ? `${record.institutional_learning_dossier_id}: ${record.named_entity}` : kind === "comparison" ? `${record.cross_case_transfer_register_id}: ${record.left_named_entity} / ${record.right_named_entity}` : kind === "portfolio" ? `${record.portfolio_governance_register_id}: ${record.portfolio_label}` : `${record.policy_supersession_retirement_ledger_id}: ${record.named_entity}`;
const connectedLearning = kind === "learning" ? [record] : kind === "comparison" ? [learningById.get(record.left_institutional_learning_dossier_id), learningById.get(record.right_institutional_learning_dossier_id)].filter(Boolean) : kind === "portfolio" ? record.institutional_learning_dossier_ids.map((id: string) => learningById.get(id)).filter(Boolean) : [learningById.get(record.institutional_learning_dossier_id)].filter(Boolean);
const sourceIds: string[] = [...new Set<string>(connectedLearning.flatMap((item: any) => item.source_ids as string[]))];
const signalIds: string[] = [...new Set<string>(connectedLearning.flatMap((item: any) => item.signal_ids as string[]))];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 76 cross-case learning and policy-lifecycle contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{kind === "learning" ? "Institutional Learning Dossier" : kind === "comparison" ? "Pairwise Transfer Register" : kind === "portfolio" ? "Portfolio Governance Register" : "Policy Retirement Ledger"}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 conclusions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>

  {kind === "learning" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 75 decision</h2><p><a href={'/evidence/accountability/' + record.decision_accountability_dossier_slug + '/'}>{record.decision_accountability_dossier_id}</a></p></article><article class="status-item"><h2>Phase 75 audit</h2><p>{record.post_decision_audit_remediation_register_id}: {record.phase75_audit_state}</p></article><article class="status-item"><h2>Pairwise reviews</h2><p>{record.cross_case_transfer_register_ids.length} inactive registers</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Learning Admission</div><h2>Fourteen gates remain Inactive.</h2></div></div><div class="source-list">{record.learning_admission_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Institutional Memory</div><h2>Twelve retention classes remain Empty.</h2></div></div><div class="grid">{record.retention_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No admitted record, lesson, exception, correction, or receipt exists.</p><MetaPill label={item.retention_state} tone="review" /></article>)}</div></section></>}

  {kind === "comparison" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Left case</h2><p><a href={'/evidence/learning/' + connectedLearning[0]?.slug + '/'}>{record.left_named_entity}</a></p></article><article class="status-item"><h2>Right case</h2><p><a href={'/evidence/learning/' + connectedLearning[1]?.slug + '/'}>{record.right_named_entity}</a></p></article><article class="status-item"><h2>Transfer decision</h2><p>{record.transfer_decision}</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Comparability</div><h2>Sixteen gates remain Inactive.</h2></div></div><div class="source-list">{record.comparison_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Transfer Conditions</div><h2>Twelve condition classes remain Not Assessable.</h2></div></div><div class="grid">{record.transfer_condition_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No compatibility, exception, transfer, or non-transfer finding exists.</p><MetaPill label={item.condition_state} tone="review" /></article>)}</div></section></>}

  {kind === "portfolio" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Members</h2><p>{record.named_entities.length} named cases</p></article><article class="status-item"><h2>Pairwise registers</h2><p>{record.cross_case_transfer_register_ids.length} inactive comparisons</p></article><article class="status-item"><h2>Governance decision</h2><p>{record.governance_decision}</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Portfolio Governance</div><h2>Fourteen gates remain Inactive.</h2></div></div><div class="source-list">{record.portfolio_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Shared-Risk Triggers</div><h2>Twelve trigger classes remain Dormant.</h2></div></div><div class="grid">{record.portfolio_risk_trigger_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No dependency, concentration, cumulative-burden, rebalancing, or exit event exists.</p><MetaPill label={item.trigger_state} tone="review" /></article>)}</div></section></>}

  {kind === "policy" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Learning dossier</h2><p><a href={'/evidence/learning/' + connectedLearning[0]?.slug + '/'}>{record.institutional_learning_dossier_id}</a></p></article><article class="status-item"><h2>Current policy</h2><p>None</p></article><article class="status-item"><h2>Retirement decision</h2><p>{record.retirement_decision}</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Policy Lifecycle</div><h2>Fourteen gates remain Inactive.</h2></div></div><div class="source-list">{record.lifecycle_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Decommissioning</div><h2>Ten obligations remain Unavailable.</h2></div></div><div class="grid">{record.decommissioning_obligation_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No owner, evidence, completion decision, residual-duty review, or receipt exists.</p><MetaPill label={item.obligation_state} tone="review" /></article>)}</div></section></>}

  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((id) => { const briefing = briefingById.get(id); return <li>{briefing ? <a href={'/briefings/' + briefing.data.slug + '/'}>{briefing.data.title}</a> : id}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((id) => { const map = mapById.get(id); return <li>{map ? <a href={'/atlas/dependency-maps/' + map.data.slug + '/'}>{map.data.title}</a> : id}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{sourceIds.map((id) => { const source = sourceById.get(id); return <li>{source ? <a href={'/atlas/sources/' + source.data.id + '/'}>{source.data.name}</a> : id}</li>; })}{signalIds.map((id) => { const signal = signalById.get(id); return <li>{signal ? <a href={'/signals/' + signal.data.slug + '/'}>{signal.data.title}</a> : id}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Similarity does not establish transferability, shared benefit, or authority to reuse.</h2><p>No audited decision, learning admission, institutional-memory memo, comparison, transfer finding, portfolio conclusion, cumulative-burden finding, supersession, retirement, decommissioning action, reviewer decision, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
  <section class="page-section"><article class="record-card"><div class="eyebrow">Phase 77 Destination</div><h2>Public deliberation remains downstream.</h2><p>Standing, notice, accessibility, consultation, consent, comments, hearings, public reason, appeal, mandate, and adaptive review remain inactive until Phase 76 admits a real cross-case transfer or non-transfer finding tied to a public decision question.</p><a class="inline-link" href="/evidence/deliberation/">Open the Public Deliberation Registry</a></article></section>
</BaseLayout>
