---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-101-whole-system-futures-scenario-governance-polycrisis-readiness-civilizational-resilience-future-generations-registry.json";
import phase100 from "../../../data/phase-100-international-order-multilateral-cooperation-global-commons-cross-border-risk-shared-human-futures-registry.json";
import phase102 from "../../../data/phase-102-public-knowledge-synthesis-civic-decision-literacy-reader-navigation-content-closure-evergreen-stewardship-registry.json";

export function getStaticPaths() {
  return [
    ...registry.whole_system_scenario_assumption_boundary_driver_uncertainty_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "scenario", record } })),
    ...registry.cross_domain_dependency_cascade_compound_risk_polycrisis_stress_test_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "polycrisis", record } })),
    ...registry.preparedness_option_portfolio_continuity_recovery_transformation_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "readiness", record } })),
    ...registry.civilizational_resilience_renewal_future_generations_stewardship_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "resilience", record } }))
  ];
}
const { kind, record } = Astro.props as { kind: "scenario" | "polycrisis" | "readiness" | "resilience"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-whole-system-futures-scenario-governance-polycrisis-resilience-doctrine-001", "briefing-scenario-purpose-assumptions-boundaries-uncertainty-001", "briefing-drivers-discontinuities-branching-signposts-triggers-001", "briefing-models-quantification-tail-risk-deep-uncertainty-001", "briefing-cross-domain-dependencies-cascades-feedback-polycrisis-001", "briefing-stress-tests-exercises-near-misses-corrective-action-001", "briefing-preparedness-options-hedges-reserves-real-options-001", "briefing-continuity-recovery-restoration-reconstruction-transformation-001", "briefing-distributed-capacity-mutual-aid-public-options-001", "briefing-civilizational-resilience-essential-floors-knowledge-institutions-001", "briefing-future-generations-standing-option-value-irreversible-harm-001", "briefing-renewal-nonrecurrence-shared-human-futures-001"];
const mapIds = ["dependency-map-scenario-is-not-a-forecast", "dependency-map-risk-register-is-not-readiness", "dependency-map-foresight-exercise-is-not-a-decision", "dependency-map-redundancy-is-not-resilience", "dependency-map-continuity-is-not-renewal", "dependency-map-long-term-goal-is-not-future-generations-protection"];
const state = kind === "scenario" ? record.scenario_state : kind === "polycrisis" ? record.polycrisis_state : kind === "readiness" ? record.readiness_state : record.civilizational_resilience_state;
const id = kind === "scenario" ? record.whole_system_scenario_assumption_boundary_driver_uncertainty_dossier_id : kind === "polycrisis" ? record.cross_domain_dependency_cascade_compound_risk_polycrisis_stress_test_ledger_id : kind === "readiness" ? record.preparedness_option_portfolio_continuity_recovery_transformation_register_id : record.civilizational_resilience_renewal_future_generations_stewardship_ledger_id;
const title = id + ": " + record.named_entity;
const upstream = phase100.global_commons_transboundary_risk_catastrophic_risk_intergenerational_shared_human_futures_ledgers.find((item) => item.cohort_id === record.cohort_id);
const downstream = phase102.canonical_public_synthesis_claim_boundary_evidence_lineage_dossiers.find((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  scenario: { label: "Whole-System Scenario, Assumption, Boundary, Driver And Uncertainty Dossier", gates: record.scenario_checks, gateCount: 20, groups: [["Scenario classes", record.scenario_class_records, "class_state"], ["Scenario dimensions", record.scenario_dimension_records, "dimension_state"], ["Scenario safeguards", record.scenario_safeguard_records, "safeguard_state"]], decision: record.scenario_decision },
  polycrisis: { label: "Cross-Domain Dependency, Cascade, Compound-Risk And Polycrisis Stress-Test Ledger", gates: record.polycrisis_checks, gateCount: 22, groups: [["Polycrisis classes", record.polycrisis_class_records, "class_state"], ["Polycrisis dimensions", record.polycrisis_dimension_records, "dimension_state"], ["Polycrisis safeguards", record.polycrisis_safeguard_records, "safeguard_state"]], decision: record.polycrisis_decision },
  readiness: { label: "Preparedness, Option-Portfolio, Continuity, Recovery And Transformation Register", gates: record.readiness_checks, gateCount: 22, groups: [["Readiness options", record.readiness_option_class_records, "class_state"], ["Readiness dimensions", record.readiness_dimension_records, "dimension_state"], ["Readiness safeguards", record.readiness_safeguard_records, "safeguard_state"]], decision: record.readiness_decision },
  resilience: { label: "Civilizational Resilience, Renewal And Future-Generations Stewardship Ledger", gates: record.civilizational_resilience_checks, gateCount: 24, groups: [["Resilience classes", record.civilizational_resilience_class_records, "class_state"], ["Resilience dimensions", record.civilizational_resilience_dimension_records, "dimension_state"], ["Resilience safeguards", record.civilizational_resilience_safeguard_records, "safeguard_state"], ["Long-horizon tests", record.long_horizon_civilizational_resilience_test_records, "test_state"]], decision: record.civilizational_resilience_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 101 whole-system futures and resilience contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 scenario or resilience decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 100 shared-futures ledger</h2><p>{upstream ? <a href={"/evidence/international-order-multilateral-cooperation-global-commons-cross-border-risk-shared-human-futures/" + upstream.slug + "/"}>{upstream.global_commons_transboundary_risk_catastrophic_risk_intergenerational_shared_human_futures_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Phase 102 Destination</h2><p>{downstream ? <a href={"/evidence/public-knowledge-synthesis-civic-decision-literacy-reader-navigation-content-closure-evergreen-stewardship/" + downstream.slug + "/"}>{downstream.canonical_public_synthesis_claim_boundary_evidence_lineage_dossier_id}</a> : "No assigned downstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, allocation, decision or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={"/briefings/" + item.data.slug + "/"}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={"/atlas/dependency-maps/" + item.data.slug + "/"}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={"/atlas/sources/" + item.data.id + "/"}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={"/signals/" + item.data.slug + "/"}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>A scenario is not a forecast; continuity is not renewal.</h2><p>No probability, stress-test result, readiness finding, option selection, activation, recovery, resilience, future-generations, reviewer, receipt, score, rank or stage change is recorded.</p></div></section>
</BaseLayout>
