---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-82-household-capability-care-infrastructure-everyday-security-registry.json";
import phase81 from "../../../data/phase-81-universal-service-essential-systems-public-option-delivery-registry.json";

export function getStaticPaths() {
  return [
    ...registry.household_capability_service_bundle_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "capability", record } })),
    ...registry.care_infrastructure_workforce_capacity_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "care", record } })),
    ...registry.household_affordability_time_debt_administrative_burden_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "burden", record } })),
    ...registry.neighborhood_access_displacement_crisis_recovery_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "recovery", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "capability" | "care" | "burden" | "recovery"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-household-capability-doctrine-001", "briefing-time-poverty-unpaid-care-001", "briefing-care-infrastructure-workforce-001", "briefing-essential-service-bundles-households-001", "briefing-neighborhood-proximity-rural-access-001", "briefing-household-affordability-arrears-debt-001", "briefing-administrative-burden-benefit-access-001", "briefing-disability-universal-design-home-community-001", "briefing-life-course-transitions-household-security-001", "briefing-displacement-household-mobility-001", "briefing-crisis-stabilization-recovery-001", "briefing-long-horizon-household-security-001"];
const mapIds = ["dependency-map-service-availability-is-not-household-capability", "dependency-map-unpaid-care-is-not-free-capacity", "dependency-map-program-eligibility-is-not-benefit-access", "dependency-map-low-monthly-bill-is-not-household-affordability", "dependency-map-neighborhood-proximity-is-not-accessibility", "dependency-map-temporary-relief-is-not-household-recovery"];
const state = kind === "capability" ? record.capability_state : kind === "care" ? record.care_state : kind === "burden" ? record.burden_state : record.recovery_state;
const id = kind === "capability" ? record.household_capability_service_bundle_dossier_id : kind === "care" ? record.care_infrastructure_workforce_capacity_ledger_id : kind === "burden" ? record.household_affordability_time_debt_administrative_burden_register_id : record.neighborhood_access_displacement_crisis_recovery_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase81Record = phase81.rights_quality_step_in_restoration_ledgers.find((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  capability: { label: "Household Capability And Service Bundle Dossier", gates: record.capability_checks, gateCount: 20, groups: [["Household capabilities", record.household_capability_dimension_records, "capability_state"], ["Service bundles", record.household_service_bundle_class_records, "bundle_state"], ["Life-course stages", record.life_course_stage_records, "stage_state"]], decision: record.adoption_decision },
  care: { label: "Care Infrastructure, Workforce And Capacity Ledger", gates: record.care_capacity_checks, gateCount: 20, groups: [["Care services", record.care_service_class_records, "service_state"], ["Capacity dimensions", record.care_capacity_dimension_records, "capacity_state"], ["Workforce safeguards", record.care_workforce_safeguard_records, "safeguard_state"]], decision: record.capacity_decision },
  burden: { label: "Household Affordability, Time, Debt And Administrative Burden Register", gates: record.household_burden_checks, gateCount: 22, groups: [["Household burdens", record.household_burden_dimension_records, "burden_state"], ["Shock and arrears pathways", record.shock_arrears_pathway_records, "pathway_state"], ["Administrative safeguards", record.administrative_burden_safeguard_records, "safeguard_state"]], decision: record.protection_decision },
  recovery: { label: "Neighborhood Access, Displacement, Crisis And Recovery Ledger", gates: record.neighborhood_recovery_checks, gateCount: 22, groups: [["Neighborhood access tests", record.neighborhood_access_test_records, "test_state"], ["Displacement safeguards", record.displacement_mobility_safeguard_records, "safeguard_state"], ["Crisis stabilizers", record.crisis_stabilizer_records, "stabilizer_state"], ["Long-horizon security tests", record.long_horizon_household_security_test_records, "test_state"]], decision: record.recovery_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 82 household-capability and everyday-security contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 household decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 81 restoration ledger</h2><p>{phase81Record ? <a href={'/evidence/essential-services/' + phase81Record.slug + '/'}>{record.rights_quality_step_in_restoration_ledger_id ?? phase81Record.rights_quality_step_in_restoration_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 findings, interventions, remedies, receipts, scores, rankings, or stage changes</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, owner, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Service availability is not household capability; temporary relief is not household recovery.</h2><p>No household class, capability floor, service bundle, care need, workforce allocation, affordability result, benefit-access result, debt action, displacement finding, crisis response, recovery finding, remedy, reviewer identity, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
  {kind === "recovery" && <section class="page-section"><div class="record-card"><div class="eyebrow">Phase 83 Destination</div><h2>Community institutions and collective resilience remain downstream.</h2><p><a href={'/evidence/community-institutions/83-cid-' + record.slug.slice(7) + '/'}>Open the corresponding Phase 83 community-institution dossier</a>. Institution presence, civic activity, information volume, an emergency plan, or reopening cannot establish community capacity or collective recovery.</p></div></section>}
</BaseLayout>
