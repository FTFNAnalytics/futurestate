---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-90-markets-firms-competition-corporate-power-democratic-economic-governance-registry.json";
import phase89 from "../../../data/phase-89-income-wealth-poverty-social-protection-economic-security-registry.json";
import phase91 from "../../../data/phase-91-finance-banking-credit-capital-allocation-monetary-systems-financial-stability-registry.json";

export function getStaticPaths() {
  return [
    ...registry.firm_formation_ownership_control_governance_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "firm", record } })),
    ...registry.market_structure_competition_pricing_conduct_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "market", record } })),
    ...registry.corporate_power_platform_supply_chain_public_support_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "power", record } })),
    ...registry.democratic_economic_governance_rights_remedy_long_horizon_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "governance", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "firm" | "market" | "power" | "governance"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-markets-firms-competition-corporate-power-democratic-economic-governance-doctrine-001", "briefing-firm-formation-enterprise-lifecycle-001", "briefing-ownership-control-beneficial-ownership-001", "briefing-corporate-governance-boards-stakeholders-public-obligations-001", "briefing-market-structure-concentration-entry-contestability-001", "briefing-competition-monopoly-monopsony-collusion-exclusion-001", "briefing-prices-markups-profits-rents-quality-pass-through-001", "briefing-mergers-acquisitions-rollups-remedies-001", "briefing-platforms-data-algorithms-network-effects-001", "briefing-supply-chains-buyer-power-franchises-procurement-001", "briefing-enterprise-plurality-small-business-cooperatives-public-options-001", "briefing-corporate-support-accountability-rights-remedies-public-value-001"];
const mapIds = ["dependency-map-firm-count-is-not-competitive-market", "dependency-map-lower-price-is-not-complete-consumer-welfare", "dependency-map-market-concentration-is-not-proven-abuse", "dependency-map-profit-is-not-productive-investment", "dependency-map-merger-approval-is-not-public-benefit", "dependency-map-corporate-disclosure-is-not-democratic-accountability"];
const state = kind === "firm" ? record.firm_state : kind === "market" ? record.market_state : kind === "power" ? record.power_state : record.governance_state;
const id = kind === "firm" ? record.firm_formation_ownership_control_governance_dossier_id : kind === "market" ? record.market_structure_competition_pricing_conduct_ledger_id : kind === "power" ? record.corporate_power_platform_supply_chain_public_support_register_id : record.democratic_economic_governance_rights_remedy_long_horizon_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase89Record = phase89.economic_security_distribution_shock_mobility_long_horizon_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase91Records = [
  ...phase91.money_payments_banking_access_settlement_dossiers,
  ...phase91.credit_underwriting_affordability_servicing_productive_allocation_ledgers,
  ...phase91.capital_markets_institutional_investment_insurance_risk_transfer_registers,
  ...phase91.monetary_policy_systemic_risk_resolution_public_guarantee_democratic_finance_ledgers
].filter((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  firm: { label: "Firm Formation, Ownership, Control And Governance Dossier", gates: record.firm_checks, gateCount: 20, groups: [["Enterprise legal and ownership forms", record.enterprise_legal_ownership_form_records, "form_state"], ["Firm-governance and accountability dimensions", record.firm_governance_accountability_dimension_records, "dimension_state"], ["Firm-lifecycle and exit safeguards", record.firm_lifecycle_exit_safeguard_records, "safeguard_state"]], decision: record.firm_decision },
  market: { label: "Market Structure, Competition, Pricing And Conduct Ledger", gates: record.market_checks, gateCount: 20, groups: [["Market and transaction-structure classes", record.market_transaction_structure_class_records, "class_state"], ["Competition and market-power dimensions", record.competition_market_power_dimension_records, "dimension_state"], ["Price, quality, access, and conduct safeguards", record.price_quality_access_conduct_safeguard_records, "safeguard_state"]], decision: record.market_decision },
  power: { label: "Corporate Power, Platform, Supply Chain And Public Support Register", gates: record.power_checks, gateCount: 22, groups: [["Corporate-power and influence channels", record.corporate_power_influence_channel_records, "channel_state"], ["Platform, supply-chain, finance, and public-support dimensions", record.platform_supply_chain_finance_public_support_dimension_records, "dimension_state"], ["Disclosure, beneficial-ownership, and accountability safeguards", record.corporate_disclosure_beneficial_ownership_accountability_safeguard_records, "safeguard_state"]], decision: record.power_decision },
  governance: { label: "Democratic Economic Governance, Rights, Remedy And Long-Horizon Ledger", gates: record.governance_checks, gateCount: 22, groups: [["Democratic economic-governance institutions", record.democratic_economic_governance_institution_records, "institution_state"], ["Affected-constituency and public-value dimensions", record.affected_constituency_public_value_dimension_records, "dimension_state"], ["Intervention, remedy, and due-process safeguards", record.intervention_remedy_due_process_safeguard_records, "safeguard_state"], ["Long-horizon market-ecosystem tests", record.long_horizon_market_ecosystem_test_records, "test_state"]], decision: record.governance_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 90 market, firm, corporate-power, and democratic-governance contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 market-governance decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 89 economic-security ledger</h2><p>{phase89Record ? <a href={'/evidence/income-wealth-economic-security/' + phase89Record.slug + '/'}>{record.economic_security_distribution_shock_mobility_long_horizon_ledger_id ?? phase89Record.economic_security_distribution_shock_mobility_long_horizon_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 firm, ownership, control, market, competition, price, quality, conduct, platform, supply-chain, subsidy, tax, merger, remedy, public-value, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 91 Destination</div><h2>Finance, banking, credit, capital-allocation, monetary-system, and financial-stability controls</h2></div></div><div class="source-list">{phase91Records.map((item: any) => <article class="source-row"><div><h3><a href={'/evidence/finance-banking-credit-financial-stability/' + item.slug + '/'}>{item.named_entity}</a></h3><p>Inactive until this Phase 90 democratic-economic-governance chain is independently verified and receipted.</p></div><MetaPill label="Inactive" tone="review" /></article>)}</div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>A firm count is not a competitive market; corporate disclosure is not democratic accountability.</h2><p>No firm, ownership, control, market, competition, price, quality, conduct, platform, supply-chain, financialization, influence, subsidy, tax, merger, remedy, public-value, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
