---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-95-infrastructure-construction-buildings-public-works-territorial-systems-delivery-registry.json";
import phase94 from "../../../data/phase-94-energy-materials-manufacturing-logistics-strategic-supply-chain-transformation-registry.json";
import phase96 from "../../../data/phase-96-mobility-transportation-freight-communications-digital-networks-territorial-access-registry.json";

export function getStaticPaths() {
  return [
    ...registry.spatial_planning_land_assembly_rights_of_way_site_readiness_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "territorial", record } })),
    ...registry.project_design_engineering_cost_estimation_permitting_procurement_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "project", record } })),
    ...registry.construction_contractors_trades_materials_safety_inspection_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "construction", record } })),
    ...registry.commissioning_accessibility_asset_handover_operations_maintenance_adaptation_reconstruction_territorial_value_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "stewardship", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "territorial" | "project" | "construction" | "stewardship"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-infrastructure-construction-buildings-public-works-territorial-systems-doctrine-001", "briefing-spatial-planning-land-assembly-rights-of-way-site-readiness-001", "briefing-permitting-environmental-review-utilities-community-consent-001", "briefing-project-definition-design-engineering-cost-estimation-001", "briefing-procurement-contracting-project-packaging-market-capacity-001", "briefing-contractors-trades-materials-equipment-construction-logistics-001", "briefing-construction-safety-quality-inspection-change-control-001", "briefing-buildings-housing-civic-industrial-public-facilities-001", "briefing-transportation-water-energy-digital-public-works-001", "briefing-commissioning-accessibility-handover-operations-maintenance-001", "briefing-climate-adaptation-disaster-reconstruction-community-recovery-001", "briefing-public-space-place-value-community-benefit-indigenous-rights-001"];
const mapIds = ["dependency-map-capital-plan-is-not-executable-project", "dependency-map-permit-is-not-construction-start", "dependency-map-construction-spending-is-not-commissioned-asset", "dependency-map-substantial-completion-is-not-safe-accessible-service", "dependency-map-floor-area-is-not-place-value", "dependency-map-reconstruction-output-is-not-community-recovery"];
const state = kind === "territorial" ? record.territorial_state : kind === "project" ? record.project_state : kind === "construction" ? record.construction_state : record.stewardship_state;
const id = kind === "territorial" ? record.spatial_planning_land_assembly_rights_of_way_site_readiness_dossier_id : kind === "project" ? record.project_design_engineering_cost_estimation_permitting_procurement_ledger_id : kind === "construction" ? record.construction_contractors_trades_materials_safety_inspection_register_id : record.commissioning_accessibility_asset_handover_operations_maintenance_adaptation_reconstruction_territorial_value_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase94Record = phase94.logistics_inventory_strategic_reserves_emergency_conversion_supply_chain_resilience_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase96Records = [
  phase96.passenger_mobility_demand_accessibility_affordability_inclusion_dossiers.find((item) => item.cohort_id === record.cohort_id),
  phase96.multimodal_transportation_service_planning_operations_safety_reliability_ledgers.find((item) => item.cohort_id === record.cohort_id),
  phase96.freight_goods_movement_intermodal_logistics_delivery_resilience_registers.find((item) => item.cohort_id === record.cohort_id),
  phase96.communications_broadband_mobile_digital_public_infrastructure_interoperability_territorial_access_ledgers.find((item) => item.cohort_id === record.cohort_id)
].filter(Boolean);
const configs: Record<string, any> = {
  territorial: { label: "Spatial Planning, Land Assembly, Rights Of Way And Site-Readiness Dossier", gates: record.territorial_checks, gateCount: 20, groups: [["Territorial planning and site classes", record.territorial_planning_site_class_records, "class_state"], ["Territorial-readiness dimensions", record.territorial_readiness_dimension_records, "dimension_state"], ["Territorial-rights and public-value safeguards", record.territorial_rights_public_value_safeguard_records, "safeguard_state"]], decision: record.territorial_decision },
  project: { label: "Project Design, Engineering, Cost Estimation, Permitting And Procurement Ledger", gates: record.project_checks, gateCount: 22, groups: [["Project-design and procurement classes", record.project_design_procurement_class_records, "class_state"], ["Project-definition, design, and delivery dimensions", record.project_definition_design_delivery_dimension_records, "dimension_state"], ["Project-procurement governance safeguards", record.project_procurement_governance_safeguard_records, "safeguard_state"]], decision: record.project_decision },
  construction: { label: "Construction, Contractors, Trades, Materials, Safety And Inspection Register", gates: record.construction_checks, gateCount: 22, groups: [["Construction work-package classes", record.construction_work_package_class_records, "class_state"], ["Construction-delivery assurance dimensions", record.construction_delivery_assurance_dimension_records, "dimension_state"], ["Construction worker and community safeguards", record.construction_worker_community_safeguard_records, "safeguard_state"]], decision: record.construction_decision },
  stewardship: { label: "Commissioning, Accessibility, Asset Handover, Operations, Maintenance, Adaptation, Reconstruction And Territorial-Value Ledger", gates: record.stewardship_checks, gateCount: 24, groups: [["Asset, service, and stewardship classes", record.asset_service_stewardship_class_records, "class_state"], ["Asset-service and stewardship dimensions", record.asset_service_stewardship_dimension_records, "dimension_state"], ["Territorial-service rights safeguards", record.territorial_service_rights_safeguard_records, "safeguard_state"], ["Long-horizon territorial-system tests", record.long_horizon_territorial_system_test_records, "test_state"]], decision: record.stewardship_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 95 infrastructure, construction, buildings, public works, and territorial-systems contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 territorial-delivery decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 94 supply-chain resilience ledger</h2><p>{phase94Record ? <a href={'/evidence/energy-materials-manufacturing-supply-chains/' + phase94Record.slug + '/'}>{phase94Record.logistics_inventory_strategic_reserves_emergency_conversion_supply_chain_resilience_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 land, right-of-way, site, permit, design, estimate, procurement, contract, construction, progress, safety, quality, commissioning, occupancy, accessibility, service, maintenance, reconstruction, recovery, place-value, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 96 Destination</div><h2>Continue into mobility, transportation, freight and digital access.</h2></div></div><div class="grid">{phase96Records.map((item: any) => <article class="record-card"><h3><a href={'/evidence/mobility-transportation-freight-communications-digital-networks/' + item.slug + '/'}>{Object.values(item).find((value) => typeof value === "string" && /^96-(MAD|TSL|FRR|DAL)-/.test(value))}</a></h3><p>{item.record_kind.replaceAll("_", " ")}</p><MetaPill label="Inactive" tone="review" /></article>)}</div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>A capital plan is not an executable project; substantial completion is not safe accessible service.</h2><p>No plan, parcel, permit, design, estimate, award, contract, construction, commissioning, service, maintenance, recovery, place-value, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
