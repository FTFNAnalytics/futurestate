---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-84-food-systems-local-provisioning-community-resource-security-registry.json";
import phase83 from "../../../data/phase-83-community-institutions-social-infrastructure-collective-resilience-registry.json";

export function getStaticPaths() {
  return [
    ...registry.food_production_land_water_sovereignty_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "production", record } })),
    ...registry.processing_storage_distribution_local_provisioning_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "provisioning", record } })),
    ...registry.food_access_affordability_nutrition_institutional_meals_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "access", record } })),
    ...registry.reserve_contamination_circularity_community_resource_security_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "security", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "production" | "provisioning" | "access" | "security"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-food-systems-doctrine-001", "briefing-regional-neighborhood-provisioning-001", "briefing-land-access-tenure-stewardship-001", "briefing-indigenous-food-sovereignty-001", "briefing-food-water-energy-climate-dependencies-001", "briefing-agricultural-food-workforce-001", "briefing-processing-storage-cold-chain-001", "briefing-logistics-markets-public-procurement-001", "briefing-school-institutional-meals-001", "briefing-food-affordability-nutrition-dignity-001", "briefing-emergency-reserves-community-kitchens-001", "briefing-food-waste-circularity-resource-security-001"];
const mapIds = ["dependency-map-food-availability-is-not-nutritional-access", "dependency-map-inventory-is-not-usable-reserve", "dependency-map-local-production-is-not-resilient-provisioning", "dependency-map-procurement-spend-is-not-community-benefit", "dependency-map-waste-diversion-is-not-circular-capacity", "dependency-map-short-term-distribution-is-not-durable-food-security"];
const state = kind === "production" ? record.production_state : kind === "provisioning" ? record.provisioning_state : kind === "access" ? record.access_state : record.security_state;
const id = kind === "production" ? record.food_production_land_water_sovereignty_dossier_id : kind === "provisioning" ? record.processing_storage_distribution_local_provisioning_ledger_id : kind === "access" ? record.food_access_affordability_nutrition_institutional_meals_register_id : record.reserve_contamination_circularity_community_resource_security_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase83Record = phase83.collective_preparedness_trauma_recovery_resilience_ledgers.find((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  production: { label: "Food Production, Land, Water And Sovereignty Dossier", gates: record.production_checks, gateCount: 20, groups: [["Food-production system types", record.food_production_system_type_records, "production_state"], ["Land-access, tenure, and stewardship safeguards", record.land_access_tenure_stewardship_safeguard_records, "safeguard_state"], ["Water, energy, and climate dependency tests", record.water_energy_climate_dependency_test_records, "test_state"]], decision: record.production_decision },
  provisioning: { label: "Processing, Storage, Distribution And Local-Provisioning Ledger", gates: record.provisioning_checks, gateCount: 20, groups: [["Processing, storage, and distribution modes", record.processing_storage_distribution_mode_records, "mode_state"], ["Local-procurement and community-benefit dimensions", record.local_procurement_community_benefit_dimension_records, "dimension_state"], ["Food-workforce and logistics safeguards", record.food_workforce_logistics_safeguard_records, "safeguard_state"]], decision: record.provisioning_decision },
  access: { label: "Food Access, Affordability, Nutrition And Institutional-Meals Register", gates: record.food_access_checks, gateCount: 22, groups: [["Food-access channels", record.food_access_channel_records, "channel_state"], ["Affordability, nutrition, and dignity dimensions", record.affordability_nutrition_dignity_dimension_records, "dimension_state"], ["Institutional-meal and community-provisioning safeguards", record.institutional_meal_community_provisioning_safeguard_records, "safeguard_state"]], decision: record.access_decision },
  security: { label: "Reserve, Contamination, Circularity And Community-Resource-Security Ledger", gates: record.resource_security_checks, gateCount: 22, groups: [["Emergency-reserve capabilities", record.emergency_reserve_capability_records, "capability_state"], ["Contamination and biosecurity safeguards", record.contamination_biosecurity_safeguard_records, "safeguard_state"], ["Food-waste and circular-flow capabilities", record.food_waste_circular_flow_capability_records, "capability_state"], ["Long-horizon community-resource-security tests", record.long_horizon_community_resource_security_test_records, "test_state"]], decision: record.security_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 84 food-systems and community-resource-security contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 food-system decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 83 resilience ledger</h2><p>{phase83Record ? <a href={'/evidence/community-institutions/' + phase83Record.slug + '/'}>{record.collective_preparedness_trauma_recovery_resilience_ledger_id ?? phase83Record.collective_preparedness_trauma_recovery_resilience_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 allocations, findings, releases, recalls, remedies, receipts, scores, rankings, or stage changes</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, owner, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Availability is not access; inventory is not usable reserve.</h2><p>No production baseline, land or water allocation, sovereignty finding, provisioning-capacity finding, procurement decision, community-benefit finding, food-access or nutrition finding, benefit allocation, reserve release, rationing order, recall, contamination remedy, circular-capacity finding, resource-security conclusion, reviewer identity, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 85 Destination</div><h2>Housing, shelter, land use, and place stability remain downstream.</h2></div><a class="inline-link" href="/evidence/housing-place-stability/">Open the Phase 85 registry</a></div><p>Only a reviewed and receipted Phase 84 resource-security chain can open its matched housing-delivery dossier. No qualifying predecessor exists.</p></section>
</BaseLayout>
