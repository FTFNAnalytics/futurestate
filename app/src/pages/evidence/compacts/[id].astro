---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-78-interjurisdictional-compacts-shared-public-value-emergency-resilience-registry.json";
import phase77 from "../../../data/phase-77-public-deliberation-participatory-governance-adaptive-mandate-registry.json";

export function getStaticPaths() {
  return [
    ...registry.interjurisdictional_authority_externality_maps.map((record) => ({ params: { id: record.slug }, props: { kind: "authority", record } })),
    ...registry.shared_public_value_contribution_compacts.map((record) => ({ params: { id: record.slug }, props: { kind: "compact", record } })),
    ...registry.mutual_aid_continuity_dispute_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "continuity", record } })),
    ...registry.emergency_authority_normalization_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "emergency", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "authority" | "compact" | "continuity" | "emergency"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-cooperative-federalism-municipal-authority-001", "briefing-indigenous-treaty-intergovernmental-compacts-001", "briefing-cross-border-infrastructure-externalities-001", "briefing-shared-public-value-allocation-001", "briefing-fiscal-capacity-contribution-sharing-001", "briefing-mutual-aid-service-continuity-001", "briefing-intergovernmental-dispute-resolution-001", "briefing-emergency-powers-civil-safeguards-001", "briefing-crisis-evidence-public-communication-001", "briefing-emergency-authority-normalization-001"];
const mapIds = ["dependency-map-one-public-mandate-is-not-a-multi-authority-compact", "dependency-map-local-benefit-is-not-shared-public-value", "dependency-map-fiscal-contribution-is-not-governing-control", "dependency-map-emergency-activation-is-not-permanent-authority", "dependency-map-service-continuity-is-not-rights-suspension"];
const state = kind === "authority" ? record.mapping_state : kind === "compact" ? record.compact_state : kind === "continuity" ? record.continuity_state : record.emergency_state;
const id = kind === "authority" ? record.interjurisdictional_authority_externality_map_id : kind === "compact" ? record.shared_public_value_contribution_compact_id : kind === "continuity" ? record.mutual_aid_continuity_dispute_register_id : record.emergency_authority_normalization_ledger_id;
const title = `${id}: ${record.named_entity}`;
const sourceIds: string[] = record.source_ids;
const signalIds: string[] = record.signal_ids;
const phase77Record = phase77.adaptive_mandate_review_ledgers.find((item) => item.adaptive_mandate_review_ledger_id === record.adaptive_mandate_review_ledger_id) ?? phase77.adaptive_mandate_review_ledgers.find((item) => item.cohort_id === record.cohort_id);
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 78 interjurisdictional compact and emergency-resilience contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{kind === "authority" ? "Interjurisdictional Authority And Externality Map" : kind === "compact" ? "Shared Public Value And Contribution Compact" : kind === "continuity" ? "Mutual Aid, Continuity And Dispute Register" : "Emergency Authority And Normalization Ledger"}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 compact records" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>

  {kind === "authority" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 77 mandate ledger</h2><p>{phase77Record ? <a href={'/evidence/deliberation/' + phase77Record.slug + '/'}>{record.adaptive_mandate_review_ledger_id}</a> : record.adaptive_mandate_review_ledger_id}: {record.phase77_adaptive_state}</p></article><article class="status-item"><h2>Opening decision</h2><p>{record.opening_decision}</p></article><article class="status-item"><h2>Authority findings</h2><p>0 mappings or externality findings</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Authority And Externalities</div><h2>Sixteen gates remain Inactive.</h2></div></div><div class="source-list">{record.authority_externality_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Jurisdictions</div><h2>Twelve jurisdiction classes remain Unmapped.</h2></div></div><div class="grid">{record.jurisdiction_assignment_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, duty, delegation, conflict, or dispute record exists.</p><MetaPill label={item.assignment_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Externalities</div><h2>Twelve cross-boundary classes remain Unassessed.</h2></div></div><div class="grid">{record.externality_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No origin, destination, evidence, distribution, residual duty, or finding exists.</p><MetaPill label={item.assessment_state} tone="review" /></article>)}</div></section></>}

  {kind === "compact" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Authority map</h2><p>{record.interjurisdictional_authority_externality_map_id}</p></article><article class="status-item"><h2>Compact decision</h2><p>{record.compact_decision}</p></article><article class="status-item"><h2>Executed compact</h2><p>None</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Compact And Contributions</div><h2>Eighteen gates remain Inactive.</h2></div></div><div class="source-list">{record.compact_contribution_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Shared Public Value</div><h2>Twelve value classes remain Not Valued.</h2></div></div><div class="grid">{record.public_value_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No beneficiary, indicator, distribution, allocation, or remedy finding exists.</p><MetaPill label={item.value_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Contributions</div><h2>Twelve contribution classes remain Uncommitted.</h2></div></div><div class="grid">{record.contribution_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No contributor, amount, capacity, condition, liability, audit, or control right exists.</p><MetaPill label={item.contribution_state} tone="review" /></article>)}</div></section></>}

  {kind === "continuity" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Value compact</h2><p>{record.shared_public_value_contribution_compact_id}</p></article><article class="status-item"><h2>Operating decision</h2><p>{record.operating_decision}</p></article><article class="status-item"><h2>Requests and disputes</h2><p>0 requests, activations, or disputes</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Continuity And Disputes</div><h2>Sixteen gates remain Inactive.</h2></div></div><div class="source-list">{record.continuity_dispute_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Continuity Obligations</div><h2>Twelve obligation classes remain Dormant.</h2></div></div><div class="grid">{record.continuity_obligation_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No owner, resource, request, activation, handback, or closure exists.</p><MetaPill label={item.obligation_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Disputes</div><h2>Ten dispute grounds remain Unavailable.</h2></div></div><div class="grid">{record.dispute_ground_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No dispute, interim measure, decision, appeal, remedy, or receipt exists.</p><MetaPill label={item.ground_state} tone="review" /></article>)}</div></section></>}

  {kind === "emergency" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Continuity register</h2><p>{record.mutual_aid_continuity_dispute_register_id}</p></article><article class="status-item"><h2>Emergency decision</h2><p>{record.emergency_decision}</p></article><article class="status-item"><h2>Activation</h2><p>None lawfully activated</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Emergency To Normalization</div><h2>Eighteen gates remain Inactive.</h2></div></div><div class="source-list">{record.emergency_normalization_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Civil Safeguards</div><h2>Twelve safeguards remain Inactive.</h2></div></div><div class="grid">{record.emergency_safeguard_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No evidence, activation, breach, challenge, remedy, or oversight finding exists.</p><MetaPill label={item.safeguard_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Restoration</div><h2>Twelve restoration triggers remain Dormant.</h2></div></div><div class="grid">{record.restoration_trigger_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No event, review, expiry, normalization, reauthorization, or receipt exists.</p><MetaPill label={item.trigger_state} tone="review" /></article>)}</div></section></>}

  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const briefing = briefingById.get(guideId); return <li>{briefing ? <a href={'/briefings/' + briefing.data.slug + '/'}>{briefing.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const map = mapById.get(mapId); return <li>{map ? <a href={'/atlas/dependency-maps/' + map.data.slug + '/'}>{map.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{sourceIds.map((sourceId) => { const source = sourceById.get(sourceId); return <li>{source ? <a href={'/atlas/sources/' + source.data.id + '/'}>{source.data.name}</a> : sourceId}</li>; })}{signalIds.map((signalId) => { const signal = signalById.get(signalId); return <li>{signal ? <a href={'/signals/' + signal.data.slug + '/'}>{signal.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section"><article class="record-card"><div class="eyebrow">Phase 79 Destination</div><h2>Public wealth and stewardship remain downstream.</h2><p>Only a real executed Phase 78 compact with ordinary-authority value, burden, contribution, continuity, dispute, exit, restoration, and receipt terms can open the matching Phase 79 asset-and-obligation register.</p><a class="inline-link" href="/evidence/stewardship/">Inspect the inactive Phase 79 registry</a></article></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>A public mandate is not a compact, and an emergency is not permanent authority.</h2><p>No authorized Phase 77 mandate, jurisdiction assignment, externality finding, compact, contribution, mutual-aid activation, dispute, emergency authority, rights suspension, extension, normalization, reauthorization, reviewer identity, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
