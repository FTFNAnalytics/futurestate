---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-91-finance-banking-credit-capital-allocation-monetary-systems-financial-stability-registry.json";
import phase90 from "../../../data/phase-90-markets-firms-competition-corporate-power-democratic-economic-governance-registry.json";
import phase92 from "../../../data/phase-92-fiscal-policy-public-revenue-sovereign-debt-trade-external-balance-macroeconomic-coordination-registry.json";

export function getStaticPaths() {
  return [
    ...registry.money_payments_banking_access_settlement_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "money", record } })),
    ...registry.credit_underwriting_affordability_servicing_productive_allocation_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "credit", record } })),
    ...registry.capital_markets_institutional_investment_insurance_risk_transfer_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "capital", record } })),
    ...registry.monetary_policy_systemic_risk_resolution_public_guarantee_democratic_finance_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "stability", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "money" | "credit" | "capital" | "stability"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-finance-banking-credit-capital-allocation-monetary-systems-financial-stability-doctrine-001", "briefing-money-units-cash-deposits-digital-currency-001", "briefing-payment-clearing-settlement-custody-continuity-001", "briefing-banking-deposits-accounts-inclusion-public-options-001", "briefing-credit-underwriting-pricing-servicing-collections-001", "briefing-household-debt-mortgages-bankruptcy-fresh-start-001", "briefing-business-project-credit-productive-allocation-additionality-001", "briefing-capital-markets-securities-valuation-liquidity-ownership-001", "briefing-asset-management-pensions-fiduciary-stewardship-001", "briefing-insurance-risk-transfer-reinsurance-catastrophe-001", "briefing-central-banks-monetary-policy-transmission-distribution-001", "briefing-financial-stability-leverage-liquidity-resolution-public-guarantees-001"];
const mapIds = ["dependency-map-account-access-is-not-financial-inclusion", "dependency-map-credit-availability-is-not-productive-allocation", "dependency-map-asset-price-growth-is-not-durable-wealth", "dependency-map-capitalization-is-not-resilience", "dependency-map-central-bank-intervention-is-not-distributional-legitimacy", "dependency-map-financial-innovation-is-not-financial-stability"];
const state = kind === "money" ? record.money_state : kind === "credit" ? record.credit_state : kind === "capital" ? record.capital_state : record.stability_state;
const id = kind === "money" ? record.money_payments_banking_access_settlement_dossier_id : kind === "credit" ? record.credit_underwriting_affordability_servicing_productive_allocation_ledger_id : kind === "capital" ? record.capital_markets_institutional_investment_insurance_risk_transfer_register_id : record.monetary_policy_systemic_risk_resolution_public_guarantee_democratic_finance_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase90Record = phase90.democratic_economic_governance_rights_remedy_long_horizon_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase92Records = [
  ...phase92.public_revenue_tax_expenditure_distribution_compliance_dossiers,
  ...phase92.budget_expenditure_stabilizer_delivery_public_value_ledgers,
  ...phase92.sovereign_debt_fiscal_rule_public_balance_sheet_resilience_registers,
  ...phase92.trade_external_balance_supply_resilience_macroeconomic_coordination_ledgers
].filter((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  money: { label: "Money, Payments, Banking Access And Settlement Dossier", gates: record.money_checks, gateCount: 20, groups: [["Money, payment, and monetary forms", record.money_payment_monetary_form_records, "form_state"], ["Banking-access and operational dimensions", record.banking_access_operational_dimension_records, "dimension_state"], ["Custody, settlement, and data safeguards", record.custody_settlement_data_safeguard_records, "safeguard_state"]], decision: record.money_decision },
  credit: { label: "Credit, Underwriting, Affordability, Servicing And Productive-Allocation Ledger", gates: record.credit_checks, gateCount: 20, groups: [["Credit-instrument and borrower classes", record.credit_instrument_borrower_class_records, "class_state"], ["Credit-underwriting and servicing dimensions", record.credit_underwriting_servicing_dimension_records, "dimension_state"], ["Credit-affordability and fairness safeguards", record.credit_affordability_fairness_safeguard_records, "safeguard_state"]], decision: record.credit_decision },
  capital: { label: "Capital Markets, Institutional Investment, Insurance And Risk-Transfer Register", gates: record.capital_checks, gateCount: 22, groups: [["Capital-market and institution classes", record.capital_market_institution_class_records, "class_state"], ["Allocation, valuation, and liquidity dimensions", record.allocation_valuation_liquidity_dimension_records, "dimension_state"], ["Fiduciary, insurance, and risk-transfer safeguards", record.fiduciary_insurance_risk_transfer_safeguard_records, "safeguard_state"]], decision: record.capital_decision },
  stability: { label: "Monetary Policy, Systemic Risk, Resolution, Public Guarantee And Democratic-Finance Ledger", gates: record.stability_checks, gateCount: 22, groups: [["Monetary and stability institutions", record.monetary_stability_institution_records, "institution_state"], ["Transmission and systemic-risk dimensions", record.transmission_systemic_risk_dimension_records, "dimension_state"], ["Intervention, resolution, and due-process safeguards", record.intervention_resolution_due_process_safeguard_records, "safeguard_state"], ["Long-horizon financial-system tests", record.long_horizon_financial_system_test_records, "test_state"]], decision: record.stability_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 91 finance, banking, credit, capital-allocation, monetary-system, and financial-stability contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 financial-system decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 90 democratic-governance ledger</h2><p>{phase90Record ? <a href={'/evidence/markets-firms-economic-governance/' + phase90Record.slug + '/'}>{phase90Record.democratic_economic_governance_rights_remedy_long_horizon_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 monetary, account, payment, settlement, credit, underwriting, pricing, servicing, collection, allocation, valuation, investment, insurance, monetary-policy, systemic-risk, guarantee, resolution, loss-allocation, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 92 Destination</div><h2>Carry democratic finance into fiscal and macroeconomic governance.</h2></div><a class="inline-link" href="/evidence/fiscal-revenue-debt-trade-macro-coordination/">Open the Phase 92 registry</a></div><div class="grid">{phase92Records.map((item) => <article class="record-card"><h3><a href={'/evidence/fiscal-revenue-debt-trade-macro-coordination/' + item.slug + '/'}>{item.named_entity}</a></h3><p>{item.record_kind.replaceAll('_', ' ')}</p></article>)}</div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Account access is not financial inclusion; financial innovation is not financial stability.</h2><p>No money, account, payment, banking, credit, underwriting, servicing, allocation, valuation, investment, insurance, intervention, guarantee, resolution, loss-allocation, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
