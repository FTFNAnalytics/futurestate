---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-79-public-wealth-long-horizon-stewardship-intergenerational-balance-sheet-registry.json";
import phase78 from "../../../data/phase-78-interjurisdictional-compacts-shared-public-value-emergency-resilience-registry.json";

export function getStaticPaths() {
  return [
    ...registry.public_asset_obligation_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "asset", record } })),
    ...registry.lifecycle_cost_maintenance_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "lifecycle", record } })),
    ...registry.procurement_dependency_contingent_risk_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "procurement", record } })),
    ...registry.intergenerational_balance_sheet_stewardship_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "balance", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "asset" | "lifecycle" | "procurement" | "balance"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-public-wealth-balance-sheet-001", "briefing-lifecycle-costing-whole-life-affordability-001", "briefing-procurement-vendor-lockin-public-options-001", "briefing-debt-guarantees-contingent-liabilities-001", "briefing-insurance-uninsurable-public-risk-001", "briefing-natural-cultural-community-assets-001", "briefing-maintenance-state-good-repair-deferred-liability-001", "briefing-reserves-sinking-funds-liquidity-001", "briefing-decommissioning-restoration-funding-001", "briefing-distributional-public-balance-sheets-001", "briefing-future-users-option-value-irreversibility-001", "briefing-fiscal-stress-restructuring-restoration-001"];
const mapIds = ["dependency-map-public-asset-register-is-not-market-valuation", "dependency-map-capital-authorization-is-not-lifecycle-affordability", "dependency-map-procurement-contract-is-not-public-capacity", "dependency-map-insurance-coverage-is-not-risk-elimination", "dependency-map-reserve-balance-is-not-funded-restoration", "dependency-map-present-value-is-not-intergenerational-fairness"];
const state = kind === "asset" ? record.register_state : kind === "lifecycle" ? record.lifecycle_state : kind === "procurement" ? record.procurement_risk_state : record.balance_sheet_state;
const id = kind === "asset" ? record.public_asset_obligation_register_id : kind === "lifecycle" ? record.lifecycle_cost_maintenance_ledger_id : kind === "procurement" ? record.procurement_dependency_contingent_risk_register_id : record.intergenerational_balance_sheet_stewardship_ledger_id;
const title = `${id}: ${record.named_entity}`;
const sourceIds: string[] = record.source_ids;
const signalIds: string[] = record.signal_ids;
const phase78Record = phase78.emergency_authority_normalization_ledgers.find((item) => item.cohort_id === record.cohort_id);
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 79 public-wealth and intergenerational-stewardship contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{kind === "asset" ? "Public Asset And Obligation Register" : kind === "lifecycle" ? "Lifecycle Cost And Maintenance Ledger" : kind === "procurement" ? "Procurement, Dependency And Contingent-Risk Register" : "Intergenerational Balance Sheet And Stewardship Ledger"}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 valuations" tone="review" /><MetaPill label="0 liabilities" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>

  {kind === "asset" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 78 compact ledger</h2><p>{phase78Record ? <a href={'/evidence/compacts/' + phase78Record.slug + '/'}>{record.emergency_authority_normalization_ledger_id}</a> : record.emergency_authority_normalization_ledger_id}</p></article><article class="status-item"><h2>Admission decision</h2><p>{record.admission_decision}</p></article><article class="status-item"><h2>Registered assets</h2><p>0 assets, obligations, or valuations</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Assets And Obligations</div><h2>Eighteen gates remain Inactive.</h2></div></div><div class="source-list">{record.asset_obligation_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Asset Classes</div><h2>Fourteen asset classes remain Unregistered.</h2></div></div><div class="grid">{record.asset_class_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No identity, authority, condition, capability, value, restriction, or distribution record exists.</p><MetaPill label={item.asset_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Obligation Classes</div><h2>Fourteen obligation classes remain Unregistered.</h2></div></div><div class="grid">{record.obligation_class_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No owner, trigger, amount, funding, remedy, successor, or receipt exists.</p><MetaPill label={item.obligation_state} tone="review" /></article>)}</div></section></>}

  {kind === "lifecycle" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Asset register</h2><p>{record.public_asset_obligation_register_id}</p></article><article class="status-item"><h2>Planning decision</h2><p>{record.planning_decision}</p></article><article class="status-item"><h2>Lifecycle plans</h2><p>0 plans or funded duties</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Lifecycle And Maintenance</div><h2>Eighteen gates remain Inactive.</h2></div></div><div class="source-list">{record.lifecycle_maintenance_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Lifecycle Stages</div><h2>Twelve lifecycle stages remain Unplanned.</h2></div></div><div class="grid">{record.lifecycle_stage_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No baseline, cost, evidence, uncertainty, plan, or decision exists.</p><MetaPill label={item.stage_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Maintenance Duties</div><h2>Twelve maintenance duties remain Unfunded.</h2></div></div><div class="grid">{record.maintenance_duty_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No owner, schedule, backlog, funding, service effect, or receipt exists.</p><MetaPill label={item.duty_state} tone="review" /></article>)}</div></section></>}

  {kind === "procurement" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Lifecycle ledger</h2><p>{record.lifecycle_cost_maintenance_ledger_id}</p></article><article class="status-item"><h2>Commitment decision</h2><p>{record.commitment_decision}</p></article><article class="status-item"><h2>Commitments</h2><p>0 procurements, debts, guarantees, or liabilities</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Procurement And Risk</div><h2>Twenty gates remain Inactive.</h2></div></div><div class="source-list">{record.procurement_risk_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Dependencies</div><h2>Twelve dependency classes remain Unassessed.</h2></div></div><div class="grid">{record.dependency_class_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No vendor, exposure, mitigation, public-capacity, or exit finding exists.</p><MetaPill label={item.dependency_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Liabilities And Insurance</div><h2>Fourteen liabilities remain Unrecognized; ten insurance limits remain Unassessed.</h2></div></div><div class="grid">{record.liability_class_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No obligation, trigger, exposure, funding, or recognition decision exists.</p><MetaPill label={item.liability_state} tone="review" /></article>)}{record.insurance_limit_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No policy, exposure, coverage response, gap, or residual-duty finding exists.</p><MetaPill label={item.limit_state} tone="review" /></article>)}</div></section></>}

  {kind === "balance" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Procurement-risk register</h2><p>{record.procurement_dependency_contingent_risk_register_id}</p></article><article class="status-item"><h2>Stewardship decision</h2><p>{record.stewardship_decision}</p></article><article class="status-item"><h2>Findings</h2><p>0 distributional, future-user, stress, or audit findings</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Intergenerational Stewardship</div><h2>Twenty gates remain Inactive.</h2></div></div><div class="source-list">{record.intergenerational_stewardship_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Distribution And Future Users</div><h2>Twelve distribution accounts remain Unmeasured; twelve future-user tests remain Not Tested.</h2></div></div><div class="grid">{record.distribution_account_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No benefit, burden, access, liability, remedy, or uncertainty record exists.</p><MetaPill label={item.account_state} tone="review" /></article>)}{record.future_user_test_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No evidence, scenario, finding, condition, or future-user decision exists.</p><MetaPill label={item.test_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Stress And Stewardship</div><h2>Twelve stress triggers remain Dormant; twelve stewardship duties remain Unassigned.</h2></div></div><div class="grid">{record.fiscal_stress_trigger_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No event, review, restructuring, restoration, or receipt exists.</p><MetaPill label={item.trigger_state} tone="review" /></article>)}{record.stewardship_duty_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No owner, funding, performance, audit, or handoff receipt exists.</p><MetaPill label={item.duty_state} tone="review" /></article>)}</div></section></>}

  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const briefing = briefingById.get(guideId); return <li>{briefing ? <a href={'/briefings/' + briefing.data.slug + '/'}>{briefing.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const map = mapById.get(mapId); return <li>{map ? <a href={'/atlas/dependency-maps/' + map.data.slug + '/'}>{map.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{sourceIds.map((sourceId) => { const source = sourceById.get(sourceId); return <li>{source ? <a href={'/atlas/sources/' + source.data.id + '/'}>{source.data.name}</a> : sourceId}</li>; })}{signalIds.map((signalId) => { const signal = signalById.get(signalId); return <li>{signal ? <a href={'/signals/' + signal.data.slug + '/'}>{signal.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>An asset register is not a valuation, and present value is not intergenerational fairness.</h2><p>No executed Phase 78 compact, asset admission, obligation recognition, valuation, lifecycle plan, maintenance funding, procurement, vendor selection, debt, guarantee, contingent liability, insurance finding, reserve, sinking fund, restoration fund, distributional finding, future-user finding, stress response, restructuring, restoration, audit, reviewer identity, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
  <section class="page-section"><article class="record-card"><div class="eyebrow">Phase 80 Destination</div><h2>Public investment portfolios and place-based transition remain downstream.</h2><p>Only a verified Phase 79 chain with admitted assets and obligations, authorized lifecycle and procurement-risk records, funded maintenance and closure duties, distribution and future-user findings, stress testing, independent audit, and receipts can open the matching Phase 80 investment-thesis dossier.</p><a class="inline-link" href="/evidence/investment-portfolios/">Inspect the inactive Phase 80 registry</a></article></section>
</BaseLayout>
