---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-94-energy-materials-manufacturing-logistics-strategic-supply-chain-transformation-registry.json";
import phase93 from "../../../data/phase-93-economic-development-industrial-strategy-innovation-systems-regional-convergence-productive-transformation-registry.json";
import phase95 from "../../../data/phase-95-infrastructure-construction-buildings-public-works-territorial-systems-delivery-registry.json";

export function getStaticPaths() {
  return [
    ...registry.energy_water_industrial_utility_reliability_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "energy", record } })),
    ...registry.minerals_materials_processing_circularity_qualification_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "materials", record } })),
    ...registry.manufacturing_equipment_automation_maintenance_quality_accepted_production_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "manufacturing", record } })),
    ...registry.logistics_inventory_strategic_reserves_emergency_conversion_supply_chain_resilience_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "supply", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "energy" | "materials" | "manufacturing" | "supply"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-energy-materials-manufacturing-logistics-strategic-supply-chain-doctrine-001", "briefing-energy-generation-grid-fuels-storage-reliability-001", "briefing-industrial-water-utilities-infrastructure-continuity-001", "briefing-minerals-metals-chemicals-advanced-materials-001", "briefing-extraction-refining-processing-fabrication-recycling-001", "briefing-material-qualification-traceability-standards-circularity-001", "briefing-factories-equipment-tooling-automation-maintenance-001", "briefing-accepted-production-quality-yield-reliability-001", "briefing-supplier-tiers-inventory-logistics-visibility-001", "briefing-ports-rail-road-aviation-maritime-warehousing-cold-chain-001", "briefing-strategic-reserves-emergency-conversion-mutual-aid-001", "briefing-technology-sovereignty-just-industrial-transition-001"];
const mapIds = ["dependency-map-installed-capacity-is-not-delivered-reliable-energy", "dependency-map-resource-endowment-is-not-qualified-material-supply", "dependency-map-factory-announcement-is-not-accepted-production", "dependency-map-logistics-throughput-is-not-resilient-access", "dependency-map-domestic-content-percentage-is-not-technological-sovereignty", "dependency-map-decarbonization-target-is-not-just-industrial-transition"];
const state = kind === "energy" ? record.energy_state : kind === "materials" ? record.materials_state : kind === "manufacturing" ? record.manufacturing_state : record.supply_chain_state;
const id = kind === "energy" ? record.energy_water_industrial_utility_reliability_dossier_id : kind === "materials" ? record.minerals_materials_processing_circularity_qualification_ledger_id : kind === "manufacturing" ? record.manufacturing_equipment_automation_maintenance_quality_accepted_production_register_id : record.logistics_inventory_strategic_reserves_emergency_conversion_supply_chain_resilience_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase93Record = phase93.productive_transformation_diversification_decarbonization_shared_prosperity_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase95Records = [
  ...phase95.spatial_planning_land_assembly_rights_of_way_site_readiness_dossiers,
  ...phase95.project_design_engineering_cost_estimation_permitting_procurement_ledgers,
  ...phase95.construction_contractors_trades_materials_safety_inspection_registers,
  ...phase95.commissioning_accessibility_asset_handover_operations_maintenance_adaptation_reconstruction_territorial_value_ledgers
].filter((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  energy: { label: "Energy, Water And Industrial-Utility Reliability Dossier", gates: record.energy_checks, gateCount: 20, groups: [["Energy, water, and industrial-utility classes", record.energy_water_industrial_utility_class_records, "class_state"], ["Industrial-utility reliability and access dimensions", record.industrial_utility_reliability_access_dimension_records, "dimension_state"], ["Energy, water, utility-rights, and resilience safeguards", record.energy_water_utility_rights_resilience_safeguard_records, "safeguard_state"]], decision: record.energy_decision },
  materials: { label: "Minerals, Materials, Processing, Circularity And Qualification Ledger", gates: record.materials_checks, gateCount: 20, groups: [["Mineral, material, processing, and supply classes", record.mineral_material_processing_supply_class_records, "class_state"], ["Material qualification, circularity, and traceability dimensions", record.material_qualification_circularity_traceability_dimension_records, "dimension_state"], ["Material-rights, environment, and public-value safeguards", record.material_rights_environment_public_value_safeguard_records, "safeguard_state"]], decision: record.materials_decision },
  manufacturing: { label: "Manufacturing, Equipment, Automation, Maintenance, Quality And Accepted-Production Register", gates: record.manufacturing_checks, gateCount: 22, groups: [["Manufacturing, factory, and production-system classes", record.manufacturing_factory_production_system_class_records, "class_state"], ["Equipment, automation, maintenance, and quality dimensions", record.equipment_automation_maintenance_quality_dimension_records, "dimension_state"], ["Worker, community, and accepted-production safeguards", record.worker_community_accepted_production_safeguard_records, "safeguard_state"]], decision: record.manufacturing_decision },
  supply: { label: "Logistics, Inventory, Strategic Reserves, Emergency Conversion And Supply-Chain Resilience Ledger", gates: record.supply_chain_checks, gateCount: 24, groups: [["Logistics, inventory, reserve, and network classes", record.logistics_inventory_reserve_network_class_records, "class_state"], ["Supply-chain visibility, access, and resilience dimensions", record.supply_chain_visibility_access_resilience_dimension_records, "dimension_state"], ["Strategic supply-chain governance safeguards", record.strategic_supply_chain_governance_safeguard_records, "safeguard_state"], ["Long-horizon physical-economy tests", record.long_horizon_physical_economy_test_records, "test_state"]], decision: record.supply_chain_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 94 industrial-utility, material, manufacturing, logistics, and strategic supply-chain contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 physical-economy decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 93 productive-transformation ledger</h2><p>{phase93Record ? <a href={'/evidence/economic-development-industrial-strategy-productive-transformation/' + phase93Record.slug + '/'}>{phase93Record.productive_transformation_diversification_decarbonization_shared_prosperity_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 utility, capacity, reliability, material, qualification, standard, manufacturing, production, quality, acceptance, logistics, inventory, reserve, conversion, sovereignty, just-transition, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 95 Destination</div><h2>Infrastructure, construction, buildings, public works, and territorial-systems controls.</h2></div></div><div class="grid">{phase95Records.map((item: any) => { const itemId = item.spatial_planning_land_assembly_rights_of_way_site_readiness_dossier_id ?? item.project_design_engineering_cost_estimation_permitting_procurement_ledger_id ?? item.construction_contractors_trades_materials_safety_inspection_register_id ?? item.commissioning_accessibility_asset_handover_operations_maintenance_adaptation_reconstruction_territorial_value_ledger_id; return <article class="record-card"><h3><a href={'/evidence/infrastructure-construction-buildings-public-works-territorial-systems/' + item.slug + '/'}>{itemId}</a></h3><p>Inactive until the complete Phase 94 chain is independently verified, human-reviewed, and receipted.</p></article>; })}</div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Installed capacity is not delivered reliable energy; a factory announcement is not accepted production.</h2><p>No resource, asset, allocation, supplier, qualification, production, acceptance, logistics, reserve, conversion, sovereignty, transition, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
