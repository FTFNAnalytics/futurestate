---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-69-measurement-observation-break-registry.json";
import reviewRegistry from "../../../data/phase-70-observation-review-series-admission-registry.json";

export function getStaticPaths() {
  return registry.measurement_specifications.map((record) => ({
    params: { id: record.slug },
    props: { record }
  }));
}

const { record } = Astro.props as { record: any };
const envelope = registry.observation_intake_envelopes.find((item) => item.specification_id === record.specification_id);
const breakRegister = registry.series_break_registers.find((item) => item.cohort_id === record.cohort_id);
const reviewDocket = reviewRegistry.observation_review_dockets.find((item) => item.specification_id === record.specification_id);
const [briefings, dependencyMaps, signals, sources] = await Promise.all([
  getCollection("briefings"),
  getCollection("dependencyMaps"),
  getCollection("signals"),
  getCollection("sources")
]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
---

<BaseLayout
  title={`${record.specification_id}: ${record.measure_label} | FTFN`}
  description={`${record.named_entity}: ${record.numerator_contract} divided by ${record.denominator_contract}. No observation or value is recorded.`}
  robots="index, follow"
>
  <section class="page-section">
    <div class="eyebrow">Measurement Specification</div>
    <h1 class="page-title">{record.specification_id}: {record.measure_label}</h1>
    <p class="lede">{record.named_entity}</p>
    <div class="meta-row">
      <MetaPill label={record.specification_state} tone="review" />
      <MetaPill label={record.cohort_id} />
      <MetaPill label={envelope?.envelope_state ?? "Missing envelope"} />
      <MetaPill label="0 observations" tone="review" />
      <MetaPill label="0 series points" tone="review" />
    </div>
  </section>

  <section class="page-section">
    <div class="status-panel">
      <article class="status-item"><h2>Numerator</h2><p>{record.numerator_contract}</p></article>
      <article class="status-item"><h2>Denominator</h2><p>{record.denominator_contract}</p></article>
      <article class="status-item"><h2>Scope</h2><p>{record.scope_contract}</p></article>
    </div>
  </section>

  <section class="page-section">
    <div class="grid">
      <article class="record-card"><h2>Unit contract</h2><p>{record.unit_contract}</p></article>
      <article class="record-card"><h2>Period contract</h2><p>{record.period_contract}</p></article>
      <article class="record-card"><h2>Method contract</h2><p>{record.method_contract}</p></article>
      <article class="record-card"><h2>Exceptions</h2><p>{record.exception_contract}</p></article>
      <article class="record-card"><h2>Acceptance and recurrence</h2><p>{record.acceptance_and_recurrence_contract}</p></article>
      <article class="record-card"><h2>Exact next artifact</h2><p>{record.exact_next_artifact}</p></article>
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Intake Contract</div><h2>Eighteen fields before human review.</h2></div></div>
    <div class="source-list">
      {registry.required_observation_fields.map((field) => (
        <article class="source-row">
          <h3>{field.field_name}</h3>
          <p>{field.requirement}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="grid">
      <article class="record-card">
        <h2>Empty envelope</h2>
        <ul>
          <li>ID: {envelope?.envelope_id}</li>
          <li>Artifact: none</li>
          <li>Observation payload: none</li>
          <li>Receipt: none</li>
          <li>Decision: none</li>
          <li>Propagation: not started</li>
        </ul>
      </article>
      <article class="record-card">
        <h2>Entity-specific break rules</h2>
        <ul>{record.entity_specific_break_rules.map((item: string) => <li>{item}</li>)}</ul>
      </article>
      <article class="record-card">
        <h2>Break register</h2>
        <p>{breakRegister?.register_state}. No actual break, bridge, or admitted series is recorded.</p>
        <p>{breakRegister?.bridge_requirement}</p>
      </article>
      <article class="record-card">
        <h2>Phase 70 review docket</h2>
        <p><a href={`/evidence/review/${reviewDocket?.slug}/`}>{reviewDocket?.review_docket_id}</a>: {reviewDocket?.docket_state}.</p>
        <p>Twelve human review decisions, two independent reviewers, receipt binding, revision lineage, and propagation remain empty.</p>
      </article>
    </div>
  </section>

  <section class="page-section">
    <div class="grid">
      <article class="record-card">
        <h2>Connected briefings</h2>
        <ul>{[record.canonical_briefing_id, record.qualification_playbook_id, "briefing-measurement-dictionary-001", "briefing-series-break-adjudication-001"].map((id: string) => {
          const briefing = briefingById.get(id);
          return <li>{briefing ? <a href={`/briefings/${briefing.data.slug}/`}>{briefing.data.title}</a> : id}</li>;
        })}</ul>
      </article>
      <article class="record-card">
        <h2>Connected maps</h2>
        <ul>{record.dependency_map_ids.map((id: string) => {
          const map = mapById.get(id);
          return <li>{map ? <a href={`/atlas/dependency-maps/${map.data.slug}/`}>{map.data.title}</a> : id}</li>;
        })}</ul>
      </article>
      <article class="record-card">
        <h2>Connected evidence</h2>
        <ul>
          {record.source_ids.map((id: string) => {
            const source = sourceById.get(id);
            return <li>{source ? <a href={`/atlas/sources/${source.data.id}/`}>{source.data.name}</a> : id}</li>;
          })}
          {record.signal_ids.map((id: string) => {
            const signal = signalById.get(id);
            return <li>{signal ? <a href={`/signals/${signal.data.slug}/`}>{signal.data.title}</a> : id}</li>;
          })}
        </ul>
      </article>
    </div>
  </section>

  <section class="page-section briefing-band">
    <div class="briefing-band__copy">
      <div class="eyebrow">Boundary</div>
      <h2>A specification is not an observation.</h2>
      <p>No value, period, receipt, break event, series point, cohort admission, score, comparison, or outcome is recorded on this page.</p>
    </div>
  </section>
</BaseLayout>
