---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-92-fiscal-policy-public-revenue-sovereign-debt-trade-external-balance-macroeconomic-coordination-registry.json";
import phase91 from "../../../data/phase-91-finance-banking-credit-capital-allocation-monetary-systems-financial-stability-registry.json";
import phase93 from "../../../data/phase-93-economic-development-industrial-strategy-innovation-systems-regional-convergence-productive-transformation-registry.json";

export function getStaticPaths() {
  return [
    ...registry.public_revenue_tax_expenditure_distribution_compliance_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "revenue", record } })),
    ...registry.budget_expenditure_stabilizer_delivery_public_value_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "budget", record } })),
    ...registry.sovereign_debt_fiscal_rule_public_balance_sheet_resilience_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "debt", record } })),
    ...registry.trade_external_balance_supply_resilience_macroeconomic_coordination_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "macro", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "revenue" | "budget" | "debt" | "macro"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-fiscal-policy-public-revenue-sovereign-debt-trade-macroeconomic-coordination-doctrine-001", "briefing-taxation-revenue-capacity-incidence-distribution-001", "briefing-tax-administration-compliance-enforcement-taxpayer-rights-001", "briefing-tax-expenditures-subsidies-credits-public-accountability-001", "briefing-budgets-appropriations-expenditure-delivery-public-value-001", "briefing-automatic-stabilizers-social-insurance-countercyclical-capacity-001", "briefing-fiscal-federalism-local-revenue-intergovernmental-transfers-001", "briefing-sovereign-debt-issuance-service-maturity-currency-risk-001", "briefing-fiscal-rules-public-balance-sheets-contingent-liabilities-001", "briefing-debt-restructuring-default-resolution-intergenerational-fairness-001", "briefing-trade-tariffs-customs-industrial-policy-supply-resilience-001", "briefing-external-balance-capital-account-exchange-macro-coordination-001"];
const mapIds = ["dependency-map-revenue-capacity-is-not-distributive-justice", "dependency-map-expenditure-authorization-is-not-delivered-public-value", "dependency-map-deficit-size-is-not-fiscal-sustainability", "dependency-map-sovereign-borrowing-is-not-productive-public-investment", "dependency-map-export-growth-is-not-resilient-development", "dependency-map-aggregate-stabilization-is-not-democratic-macroeconomic-legitimacy"];
const state = kind === "revenue" ? record.revenue_state : kind === "budget" ? record.budget_state : kind === "debt" ? record.debt_state : record.macro_state;
const id = kind === "revenue" ? record.public_revenue_tax_expenditure_distribution_compliance_dossier_id : kind === "budget" ? record.budget_expenditure_stabilizer_delivery_public_value_ledger_id : kind === "debt" ? record.sovereign_debt_fiscal_rule_public_balance_sheet_resilience_register_id : record.trade_external_balance_supply_resilience_macroeconomic_coordination_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase91Record = phase91.monetary_policy_systemic_risk_resolution_public_guarantee_democratic_finance_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase93Records = [
  ...phase93.economic_development_mission_sector_strategy_production_ecosystem_dossiers,
  ...phase93.innovation_research_diffusion_commercialization_standards_ledgers,
  ...phase93.regional_cluster_corridor_supplier_workforce_convergence_registers,
  ...phase93.productive_transformation_diversification_decarbonization_shared_prosperity_ledgers
].filter((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  revenue: { label: "Public Revenue, Tax Expenditure, Distribution And Compliance Dossier", gates: record.revenue_checks, gateCount: 20, groups: [["Public-revenue and tax-instrument classes", record.public_revenue_tax_instrument_class_records, "class_state"], ["Revenue-incidence, compliance, and administration dimensions", record.revenue_incidence_compliance_administration_dimension_records, "dimension_state"], ["Taxpayer-rights, transparency, and distribution safeguards", record.taxpayer_rights_transparency_distribution_safeguard_records, "safeguard_state"]], decision: record.revenue_decision },
  budget: { label: "Budget, Expenditure, Stabilizer, Delivery And Public-Value Ledger", gates: record.budget_checks, gateCount: 20, groups: [["Budget expenditure and delivery classes", record.budget_expenditure_delivery_class_records, "class_state"], ["Budget, stabilizer, and delivery dimensions", record.budget_stabilizer_delivery_dimension_records, "dimension_state"], ["Budget and public-value safeguards", record.budget_public_value_safeguard_records, "safeguard_state"]], decision: record.budget_decision },
  debt: { label: "Sovereign Debt, Fiscal Rule, Public Balance Sheet And Resilience Register", gates: record.debt_checks, gateCount: 22, groups: [["Sovereign obligation and financing classes", record.sovereign_obligation_financing_class_records, "class_state"], ["Debt, fiscal-rule, and public-balance-sheet dimensions", record.debt_fiscal_rule_balance_sheet_dimension_records, "dimension_state"], ["Debt-resilience, restructuring, and intergenerational safeguards", record.debt_resilience_restructuring_intergenerational_safeguard_records, "safeguard_state"]], decision: record.debt_decision },
  macro: { label: "Trade, External Balance, Supply Resilience And Macroeconomic-Coordination Ledger", gates: record.macro_checks, gateCount: 24, groups: [["Trade and external-account instrument classes", record.trade_external_account_instrument_class_records, "class_state"], ["Trade, supply, external-balance, and macro dimensions", record.trade_supply_external_balance_macro_dimension_records, "dimension_state"], ["Trade-adjustment, distribution, and due-process safeguards", record.trade_adjustment_distribution_due_process_safeguard_records, "safeguard_state"], ["Long-horizon macroeconomic capacity tests", record.long_horizon_macroeconomic_capacity_test_records, "test_state"]], decision: record.macro_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 92 fiscal-policy, public-revenue, sovereign-debt, trade, external-balance, and macroeconomic-coordination contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 fiscal or macro decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 91 democratic-finance ledger</h2><p>{phase91Record ? <a href={'/evidence/finance-banking-credit-financial-stability/' + phase91Record.slug + '/'}>{phase91Record.monetary_policy_systemic_risk_resolution_public_guarantee_democratic_finance_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 tax, revenue, distribution, budget, appropriation, procurement, expenditure-delivery, debt, restructuring, customs, trade, treaty, supply-resilience, macroeconomic-policy, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 93 Destination</div><h2>Carry fiscal and macroeconomic coordination into productive development.</h2></div><a class="inline-link" href="/evidence/economic-development-industrial-strategy-productive-transformation/">Open the Phase 93 registry</a></div><div class="grid">{phase93Records.map((item) => <article class="record-card"><h3><a href={'/evidence/economic-development-industrial-strategy-productive-transformation/' + item.slug + '/'}>{item.named_entity}</a></h3><p>{item.record_kind.replaceAll('_', ' ')}</p></article>)}</div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Revenue is not justice; aggregate stabilization is not democratic legitimacy.</h2><p>No tax, revenue, distribution, budget, delivery, debt, restructuring, customs, trade, treaty, supply, macroeconomic, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
