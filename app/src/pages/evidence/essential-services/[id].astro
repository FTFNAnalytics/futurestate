---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-81-universal-service-essential-systems-public-option-delivery-registry.json";
import phase80 from "../../../data/phase-80-public-investment-portfolios-transition-pathways-place-based-capacity-registry.json";

export function getStaticPaths() {
  return [
    ...registry.service_floor_universal_access_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "floor", record } })),
    ...registry.affordability_cross_subsidy_coverage_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "affordability", record } })),
    ...registry.provider_plurality_interoperability_continuity_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "provider", record } })),
    ...registry.rights_quality_step_in_restoration_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "restoration", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "floor" | "affordability" | "provider" | "restoration"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-universal-service-doctrine-001", "briefing-essential-service-floors-001", "briefing-eligibility-access-nondiscrimination-001", "briefing-affordability-cross-subsidy-001", "briefing-coverage-capacity-access-001", "briefing-public-options-provider-plurality-001", "briefing-interoperability-open-standards-data-portability-001", "briefing-accessibility-user-rights-remedy-001", "briefing-continuity-mutual-aid-essential-systems-001", "briefing-service-quality-reliability-state-good-repair-001", "briefing-provider-failure-step-in-public-option-001", "briefing-emergency-rationing-restoration-long-horizon-accountability-001"];
const mapIds = ["dependency-map-infrastructure-coverage-is-not-service-access", "dependency-map-low-average-price-is-not-affordability", "dependency-map-provider-presence-is-not-universal-service", "dependency-map-technical-interface-is-not-interoperability-rights", "dependency-map-average-uptime-is-not-universal-quality", "dependency-map-emergency-rationing-is-not-permanent-service-reduction"];
const state = kind === "floor" ? record.service_floor_state : kind === "affordability" ? record.affordability_state : kind === "provider" ? record.provider_state : record.restoration_state;
const id = kind === "floor" ? record.service_floor_universal_access_dossier_id : kind === "affordability" ? record.affordability_cross_subsidy_coverage_ledger_id : kind === "provider" ? record.provider_plurality_interoperability_continuity_register_id : record.rights_quality_step_in_restoration_ledger_id;
const title = `${id}: ${record.named_entity}`;
const sourceIds: string[] = record.source_ids;
const signalIds: string[] = record.signal_ids;
const phase80Record = phase80.portfolio_stress_rebalancing_realization_ledgers.find((item) => item.cohort_id === record.cohort_id);
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 81 universal-service and essential-systems contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{kind === "floor" ? "Service Floor And Universal Access Dossier" : kind === "affordability" ? "Affordability, Cross-Subsidy And Coverage Ledger" : kind === "provider" ? "Provider Plurality, Interoperability And Continuity Register" : "Rights, Quality, Step-In And Restoration Ledger"}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 service decisions" tone="review" /><MetaPill label="0 provider decisions" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>

  {kind === "floor" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 80 realization ledger</h2><p>{phase80Record ? <a href={'/evidence/investment-portfolios/' + phase80Record.slug + '/'}>{record.portfolio_stress_rebalancing_realization_ledger_id}</a> : record.portfolio_stress_rebalancing_realization_ledger_id}</p></article><article class="status-item"><h2>Adoption decision</h2><p>{record.adoption_decision}</p></article><article class="status-item"><h2>Service floors</h2><p>0 classifications, floors, or eligibility duties</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Service Floor</div><h2>Twenty gates remain Inactive.</h2></div></div><div class="source-list">{record.service_floor_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Essential Services And Dimensions</div><h2>Fourteen service classes remain Unassigned; fourteen floor dimensions remain Not Defined.</h2></div></div><div class="grid">{record.essential_service_class_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, classification, or decision exists.</p><MetaPill label={item.classification_state} tone="review" /></article>)}{record.service_floor_dimension_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No standard, threshold, evidence, or review exists.</p><MetaPill label={item.floor_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Eligibility And Access</div><h2>Twelve access duties remain Unassigned.</h2></div></div><div class="grid">{record.eligibility_access_duty_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No eligible public, owner, accommodation, remedy, or receipt exists.</p><MetaPill label={item.duty_state} tone="review" /></article>)}</div></section></>}

  {kind === "affordability" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Service-floor dossier</h2><p>{record.service_floor_universal_access_dossier_id}</p></article><article class="status-item"><h2>Affordability decision</h2><p>{record.affordability_decision}</p></article><article class="status-item"><h2>Findings</h2><p>0 tariffs, subsidies, coverage, access, or quality findings</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Affordability And Coverage</div><h2>Twenty gates remain Inactive.</h2></div></div><div class="source-list">{record.affordability_coverage_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Protections And Subsidies</div><h2>Twelve affordability protections and twelve cross-subsidy mechanisms remain Unassessed.</h2></div></div><div class="grid">{record.affordability_protection_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, funding, beneficiary, or protection finding exists.</p><MetaPill label={item.protection_state} tone="review" /></article>)}{record.cross_subsidy_mechanism_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No contributor, beneficiary, allocation, incidence, or decision exists.</p><MetaPill label={item.mechanism_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Coverage And Access</div><h2>Twelve coverage dimensions remain Not Measured.</h2></div></div><div class="grid">{record.coverage_access_dimension_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No geography, population, observation, quality, or finding exists.</p><MetaPill label={item.measurement_state} tone="review" /></article>)}</div></section></>}

  {kind === "provider" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Affordability ledger</h2><p>{record.affordability_cross_subsidy_coverage_ledger_id}</p></article><article class="status-item"><h2>Provider decision</h2><p>{record.provider_decision}</p></article><article class="status-item"><h2>Findings</h2><p>0 provider, standard, interoperability, continuity, or exercise findings</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Providers And Continuity</div><h2>Twenty-two gates remain Inactive.</h2></div></div><div class="source-list">{record.provider_continuity_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Operating Models And Interoperability</div><h2>Twelve provider models remain Unassessed; fourteen interoperability requirements remain Unverified.</h2></div></div><div class="grid">{record.provider_operating_model_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No provider, authority, duty, funding, or decision exists.</p><MetaPill label={item.model_state} tone="review" /></article>)}{record.interoperability_requirement_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No standard, conformance, exception, migration, or receipt exists.</p><MetaPill label={item.requirement_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Continuity And Mutual Aid</div><h2>Twelve continuity capabilities remain Untested.</h2></div></div><div class="grid">{record.continuity_mutual_aid_capability_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No owner, capacity, exercise, correction, or receipt exists.</p><MetaPill label={item.capability_state} tone="review" /></article>)}</div></section></>}

  {kind === "restoration" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Provider register</h2><p>{record.provider_plurality_interoperability_continuity_register_id}</p></article><article class="status-item"><h2>Intervention decision</h2><p>{record.intervention_decision}</p></article><article class="status-item"><h2>Results</h2><p>0 rights, quality, failure, intervention, emergency, restoration, or remedy findings</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Rights And Restoration</div><h2>Twenty-two gates remain Inactive.</h2></div></div><div class="source-list">{record.rights_restoration_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Rights And Quality</div><h2>Fourteen rights remain Unadopted; fourteen quality measures remain Not Measured.</h2></div></div><div class="grid">{record.user_right_remedy_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No charter, authority, complaint, appeal, remedy, or receipt exists.</p><MetaPill label={item.right_state} tone="review" /></article>)}{record.service_quality_reliability_measure_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No standard, observation, disaggregation, or finding exists.</p><MetaPill label={item.measure_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Failure, Step-In And Restoration</div><h2>Twelve failure triggers remain Dormant; twelve restoration duties remain Unassigned.</h2></div></div><div class="grid">{record.provider_failure_step_in_trigger_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No event, review, intervention, decision, or receipt exists.</p><MetaPill label={item.trigger_state} tone="review" /></article>)}{record.emergency_rationing_restoration_duty_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No priority, owner, rationing, restoration, remedy, or receipt exists.</p><MetaPill label={item.duty_state} tone="review" /></article>)}</div></section></>}

  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const briefing = briefingById.get(guideId); return <li>{briefing ? <a href={'/briefings/' + briefing.data.slug + '/'}>{briefing.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const map = mapById.get(mapId); return <li>{map ? <a href={'/atlas/dependency-maps/' + map.data.slug + '/'}>{map.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{sourceIds.map((sourceId) => { const source = sourceById.get(sourceId); return <li>{source ? <a href={'/atlas/sources/' + source.data.id + '/'}>{source.data.name}</a> : sourceId}</li>; })}{signalIds.map((signalId) => { const signal = signalById.get(signalId); return <li>{signal ? <a href={'/signals/' + signal.data.slug + '/'}>{signal.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Infrastructure coverage is not service access, and emergency rationing is not permanent authority.</h2><p>No verified Phase 80 realization chain, essential-service classification, floor, eligibility rule, access or affordability finding, tariff, subsidy, cross-subsidy, coverage finding, provider or open-standard authorization, continuity finding, rights charter, quality finding, failure trigger, step-in decision, rationing rule, restoration priority, remedy, reviewer identity, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 82 Destination</div><h2>Follow essential-system delivery into household capability.</h2></div></div><article class="record-card"><p>Phase 82 keeps household capability, care capacity, affordability and administrative burden, neighborhood access, displacement, crisis stabilization, and recovery separate from upstream service availability.</p><a class="inline-link" href="/evidence/household-capability/">Open the household capability registry</a></article></section>
</BaseLayout>
