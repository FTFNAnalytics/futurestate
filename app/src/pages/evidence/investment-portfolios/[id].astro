---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-80-public-investment-portfolios-transition-pathways-place-based-capacity-registry.json";
import phase79 from "../../../data/phase-79-public-wealth-long-horizon-stewardship-intergenerational-balance-sheet-registry.json";

export function getStaticPaths() {
  return [
    ...registry.public_investment_mission_thesis_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "thesis", record } })),
    ...registry.portfolio_membership_dependency_sequence_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "portfolio", record } })),
    ...registry.place_based_delivery_capacity_transition_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "capacity", record } })),
    ...registry.portfolio_stress_rebalancing_realization_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "realization", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "thesis" | "portfolio" | "capacity" | "realization"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-public-investment-doctrine-001", "briefing-mission-thesis-public-purpose-001", "briefing-portfolio-construction-without-ranking-001", "briefing-dependency-capital-sequencing-001", "briefing-public-funding-versus-financing-001", "briefing-delivery-institutions-owner-capacity-001", "briefing-workforce-supplier-readiness-001", "briefing-land-water-energy-infrastructure-constraints-001", "briefing-place-based-value-just-transition-001", "briefing-option-preservation-stage-gates-offramps-001", "briefing-portfolio-stress-rebalancing-concentration-001", "briefing-public-value-realization-transition-accountability-001"];
const mapIds = ["dependency-map-project-list-is-not-investment-portfolio", "dependency-map-funding-is-not-financing-capacity", "dependency-map-earliest-ready-is-not-highest-public-priority", "dependency-map-procurement-capacity-is-not-delivery-capacity", "dependency-map-local-expenditure-is-not-just-transition", "dependency-map-delivered-output-is-not-realized-public-value"];
const state = kind === "thesis" ? record.thesis_state : kind === "portfolio" ? record.portfolio_state : kind === "capacity" ? record.delivery_state : record.realization_state;
const id = kind === "thesis" ? record.public_investment_mission_thesis_dossier_id : kind === "portfolio" ? record.portfolio_membership_dependency_sequence_register_id : kind === "capacity" ? record.place_based_delivery_capacity_transition_ledger_id : record.portfolio_stress_rebalancing_realization_ledger_id;
const title = `${id}: ${record.named_entity}`;
const sourceIds: string[] = record.source_ids;
const signalIds: string[] = record.signal_ids;
const phase79Record = phase79.intergenerational_balance_sheet_stewardship_ledgers.find((item) => item.cohort_id === record.cohort_id);
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 80 public-investment portfolio and transition contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{kind === "thesis" ? "Public Investment Mission And Thesis Dossier" : kind === "portfolio" ? "Portfolio Membership, Dependency And Sequence Register" : kind === "capacity" ? "Place-Based Delivery Capacity And Just-Transition Ledger" : "Portfolio Stress, Rebalancing And Realization Ledger"}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 portfolio decisions" tone="review" /><MetaPill label="0 funding decisions" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>

  {kind === "thesis" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 79 stewardship ledger</h2><p>{phase79Record ? <a href={'/evidence/stewardship/' + phase79Record.slug + '/'}>{record.intergenerational_balance_sheet_stewardship_ledger_id}</a> : record.intergenerational_balance_sheet_stewardship_ledger_id}</p></article><article class="status-item"><h2>Admission decision</h2><p>{record.admission_decision}</p></article><article class="status-item"><h2>Investment theses</h2><p>0 missions, theses, or instruments</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Mission And Thesis</div><h2>Eighteen gates remain Inactive.</h2></div></div><div class="source-list">{record.investment_thesis_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Mission Classes</div><h2>Twelve mission classes remain Unassigned.</h2></div></div><div class="grid">{record.mission_class_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No evidence, authority, mission, or decision record exists.</p><MetaPill label={item.mission_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Investment Instruments</div><h2>Twelve instrument classes remain Unassessed.</h2></div></div><div class="grid">{record.instrument_class_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No funding, financing, exposure, affordability, or authority finding exists.</p><MetaPill label={item.instrument_state} tone="review" /></article>)}</div></section></>}

  {kind === "portfolio" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Investment thesis</h2><p>{record.public_investment_mission_thesis_dossier_id}</p></article><article class="status-item"><h2>Membership decision</h2><p>{record.membership_decision}</p></article><article class="status-item"><h2>Portfolio members</h2><p>0 admitted, sequenced, or funded members</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Portfolio And Sequence</div><h2>Twenty gates remain Inactive.</h2></div></div><div class="source-list">{record.portfolio_sequence_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Dependencies</div><h2>Twelve dependency classes remain Unmapped.</h2></div></div><div class="grid">{record.dependency_class_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No predecessor, successor, critical-path, evidence, or mitigation record exists.</p><MetaPill label={item.dependency_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Sequence</div><h2>Twelve sequence stages remain Unscheduled.</h2></div></div><div class="grid">{record.sequence_stage_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No member, entry gate, exit gate, decision, or receipt exists.</p><MetaPill label={item.stage_state} tone="review" /></article>)}</div></section></>}

  {kind === "capacity" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Portfolio register</h2><p>{record.portfolio_membership_dependency_sequence_register_id}</p></article><article class="status-item"><h2>Readiness decision</h2><p>{record.readiness_decision}</p></article><article class="status-item"><h2>Findings</h2><p>0 capacity, workforce, supplier, resource, or transition findings</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Capacity And Transition</div><h2>Twenty gates remain Inactive.</h2></div></div><div class="source-list">{record.delivery_transition_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Delivery Capacity</div><h2>Fourteen capacity dimensions remain Untested.</h2></div></div><div class="grid">{record.delivery_capacity_dimension_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No baseline, gap, owner, remedy, or readiness finding exists.</p><MetaPill label={item.capacity_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Workforce, Place And Transition</div><h2>Twelve readiness dimensions remain Unverified; twelve place obligations remain Unassigned; twelve safeguards remain Unverified.</h2></div></div><div class="grid">{record.workforce_supplier_readiness_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No workforce, supplier, evidence, or decision record exists.</p><MetaPill label={item.readiness_state} tone="review" /></article>)}{record.place_based_obligation_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No place, owner, burden, benefit, or remedy record exists.</p><MetaPill label={item.obligation_state} tone="review" /></article>)}{record.just_transition_safeguard_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No affected-public, funding, enforcement, or receipt record exists.</p><MetaPill label={item.safeguard_state} tone="review" /></article>)}</div></section></>}

  {kind === "realization" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Capacity ledger</h2><p>{record.place_based_delivery_capacity_transition_ledger_id}</p></article><article class="status-item"><h2>Rebalancing decision</h2><p>{record.rebalancing_decision}</p></article><article class="status-item"><h2>Results</h2><p>0 stress, rebalancing, output, outcome, or realization findings</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Stress And Realization</div><h2>Twenty gates remain Inactive.</h2></div></div><div class="source-list">{record.realization_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Stress And Rebalancing</div><h2>Twelve stress triggers remain Dormant; ten rebalancing actions remain Not Considered.</h2></div></div><div class="grid">{record.portfolio_stress_trigger_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No event, review, decision, consequence, or receipt exists.</p><MetaPill label={item.trigger_state} tone="review" /></article>)}{record.rebalancing_action_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No member, condition, authority, decision, or correction record exists.</p><MetaPill label={item.action_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Public-Value Realization</div><h2>Twelve realization tests remain Not Tested.</h2></div></div><div class="grid">{record.public_value_realization_test_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No verified output, observed outcome, contribution finding, harm, or remedy exists.</p><MetaPill label={item.test_state} tone="review" /></article>)}</div></section></>}

  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const briefing = briefingById.get(guideId); return <li>{briefing ? <a href={'/briefings/' + briefing.data.slug + '/'}>{briefing.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const map = mapById.get(mapId); return <li>{map ? <a href={'/atlas/dependency-maps/' + map.data.slug + '/'}>{map.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{sourceIds.map((sourceId) => { const source = sourceById.get(sourceId); return <li>{source ? <a href={'/atlas/sources/' + source.data.id + '/'}>{source.data.name}</a> : sourceId}</li>; })}{signalIds.map((signalId) => { const signal = signalById.get(signalId); return <li>{signal ? <a href={'/signals/' + signal.data.slug + '/'}>{signal.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>A project list is not an investment portfolio, and delivery is not realized public value.</h2><p>No verified Phase 79 stewardship chain, mission, investment thesis, member, priority, dependency decision, sequence, funding, financing, capacity finding, workforce or supplier finding, resource allocation, place-based obligation, just-transition safeguard, stress test, off-ramp, rebalancing, output, realization finding, reviewer identity, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
  <section class="page-section"><article class="record-card"><div class="eyebrow">Phase 81 Destination</div><h2>Universal service and essential-system delivery remain downstream.</h2><p>Only a verified Phase 80 chain with an admitted thesis, authorized portfolio, lawful funding and financing, verified capacity and transition duties, completed stress and off-ramp tests, realized public-value finding, independent review, and receipts can open the matching Phase 81 service-floor dossier.</p><a class="inline-link" href="/evidence/essential-services/">Inspect the inactive Phase 81 registry</a></article></section>
</BaseLayout>
