---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-85-housing-shelter-land-use-place-stability-registry.json";
import phase84 from "../../../data/phase-84-food-systems-local-provisioning-community-resource-security-registry.json";
import phase86 from "../../../data/phase-86-health-public-health-disability-population-wellbeing-registry.json";

export function getStaticPaths() {
  return [
    ...registry.housing_need_supply_delivery_habitability_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "delivery", record } })),
    ...registry.tenure_affordability_public_social_community_housing_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "tenure", record } })),
    ...registry.homelessness_shelter_supportive_housing_displacement_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "stability", record } })),
    ...registry.retrofit_climate_disaster_reconstruction_place_stability_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "place", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "delivery" | "tenure" | "stability" | "place"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-housing-place-stability-doctrine-001", "briefing-housing-need-supply-delivery-001", "briefing-land-use-infrastructure-housing-delivery-001", "briefing-housing-habitability-accessibility-quality-001", "briefing-tenure-renter-homeowner-security-001", "briefing-public-social-cooperative-community-housing-001", "briefing-housing-affordability-cost-burden-001", "briefing-homelessness-shelter-supportive-housing-001", "briefing-indigenous-land-housing-rights-001", "briefing-retrofit-repair-decarbonization-001", "briefing-climate-disaster-housing-relocation-001", "briefing-reconstruction-right-to-return-place-stability-001"];
const mapIds = ["dependency-map-approved-units-are-not-delivered-homes", "dependency-map-shelter-bed-is-not-stable-housing", "dependency-map-affordability-label-is-not-household-affordability", "dependency-map-retrofit-spending-is-not-safe-habitable-housing", "dependency-map-temporary-relocation-is-not-right-to-return", "dependency-map-reconstruction-is-not-community-recovery"];
const state = kind === "delivery" ? record.delivery_state : kind === "tenure" ? record.tenure_state : kind === "stability" ? record.stability_state : record.place_state;
const id = kind === "delivery" ? record.housing_need_supply_delivery_habitability_dossier_id : kind === "tenure" ? record.tenure_affordability_public_social_community_housing_ledger_id : kind === "stability" ? record.homelessness_shelter_supportive_housing_displacement_register_id : record.retrofit_climate_disaster_reconstruction_place_stability_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase84Record = phase84.reserve_contamination_circularity_community_resource_security_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase86Records = [
  ...phase86.primary_preventive_community_care_access_dossiers,
  ...phase86.acute_emergency_specialty_behavioral_health_care_ledgers,
  ...phase86.public_health_surveillance_prevention_environmental_exposure_registers,
  ...phase86.disability_equity_preparedness_population_wellbeing_ledgers
].filter((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  delivery: { label: "Housing Need, Supply, Delivery And Habitability Dossier", gates: record.delivery_checks, gateCount: 20, groups: [["Housing-supply and delivery types", record.housing_supply_delivery_type_records, "delivery_state"], ["Habitability, accessibility, and quality dimensions", record.habitability_accessibility_quality_dimension_records, "dimension_state"], ["Land-use, infrastructure, and delivery safeguards", record.land_use_infrastructure_delivery_safeguard_records, "safeguard_state"]], decision: record.delivery_decision },
  tenure: { label: "Tenure, Affordability, Public, Social And Community-Housing Ledger", gates: record.tenure_checks, gateCount: 20, groups: [["Housing-tenure and provider models", record.housing_tenure_provider_model_records, "model_state"], ["Household-housing affordability dimensions", record.household_housing_affordability_dimension_records, "dimension_state"], ["Public, social, and community-housing safeguards", record.public_social_community_housing_safeguard_records, "safeguard_state"]], decision: record.tenure_decision },
  stability: { label: "Homelessness, Shelter, Supportive-Housing And Displacement Register", gates: record.stability_checks, gateCount: 22, groups: [["Homelessness, shelter, and supportive-housing pathways", record.homelessness_shelter_supportive_housing_pathway_records, "pathway_state"], ["Housing-stability and displacement-protection dimensions", record.housing_stability_displacement_protection_dimension_records, "dimension_state"], ["Supportive-housing service and dignity safeguards", record.supportive_housing_service_dignity_safeguard_records, "safeguard_state"]], decision: record.stability_decision },
  place: { label: "Retrofit, Climate, Disaster, Reconstruction And Place-Stability Ledger", gates: record.place_checks, gateCount: 22, groups: [["Retrofit, repair, and decarbonization capabilities", record.retrofit_repair_decarbonization_capability_records, "capability_state"], ["Climate and disaster-housing safeguards", record.climate_disaster_housing_safeguard_records, "safeguard_state"], ["Relocation, reconstruction, and right-to-return safeguards", record.relocation_reconstruction_right_to_return_safeguard_records, "safeguard_state"], ["Long-horizon place-stability tests", record.long_horizon_place_stability_test_records, "test_state"]], decision: record.place_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 85 housing and place-stability contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 housing decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 84 resource-security ledger</h2><p>{phase84Record ? <a href={'/evidence/food-systems/' + phase84Record.slug + '/'}>{record.reserve_contamination_circularity_community_resource_security_ledger_id ?? phase84Record.reserve_contamination_circularity_community_resource_security_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 approvals, allocations, placements, findings, remedies, receipts, scores, rankings, or stage changes</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, owner, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 86 Destination</div><h2>Health and population-wellbeing controls remain inactive.</h2></div><a class="inline-link" href="/evidence/health-population-wellbeing/">Open the Phase 86 registry</a></div><div class="grid">{phase86Records.map((item) => <article class="record-card"><h3><a href={'/evidence/health-population-wellbeing/' + item.slug + '/'}>{Object.values(item).find((value) => typeof value === "string" && /^86-(PCA|AHL|PHR|DWL)-/.test(value))}</a></h3><p>Capacity, coverage, encounters, signals, declarations, and reopening do not establish health or population-wellbeing outcomes.</p></article>)}</div></section>
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Approvals are not homes; reconstruction is not community recovery.</h2><p>No housing allocation, delivered-home or occupancy finding, habitability or accessibility conclusion, tenure or affordability finding, shelter or supportive-housing placement, stability or displacement decision, retrofit result, relocation order, right-to-return finding, reconstruction or community-recovery conclusion, reviewer identity, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
