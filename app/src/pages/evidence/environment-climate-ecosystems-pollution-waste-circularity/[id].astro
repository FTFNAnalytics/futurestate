---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-97-environment-climate-ecosystems-pollution-waste-circularity-planetary-system-stewardship-registry.json";
import phase96 from "../../../data/phase-96-mobility-transportation-freight-communications-digital-networks-territorial-access-registry.json";
import phase98 from "../../../data/phase-98-law-justice-public-safety-emergency-management-security-defense-peace-registry.json";

export function getStaticPaths() {
  return [
    ...registry.greenhouse_gas_emissions_climate_mitigation_decarbonization_transition_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "climate", record } })),
    ...registry.air_water_soil_noise_chemical_pollution_exposure_environmental_justice_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "pollution", record } })),
    ...registry.ecosystems_biodiversity_habitat_land_freshwater_ocean_restoration_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "ecosystem", record } })),
    ...registry.waste_materials_circularity_climate_adaptation_disaster_risk_planetary_system_stewardship_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "planetary", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "climate" | "pollution" | "ecosystem" | "planetary"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-environment-climate-ecosystems-pollution-waste-circularity-planetary-stewardship-doctrine-001", "briefing-greenhouse-gas-inventories-carbon-budgets-targets-delivered-decarbonization-001", "briefing-energy-transport-buildings-industry-land-use-climate-mitigation-001", "briefing-climate-adaptation-vulnerability-resilience-loss-and-damage-001", "briefing-air-quality-noise-toxic-exposure-environmental-health-001", "briefing-water-soil-chemical-pollution-remediation-environmental-justice-001", "briefing-ecosystems-biodiversity-habitat-connectivity-species-recovery-001", "briefing-forests-wetlands-freshwater-oceans-coasts-cryosphere-001", "briefing-waste-prevention-reuse-repair-recycling-circularity-001", "briefing-materials-product-stewardship-epr-ewaste-hazardous-waste-001", "briefing-indigenous-stewardship-environmental-rights-just-transition-001", "briefing-planetary-boundaries-monitoring-restoration-long-horizon-001"];
const mapIds = ["dependency-map-emissions-target-is-not-delivered-decarbonization", "dependency-map-permit-limit-is-not-healthy-exposure", "dependency-map-protected-area-designation-is-not-ecosystem-recovery", "dependency-map-waste-diversion-is-not-circular-material-stewardship", "dependency-map-adaptation-spending-is-not-reduced-climate-vulnerability", "dependency-map-restored-infrastructure-is-not-restored-community-or-ecosystem"];
const state = kind === "climate" ? record.climate_state : kind === "pollution" ? record.pollution_state : kind === "ecosystem" ? record.ecosystem_state : record.planetary_state;
const id = kind === "climate" ? record.greenhouse_gas_emissions_climate_mitigation_decarbonization_transition_dossier_id : kind === "pollution" ? record.air_water_soil_noise_chemical_pollution_exposure_environmental_justice_ledger_id : kind === "ecosystem" ? record.ecosystems_biodiversity_habitat_land_freshwater_ocean_restoration_register_id : record.waste_materials_circularity_climate_adaptation_disaster_risk_planetary_system_stewardship_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase96Record = phase96.communications_broadband_mobile_digital_public_infrastructure_interoperability_territorial_access_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase98Records = [
  phase98.rights_rule_of_law_courts_legal_aid_access_to_justice_dossiers.find((item) => item.cohort_id === record.cohort_id),
  phase98.public_safety_violence_prevention_policing_fire_corrections_accountability_ledgers.find((item) => item.cohort_id === record.cohort_id),
  phase98.emergency_management_civil_protection_critical_system_security_resilience_registers.find((item) => item.cohort_id === record.cohort_id),
  phase98.defense_intelligence_conflict_prevention_civilian_protection_peace_stewardship_ledgers.find((item) => item.cohort_id === record.cohort_id)
].filter(Boolean);
const configs: Record<string, any> = {
  climate: { label: "Greenhouse-Gas Emissions, Climate Mitigation, Decarbonization And Transition Dossier", gates: record.climate_checks, gateCount: 20, groups: [["Climate-transition classes", record.climate_transition_class_records, "class_state"], ["Climate-mitigation dimensions", record.climate_mitigation_dimension_records, "dimension_state"], ["Climate-justice safeguards", record.climate_justice_safeguard_records, "safeguard_state"]], decision: record.climate_decision },
  pollution: { label: "Air, Water, Soil, Noise, Chemical Pollution, Exposure And Environmental-Justice Ledger", gates: record.pollution_checks, gateCount: 22, groups: [["Pollution and exposure classes", record.pollution_exposure_class_records, "class_state"], ["Pollution-exposure dimensions", record.pollution_exposure_dimension_records, "dimension_state"], ["Environmental-justice safeguards", record.environmental_justice_safeguard_records, "safeguard_state"]], decision: record.pollution_decision },
  ecosystem: { label: "Ecosystems, Biodiversity, Habitat, Land, Freshwater, Ocean And Restoration Register", gates: record.ecosystem_checks, gateCount: 22, groups: [["Ecosystem classes", record.ecosystem_class_records, "class_state"], ["Ecosystem-integrity dimensions", record.ecosystem_integrity_dimension_records, "dimension_state"], ["Biodiversity-rights safeguards", record.biodiversity_rights_safeguard_records, "safeguard_state"]], decision: record.ecosystem_decision },
  planetary: { label: "Waste, Materials, Circularity, Climate Adaptation, Disaster Risk And Planetary-System Stewardship Ledger", gates: record.planetary_checks, gateCount: 24, groups: [["Circularity and stewardship classes", record.circularity_stewardship_class_records, "class_state"], ["Planetary-stewardship dimensions", record.planetary_stewardship_dimension_records, "dimension_state"], ["Planetary-governance safeguards", record.planetary_governance_safeguard_records, "safeguard_state"], ["Long-horizon planetary tests", record.long_horizon_planetary_test_records, "test_state"]], decision: record.planetary_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 97 environment, climate, ecosystem, pollution, circularity, adaptation, and planetary-stewardship contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 environmental decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 96 territorial-access ledger</h2><p>{phase96Record ? <a href={'/evidence/mobility-transportation-freight-communications-digital-networks/' + phase96Record.slug + '/'}>{phase96Record.communications_broadband_mobile_digital_public_infrastructure_interoperability_territorial_access_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 emissions, mitigation, exposure, health, compliance, remediation, ecosystem, biodiversity, restoration, waste, circularity, adaptation, vulnerability, recovery, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 98 Destination</div><h2>Justice, safety, security and peace contracts remain separate.</h2></div></div><div class="grid">{phase98Records.map((item: any) => { const nextId = item.rights_rule_of_law_courts_legal_aid_access_to_justice_dossier_id ?? item.public_safety_violence_prevention_policing_fire_corrections_accountability_ledger_id ?? item.emergency_management_civil_protection_critical_system_security_resilience_register_id ?? item.defense_intelligence_conflict_prevention_civilian_protection_peace_stewardship_ledger_id; return <article class="record-card"><h3><a href={'/evidence/law-justice-public-safety-emergency-security-defense-peace/' + item.slug + '/'}>{nextId}</a></h3><p>{/^98-(JAD|SAL|EMR|DPL)-/.test(nextId) ? "Inactive Phase 98 destination; no justice or security outcome is inferred from environmental stewardship." : "Unverified destination identity."}</p></article>; })}</div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>An emissions target is not delivered decarbonization; protected-area designation is not ecosystem recovery.</h2><p>No inventory, target, permit, exposure, health, designation, species, restoration, waste, circularity, adaptation, recovery, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
