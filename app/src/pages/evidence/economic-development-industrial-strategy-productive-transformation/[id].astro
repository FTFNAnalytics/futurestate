---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-93-economic-development-industrial-strategy-innovation-systems-regional-convergence-productive-transformation-registry.json";
import phase92 from "../../../data/phase-92-fiscal-policy-public-revenue-sovereign-debt-trade-external-balance-macroeconomic-coordination-registry.json";
import phase94 from "../../../data/phase-94-energy-materials-manufacturing-logistics-strategic-supply-chain-transformation-registry.json";

export function getStaticPaths() {
  return [
    ...registry.economic_development_mission_sector_strategy_production_ecosystem_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "strategy", record } })),
    ...registry.innovation_research_diffusion_commercialization_standards_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "innovation", record } })),
    ...registry.regional_cluster_corridor_supplier_workforce_convergence_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "region", record } })),
    ...registry.productive_transformation_diversification_decarbonization_shared_prosperity_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "transformation", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "strategy" | "innovation" | "region" | "transformation"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-economic-development-industrial-strategy-innovation-regional-convergence-productive-transformation-doctrine-001", "briefing-missions-sector-strategies-policy-coherence-001", "briefing-production-ecosystems-inputs-infrastructure-coordination-001", "briefing-industrial-policy-instruments-subsidies-conditions-additionality-001", "briefing-research-development-demonstration-commercialization-001", "briefing-technology-diffusion-extension-standards-interoperability-001", "briefing-development-finance-public-procurement-market-shaping-001", "briefing-supplier-development-small-enterprise-cooperatives-domestic-value-001", "briefing-clusters-corridors-regional-innovation-local-governance-001", "briefing-workforce-skills-job-quality-just-transition-001", "briefing-diversification-decarbonization-resilience-productive-upgrading-001", "briefing-regional-convergence-shared-prosperity-long-horizon-transformation-001"];
const mapIds = ["dependency-map-subsidy-volume-is-not-additional-productive-capacity", "dependency-map-firm-attraction-is-not-rooted-regional-development", "dependency-map-patent-count-is-not-innovation-diffusion", "dependency-map-export-complexity-is-not-shared-prosperity", "dependency-map-infrastructure-spending-is-not-executable-production-ecosystem", "dependency-map-output-growth-is-not-just-productive-transformation"];
const state = kind === "strategy" ? record.strategy_state : kind === "innovation" ? record.innovation_state : kind === "region" ? record.region_state : record.transformation_state;
const id = kind === "strategy" ? record.economic_development_mission_sector_strategy_production_ecosystem_dossier_id : kind === "innovation" ? record.innovation_research_diffusion_commercialization_standards_ledger_id : kind === "region" ? record.regional_cluster_corridor_supplier_workforce_convergence_register_id : record.productive_transformation_diversification_decarbonization_shared_prosperity_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase92Record = phase92.trade_external_balance_supply_resilience_macroeconomic_coordination_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase94Records = [
  ...phase94.energy_water_industrial_utility_reliability_dossiers,
  ...phase94.minerals_materials_processing_circularity_qualification_ledgers,
  ...phase94.manufacturing_equipment_automation_maintenance_quality_accepted_production_registers,
  ...phase94.logistics_inventory_strategic_reserves_emergency_conversion_supply_chain_resilience_ledgers
].filter((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  strategy: { label: "Economic Development Mission, Sector Strategy And Production-Ecosystem Dossier", gates: record.strategy_checks, gateCount: 20, groups: [["Development mission and sector-strategy classes", record.development_mission_sector_strategy_class_records, "class_state"], ["Production-ecosystem readiness dimensions", record.production_ecosystem_readiness_dimension_records, "dimension_state"], ["Industrial-strategy additionality and governance safeguards", record.industrial_strategy_additionality_governance_safeguard_records, "safeguard_state"]], decision: record.strategy_decision },
  innovation: { label: "Innovation, Research, Diffusion, Commercialization And Standards Ledger", gates: record.innovation_checks, gateCount: 20, groups: [["Innovation, research, and transfer pathways", record.innovation_research_transfer_pathway_records, "pathway_state"], ["Innovation-diffusion and commercialization dimensions", record.innovation_diffusion_commercialization_dimension_records, "dimension_state"], ["Innovation-access and public-return safeguards", record.innovation_access_public_return_safeguard_records, "safeguard_state"]], decision: record.innovation_decision },
  region: { label: "Regional Cluster, Corridor, Supplier, Workforce And Convergence Register", gates: record.region_checks, gateCount: 22, groups: [["Regional cluster and corridor network classes", record.regional_cluster_corridor_network_class_records, "class_state"], ["Regional supplier, workforce, and infrastructure dimensions", record.regional_supplier_workforce_infrastructure_dimension_records, "dimension_state"], ["Regional-equity, convergence, and anchoring safeguards", record.regional_equity_convergence_anchoring_safeguard_records, "safeguard_state"]], decision: record.region_decision },
  transformation: { label: "Productive Transformation, Diversification, Decarbonization And Shared-Prosperity Ledger", gates: record.transformation_checks, gateCount: 24, groups: [["Productive-transformation strategy classes", record.productive_transformation_strategy_class_records, "class_state"], ["Productive-capability and distribution dimensions", record.productive_capability_distribution_dimension_records, "dimension_state"], ["Productive-transformation democratic safeguards", record.productive_transformation_democratic_safeguard_records, "safeguard_state"], ["Long-horizon productive-transformation tests", record.long_horizon_productive_transformation_test_records, "test_state"]], decision: record.transformation_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 93 economic-development, industrial-strategy, innovation, regional-convergence, and productive-transformation contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 development decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 92 macroeconomic-coordination ledger</h2><p>{phase92Record ? <a href={'/evidence/fiscal-revenue-debt-trade-macro-coordination/' + phase92Record.slug + '/'}>{phase92Record.trade_external_balance_supply_resilience_macroeconomic_coordination_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 mission, sector, firm, subsidy, procurement, innovation, readiness, standard, commercialization, adoption, cluster, supplier, workforce, convergence, productivity, transformation, shared-prosperity, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 94 Destination</div><h2>Energy, materials, manufacturing, logistics, and strategic supply-chain controls.</h2></div></div><div class="grid">{phase94Records.map((item: any) => { const itemId = item.energy_water_industrial_utility_reliability_dossier_id ?? item.minerals_materials_processing_circularity_qualification_ledger_id ?? item.manufacturing_equipment_automation_maintenance_quality_accepted_production_register_id ?? item.logistics_inventory_strategic_reserves_emergency_conversion_supply_chain_resilience_ledger_id; return <article class="record-card"><h3><a href={'/evidence/energy-materials-manufacturing-supply-chains/' + item.slug + '/'}>{itemId}</a></h3><p>Inactive until the complete Phase 93 chain is independently verified, human-reviewed, and receipted.</p></article>; })}</div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Subsidies are not productive capacity; output growth is not just transformation.</h2><p>No mission, sector, firm, subsidy, procurement, innovation, standard, cluster, supplier, workforce, convergence, productivity, transformation, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
