---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-96-mobility-transportation-freight-communications-digital-networks-territorial-access-registry.json";
import phase95 from "../../../data/phase-95-infrastructure-construction-buildings-public-works-territorial-systems-delivery-registry.json";
import phase97 from "../../../data/phase-97-environment-climate-ecosystems-pollution-waste-circularity-planetary-system-stewardship-registry.json";

export function getStaticPaths() {
  return [
    ...registry.passenger_mobility_demand_accessibility_affordability_inclusion_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "mobility", record } })),
    ...registry.multimodal_transportation_service_planning_operations_safety_reliability_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "service", record } })),
    ...registry.freight_goods_movement_intermodal_logistics_delivery_resilience_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "freight", record } })),
    ...registry.communications_broadband_mobile_digital_public_infrastructure_interoperability_territorial_access_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "digital", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "mobility" | "service" | "freight" | "digital"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-mobility-transportation-freight-communications-digital-networks-territorial-access-doctrine-001", "briefing-travel-demand-accessibility-proximity-complete-trips-001", "briefing-walking-cycling-wheelchair-micromobility-public-realm-001", "briefing-roads-streets-traffic-safety-vision-zero-001", "briefing-public-transit-rail-schedules-fares-service-quality-001", "briefing-aviation-maritime-ports-intercity-rural-remote-mobility-001", "briefing-freight-intermodal-terminals-last-mile-reliable-delivery-001", "briefing-transport-labor-operations-maintenance-state-of-good-repair-001", "briefing-communications-broadband-mobile-satellite-universal-connectivity-001", "briefing-digital-public-infrastructure-interoperability-data-rights-cybersecurity-001", "briefing-emergency-continuity-evacuation-restoration-community-recovery-001", "briefing-territorial-access-affordability-equity-indigenous-mobility-long-horizon-001"];
const mapIds = ["dependency-map-infrastructure-availability-is-not-usable-access", "dependency-map-scheduled-service-is-not-completed-trip", "dependency-map-vehicle-throughput-is-not-safe-mobility", "dependency-map-freight-movement-is-not-reliable-delivery", "dependency-map-network-coverage-is-not-affordable-reliable-connectivity", "dependency-map-restored-route-is-not-community-recovery"];
const state = kind === "mobility" ? record.mobility_state : kind === "service" ? record.service_state : kind === "freight" ? record.freight_state : record.digital_state;
const id = kind === "mobility" ? record.passenger_mobility_demand_accessibility_affordability_inclusion_dossier_id : kind === "service" ? record.multimodal_transportation_service_planning_operations_safety_reliability_ledger_id : kind === "freight" ? record.freight_goods_movement_intermodal_logistics_delivery_resilience_register_id : record.communications_broadband_mobile_digital_public_infrastructure_interoperability_territorial_access_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase95Record = phase95.commissioning_accessibility_asset_handover_operations_maintenance_adaptation_reconstruction_territorial_value_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase97Records = [
  phase97.greenhouse_gas_emissions_climate_mitigation_decarbonization_transition_dossiers.find((item) => item.cohort_id === record.cohort_id),
  phase97.air_water_soil_noise_chemical_pollution_exposure_environmental_justice_ledgers.find((item) => item.cohort_id === record.cohort_id),
  phase97.ecosystems_biodiversity_habitat_land_freshwater_ocean_restoration_registers.find((item) => item.cohort_id === record.cohort_id),
  phase97.waste_materials_circularity_climate_adaptation_disaster_risk_planetary_system_stewardship_ledgers.find((item) => item.cohort_id === record.cohort_id)
].filter(Boolean);
const configs: Record<string, any> = {
  mobility: { label: "Passenger Mobility Demand, Accessibility, Affordability And Inclusion Dossier", gates: record.mobility_checks, gateCount: 20, groups: [["Mobility-demand and access classes", record.mobility_demand_access_class_records, "class_state"], ["Mobility-access dimensions", record.mobility_access_dimension_records, "dimension_state"], ["Mobility-rights safeguards", record.mobility_rights_safeguard_records, "safeguard_state"]], decision: record.mobility_decision },
  service: { label: "Multimodal Transportation Service Planning, Operations, Safety And Reliability Ledger", gates: record.service_checks, gateCount: 22, groups: [["Transportation-service network classes", record.transportation_service_network_class_records, "class_state"], ["Transportation-service dimensions", record.transportation_service_dimension_records, "dimension_state"], ["Transportation-governance safeguards", record.transportation_governance_safeguard_records, "safeguard_state"]], decision: record.service_decision },
  freight: { label: "Freight, Goods Movement, Intermodal Logistics And Delivery-Resilience Register", gates: record.freight_checks, gateCount: 22, groups: [["Freight-network classes", record.freight_network_class_records, "class_state"], ["Freight-delivery resilience dimensions", record.freight_delivery_resilience_dimension_records, "dimension_state"], ["Freight public-value safeguards", record.freight_public_value_safeguard_records, "safeguard_state"]], decision: record.freight_decision },
  digital: { label: "Communications, Broadband, Mobile, Digital Public Infrastructure, Interoperability And Territorial-Access Ledger", gates: record.digital_checks, gateCount: 24, groups: [["Digital-network classes", record.digital_network_class_records, "class_state"], ["Digital-access dimensions", record.digital_access_dimension_records, "dimension_state"], ["Digital-rights safeguards", record.digital_rights_safeguard_records, "safeguard_state"], ["Long-horizon territorial-access tests", record.long_horizon_access_test_records, "test_state"]], decision: record.digital_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 96 mobility, transportation, freight, communications, digital-network, and territorial-access contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 mobility or access decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 95 commissioned territorial-system ledger</h2><p>{phase95Record ? <a href={'/evidence/infrastructure-construction-buildings-public-works-territorial-systems/' + phase95Record.slug + '/'}>{phase95Record.commissioning_accessibility_asset_handover_operations_maintenance_adaptation_reconstruction_territorial_value_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 trip, access, affordability, safety, service, reliability, freight, delivery, connectivity, interoperability, restoration, recovery, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 97 Destination</div><h2>Environmental and planetary-system stewardship contracts remain separate.</h2></div></div><div class="grid">{phase97Records.map((item: any) => { const nextId = item.greenhouse_gas_emissions_climate_mitigation_decarbonization_transition_dossier_id ?? item.air_water_soil_noise_chemical_pollution_exposure_environmental_justice_ledger_id ?? item.ecosystems_biodiversity_habitat_land_freshwater_ocean_restoration_register_id ?? item.waste_materials_circularity_climate_adaptation_disaster_risk_planetary_system_stewardship_ledger_id; return <article class="record-card"><h3><a href={'/evidence/environment-climate-ecosystems-pollution-waste-circularity/' + item.slug + '/'}>{nextId}</a></h3><p>{/^97-(CMD|PEL|EBR|PSL)-/.test(nextId) ? "Inactive Phase 97 destination; no environmental outcome is inferred from network access." : "Unverified destination identity."}</p></article>; })}</div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Infrastructure availability is not usable access; network coverage is not affordable reliable connectivity.</h2><p>No trip, route, schedule, fare, safety, freight, delivery, coverage, interoperability, restoration, recovery, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
