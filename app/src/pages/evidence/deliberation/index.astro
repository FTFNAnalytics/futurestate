---
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-77-public-deliberation-participatory-governance-adaptive-mandate-registry.json";

const standing = registry.stakeholder_standing_notice_registers;
const deliberation = registry.deliberation_issue_response_dockets;
const mandates = registry.mandate_legitimacy_appeal_registers;
const adaptive = registry.adaptive_mandate_review_ledgers;
---

<BaseLayout title="Public Deliberation And Adaptive Mandate | FTFN" description="Eight inactive standing registers, eight deliberation dockets, eight mandate and appeal registers, and eight adaptive-review ledgers.">
  <section class="page-section hero" data-deliberation-registry><div class="hero__copy"><div class="eyebrow">FTFN / Participatory Governance</div><h1 class="page-title">Participation is not consent, legitimacy, or permanent authorization.</h1><p class="lede">Phase 77 separates affected-public standing, notice, accessibility, consultation, consent, public comment, hearings, issue response, dissent, appeal, legitimacy audit, public mandate, monitoring, reopening, amendment, sunset, and retirement.</p><div class="meta-row"><MetaPill label="8 inactive standing registers" tone="possibility" /><MetaPill label="8 inactive deliberation dockets" /><MetaPill label="8 inactive mandate registers" /><MetaPill label="8 inactive adaptive ledgers" /><MetaPill label="0 participation records" tone="review" /></div></div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Standing And Notice</div><h2>Eight affected-public records remain closed.</h2></div><a class="inline-link" href="/briefings/community-standing-affected-publics-001/">Read the standing method</a></div><div class="grid">{standing.map((record) => <article class="record-card"><div class="meta-row"><MetaPill label={record.standing_state} tone="review" /><MetaPill label={record.cohort_id} /></div><h3><a href={'/evidence/deliberation/' + record.slug + '/'}>{record.named_entity}</a></h3><p>Sixteen gates and twelve constituency classes preserve rights, exposure, notice, accessibility, support, privacy, challenge, and independent review.</p></article>)}</div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Deliberation And Public Reason</div><h2>Eight issue-and-response dockets contain no submissions.</h2></div><a class="inline-link" href="/briefings/public-reason-issue-response-001/">Read the public-reason method</a></div><div class="grid">{deliberation.map((record) => <article class="record-card"><div class="meta-row"><MetaPill label={record.deliberation_state} tone="review" /><MetaPill label="12 issue classes" /></div><h3><a href={'/evidence/deliberation/' + record.slug + '/'}>{record.deliberation_issue_response_docket_id}: {record.named_entity}</a></h3><p>Comments, hearings, consultation, consent boundaries, evidence, alternatives, material issues, responses, dissent, and quality findings remain empty.</p></article>)}</div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Mandate And Appeal</div><h2>Eight legitimacy and appeal registers remain inactive.</h2></div><a class="inline-link" href="/briefings/dissent-appeal-reconsideration-001/">Read the appeal method</a></div><div class="source-list">{mandates.map((record) => <article class="source-row"><div><h3><a href={'/evidence/deliberation/' + record.slug + '/'}>{record.mandate_legitimacy_appeal_register_id}: {record.named_entity}</a></h3><p>Authority, procedure, standing, access, rights, reasons, distribution, proportionality, dissent, appeal, duration, and receipt remain unassessed.</p></div><MetaPill label={record.mandate_decision} tone="review" /></article>)}</div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Adaptive Mandate</div><h2>Eight monitoring and reopening ledgers contain no mandate.</h2></div><a class="inline-link" href="/briefings/adaptive-democratic-mandate-001/">Read the adaptive-mandate method</a></div><div class="grid">{adaptive.map((record) => <article class="record-card"><h3><a href={'/evidence/deliberation/' + record.slug + '/'}>{record.adaptive_mandate_review_ledger_id}: {record.named_entity}</a></h3><p>Fourteen review gates and twelve time, performance, harm, context, authority, challenge, and future-user triggers remain inactive.</p><MetaPill label={record.adaptive_state} tone="review" /></article>)}</div></section>

  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Public Contract</div><h2>Inspect the empty participation and mandate state.</h2><p>The export publishes standing, notice, accessibility, consultation, comment, hearing, response, quality, appeal, mandate, and adaptive-review controls. It contains no participation, consent, legitimacy, authorization, receipt, score, rank, or stage change.</p></div><article class="record-card"><a class="inline-link" href="/data/public-deliberation-adaptive-mandate.json">Deliberation and mandate JSON</a></article></section>
</BaseLayout>
