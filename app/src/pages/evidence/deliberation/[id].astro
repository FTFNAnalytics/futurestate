---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-77-public-deliberation-participatory-governance-adaptive-mandate-registry.json";

export function getStaticPaths() {
  return [
    ...registry.stakeholder_standing_notice_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "standing", record } })),
    ...registry.deliberation_issue_response_dockets.map((record) => ({ params: { id: record.slug }, props: { kind: "deliberation", record } })),
    ...registry.mandate_legitimacy_appeal_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "mandate", record } })),
    ...registry.adaptive_mandate_review_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "adaptive", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "standing" | "deliberation" | "mandate" | "adaptive"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-community-standing-affected-publics-001", "briefing-indigenous-treaty-consultation-boundaries-001", "briefing-worker-supply-chain-voice-001", "briefing-accessibility-service-user-participation-001", "briefing-environmental-justice-cumulative-burden-deliberation-001", "briefing-technical-expert-public-knowledge-001", "briefing-public-reason-issue-response-001", "briefing-dissent-appeal-reconsideration-001", "briefing-intergenerational-future-user-review-001", "briefing-adaptive-democratic-mandate-001"];
const mapIds = ["dependency-map-notice-is-not-accessible-participation", "dependency-map-participation-volume-is-not-consent-or-legitimacy", "dependency-map-comment-count-is-not-reasoned-response", "dependency-map-mandate-is-not-permanent-authorization"];
const state = kind === "standing" ? record.standing_state : kind === "deliberation" ? record.deliberation_state : kind === "mandate" ? record.mandate_state : record.adaptive_state;
const id = kind === "standing" ? record.stakeholder_standing_notice_register_id : kind === "deliberation" ? record.deliberation_issue_response_docket_id : kind === "mandate" ? record.mandate_legitimacy_appeal_register_id : record.adaptive_mandate_review_ledger_id;
const title = `${id}: ${record.named_entity}`;
const sourceIds: string[] = record.source_ids;
const signalIds: string[] = record.signal_ids;
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 77 public-deliberation and adaptive-mandate contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{kind === "standing" ? "Stakeholder Standing And Notice Register" : kind === "deliberation" ? "Deliberation Issue And Response Docket" : kind === "mandate" ? "Mandate Legitimacy And Appeal Register" : "Adaptive Mandate Review Ledger"}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 participation" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>

  {kind === "standing" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 76 learning</h2><p><a href={'/evidence/learning/' + record.institutional_learning_dossier_id.toLowerCase() + '-' + record.slug.replace(/^77-ssr-\d+-/, '') + '/'}>{record.institutional_learning_dossier_id}</a>: {record.phase76_learning_state}</p></article><article class="status-item"><h2>Portfolio assignments</h2><p>{record.phase76_portfolio_governance_register_ids.length} inactive portfolios</p></article><article class="status-item"><h2>Opening decision</h2><p>{record.opening_decision}</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Standing And Notice</div><h2>Sixteen gates remain Inactive.</h2></div></div><div class="source-list">{record.standing_notice_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Affected Publics</div><h2>Twelve constituency classes remain Unassessed.</h2></div></div><div class="grid">{record.constituency_standing_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No claimant, exposure, rights, representation, challenge, or standing evidence exists.</p><MetaPill label={item.standing_state} tone="review" /></article>)}</div></section></>}

  {kind === "deliberation" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Standing register</h2><p>{record.stakeholder_standing_notice_register_id}</p></article><article class="status-item"><h2>Process decision</h2><p>{record.process_decision}</p></article><article class="status-item"><h2>Submissions</h2><p>0 comments, hearings, or consultation records</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Deliberation</div><h2>Eighteen gates remain Inactive.</h2></div></div><div class="source-list">{record.deliberation_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Issue Matrix</div><h2>Twelve issue classes remain Unopened.</h2></div></div><div class="grid">{record.issue_matrix_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No submission, evidence, materiality decision, response, or dissent exists.</p><MetaPill label={item.issue_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Participation Quality</div><h2>Twelve dimensions remain Not Measured.</h2></div></div><div class="grid">{record.participation_quality_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No descriptive finding, evidence, score, rank, or legitimacy inference exists.</p><MetaPill label={item.measurement_state} tone="review" /></article>)}</div></section></>}

  {kind === "mandate" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Response docket</h2><p>{record.deliberation_issue_response_docket_id}</p></article><article class="status-item"><h2>Mandate decision</h2><p>{record.mandate_decision}</p></article><article class="status-item"><h2>Appeals</h2><p>0 appeals, stays, or remedies</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Legitimacy And Mandate</div><h2>Sixteen gates remain Inactive.</h2></div></div><div class="source-list">{record.mandate_legitimacy_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Appeal</div><h2>Ten appeal grounds remain Unavailable.</h2></div></div><div class="grid">{record.appeal_ground_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No filing, decision, stay, reconsideration, or remedy exists.</p><MetaPill label={item.ground_state} tone="review" /></article>)}</div></section></>}

  {kind === "adaptive" && <><section class="page-section"><div class="status-panel"><article class="status-item"><h2>Mandate register</h2><p>{record.mandate_legitimacy_appeal_register_id}</p></article><article class="status-item"><h2>Review decision</h2><p>{record.review_decision}</p></article><article class="status-item"><h2>Mandate</h2><p>None authorized</p></article></div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Adaptive Review</div><h2>Fourteen gates remain Inactive.</h2></div></div><div class="source-list">{record.adaptive_review_checks.map((item: any) => <article class="source-row"><h3>{item.label}</h3><p>{item.basis}</p><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section><section class="page-section"><div class="section-heading"><div><div class="eyebrow">Reopening Triggers</div><h2>Twelve trigger classes remain Dormant.</h2></div></div><div class="grid">{record.adaptive_trigger_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No event, threshold decision, reopening, mandate change, or receipt exists.</p><MetaPill label={item.trigger_state} tone="review" /></article>)}</div></section></>}

  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const briefing = briefingById.get(guideId); return <li>{briefing ? <a href={'/briefings/' + briefing.data.slug + '/'}>{briefing.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const map = mapById.get(mapId); return <li>{map ? <a href={'/atlas/dependency-maps/' + map.data.slug + '/'}>{map.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{sourceIds.map((sourceId) => { const source = sourceById.get(sourceId); return <li>{source ? <a href={'/atlas/sources/' + source.data.id + '/'}>{source.data.name}</a> : sourceId}</li>; })}{signalIds.map((signalId) => { const signal = signalById.get(signalId); return <li>{signal ? <a href={'/signals/' + signal.data.slug + '/'}>{signal.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>Participation does not establish consent, legitimacy, authorization, or permanence.</h2><p>No admitted cross-case finding, standing decision, notice, accessibility finding, public comment, hearing, consultation, consent finding, reasoned response, participation-quality finding, legitimacy audit, appeal, mandate, adaptive review, reviewer identity, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
  <section class="page-section"><article class="record-card"><div class="eyebrow">Phase 78 Destination</div><h2>Interjurisdictional compacts remain downstream.</h2><p>Jurisdiction, treaties, externalities, shared public value, contributions, mutual aid, disputes, emergency authority, civil safeguards, restoration, and reauthorization remain inactive until Phase 77 produces a real, time-bounded public mandate with a complete record and receipt.</p><a class="inline-link" href="/evidence/compacts/">Open the Interjurisdictional Compacts Registry</a></article></section>
</BaseLayout>
