---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-74-evidence-synthesis-challenge-decision-translation-registry.json";
import accountabilityRegistry from "../../../data/phase-75-decision-accountability-realized-impact-registry.json";

export function getStaticPaths() {
  return [
    ...registry.result_synthesis_input_dockets.map((record) => ({ params: { id: record.slug }, props: { record, kind: "input" } })),
    ...registry.synthesis_contradiction_dossiers.map((record) => ({ params: { id: record.slug }, props: { record, kind: "synthesis" } }))
  ];
}

const { record, kind } = Astro.props as { record: any; kind: "input" | "synthesis" };
const isInput = kind === "input";
const inputs = isInput ? [] : registry.result_synthesis_input_dockets.filter((item) => item.cohort_id === record.cohort_id);
const challenge = isInput
  ? registry.external_challenge_response_dockets.find((item) => item.external_challenge_response_docket_id === record.external_challenge_response_docket_id)
  : registry.external_challenge_response_dockets.find((item) => item.external_challenge_response_docket_id === record.external_challenge_response_docket_id);
const translation = isInput
  ? registry.decision_translation_reevaluation_registers.find((item) => item.decision_translation_reevaluation_register_id === record.decision_translation_reevaluation_register_id)
  : registry.decision_translation_reevaluation_registers.find((item) => item.decision_translation_reevaluation_register_id === record.decision_translation_reevaluation_register_id);
const accountabilityDecision = accountabilityRegistry.decision_accountability_dossiers.find((item) => item.cohort_id === record.cohort_id);
const accountabilityLedgers = accountabilityRegistry.implementation_commitment_realization_ledgers.filter((item) => isInput ? item.result_synthesis_input_docket_id === record.result_synthesis_input_docket_id : item.cohort_id === record.cohort_id);
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item])); const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item])); const signalById = new Map(signals.map((item) => [item.data.id, item])); const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const title = isInput ? `${record.result_synthesis_input_docket_id}: ${record.measure_label}` : `${record.synthesis_contradiction_dossier_id}: ${record.named_entity}`;
---

<BaseLayout title={`${title} | FTFN`} description={isInput ? `${record.named_entity}: inactive synthesis-input docket with fourteen eligibility gates.` : `${record.named_entity}: inactive synthesis, contradiction, challenge, translation, and reevaluation dossier.`} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{isInput ? "Result Synthesis Input" : "Synthesis And Decision Dossier"}</div><h1 class="page-title">{title}</h1><p class="lede">{record.named_entity}</p><div class="meta-row"><MetaPill label={isInput ? record.input_state : record.synthesis_state} tone="review" /><MetaPill label={record.cohort_id} /><MetaPill label="0 syntheses" tone="review" /><MetaPill label="0 evidence grades" tone="review" /><MetaPill label="0 recommendations" tone="review" /></div></section>

  {isInput ? (
    <>
      <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 73 execution</h2><p><a href={`/evidence/analysis/${record.analysis_execution_docket_slug}/`}>{record.analysis_execution_docket_id}</a></p></article><article class="status-item"><h2>Phase 73 adjudication</h2><p><a href={`/evidence/analysis/${record.result_adjudication_docket_slug}/`}>{record.result_adjudication_docket_id}</a>: {record.phase73_adjudication_state}</p></article><article class="status-item"><h2>Input decision</h2><p>{record.input_decision}</p></article></div></section>
      <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Synthesis Eligibility</div><h2>Fourteen result-input gates remain Inactive.</h2></div></div><div class="source-list">{record.eligibility_checks.map((check: any) => <article class="source-row"><h3>{check.label}</h3><p>{check.basis}</p><MetaPill label={check.decision_state} tone="review" /></article>)}</div></section>
      <section class="page-section"><div class="grid"><article class="record-card"><h2>Result lineage</h2><ul><li>Adjudicated result: none</li><li>Adjudication receipt: none</li><li>Public result: none</li><li>Result version: none</li><li>Correction status: none</li></ul></article><article class="record-card"><h2>Evidence content</h2><ul><li>Claim class: none</li><li>Exact claim: none</li><li>Effect record: none</li><li>Uncertainty: none</li><li>Design class: none</li></ul></article><article class="record-card"><h2>Eligibility decision</h2><ul><li>Shared dependencies: 0</li><li>Replications: 0</li><li>Adverse or null results: 0</li><li>Evidence grade: none</li><li>Receipt: none</li></ul></article></div></section>
    </>
  ) : (
    <>
      <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 73 result layer</h2><p><a href={`/evidence/analysis/${record.result_adjudication_docket_slug}/`}>{record.result_adjudication_docket_id}</a>: no adjudicated result</p></article><article class="status-item"><h2>External challenge</h2><p>{challenge?.external_challenge_response_docket_id}: {challenge?.challenge_decision}</p></article><article class="status-item"><h2>Decision translation</h2><p>{translation?.decision_translation_reevaluation_register_id}: {translation?.translation_decision}</p></article></div></section>
      <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Body-Level Synthesis</div><h2>Fourteen synthesis gates remain Inactive.</h2></div></div><div class="source-list">{record.synthesis_checks.map((check: any) => <article class="source-row"><h3>{check.label}</h3><p>{check.basis}</p><MetaPill label={check.decision_state} tone="review" /></article>)}</div></section>
      <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Contradiction Register</div><h2>Ten contradiction categories remain Not Assessable.</h2></div></div><div class="grid">{record.contradiction_register.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No detection decision, affected result, materiality, resolution, dissent, or receipt exists.</p><MetaPill label={item.record_state} tone="review" /></article>)}</div></section>
      <section class="page-section"><div class="section-heading"><div><div class="eyebrow">External Challenge</div><h2>Twelve challenge gates remain Inactive.</h2></div></div><div class="source-list">{challenge?.challenge_checks.map((check: any) => <article class="source-row"><h3>{check.label}</h3><p>{check.basis}</p><MetaPill label={check.decision_state} tone="review" /></article>)}</div></section>
      <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Decision Translation</div><h2>Fourteen translation gates remain Inactive.</h2></div></div><div class="source-list">{translation?.translation_checks.map((check: any) => <article class="source-row"><h3>{check.label}</h3><p>{check.basis}</p><MetaPill label={check.decision_state} tone="review" /></article>)}</div></section>
      <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Reevaluation</div><h2>Ten reevaluation triggers remain Dormant.</h2></div></div><div class="grid">{translation?.reevaluation_trigger_records.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No trigger event or reevaluation decision exists.</p><MetaPill label={item.trigger_state} tone="review" /></article>)}</div></section>
      <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected inputs</h2><ul>{inputs.map((item) => <li><a href={`/evidence/synthesis/${item.slug}/`}>{item.result_synthesis_input_docket_id}: {item.measure_label}</a></li>)}</ul></article><article class="record-card"><h2>Empty synthesis state</h2><ul><li>Eligible results: 0</li><li>Compatibility records: 0</li><li>Triangulation records: 0</li><li>Evidence grade: none</li><li>Synthesis language: none</li></ul></article><article class="record-card"><h2>Empty decision state</h2><ul><li>Challenge packets: 0</li><li>Decision options: 0</li><li>Recommendation: none</li><li>Sunset: none</li><li>Receipt: none</li></ul></article></div></section>
    </>
  )}

  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected briefings</h2><ul>{[record.canonical_briefing_id, "briefing-evidence-synthesis-desk-001", "briefing-challenge-decision-translation-desk-001"].map((id: string) => { const briefing = briefingById.get(id); return <li>{briefing ? <a href={`/briefings/${briefing.data.slug}/`}>{briefing.data.title}</a> : id}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{["dependency-map-registered-design-is-not-published-result", "dependency-map-adjudicated-result-is-not-decision-recommendation"].map((id: string) => { const map = mapById.get(id); return <li>{map ? <a href={`/atlas/dependency-maps/${map.data.slug}/`}>{map.data.title}</a> : id}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((id: string) => { const source = sourceById.get(id); return <li>{source ? <a href={`/atlas/sources/${source.data.id}/`}>{source.data.name}</a> : id}</li>; })}{record.signal_ids.map((id: string) => { const signal = signalById.get(id); return <li>{signal ? <a href={`/signals/${signal.data.slug}/`}>{signal.data.title}</a> : id}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>{isInput ? "An adjudicated result is not automatically eligible for synthesis." : "A synthesis is not a decision recommendation or authorization."}</h2><p>No adjudicated input, body-level synthesis, evidence grade, contradiction decision, challenge, option, recommendation, authority, reevaluation, reviewer decision, or receipt is recorded on this page.</p></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 75 Destination</div><h2>No recommendation has become an accountable decision or implementation commitment.</h2></div><a class="inline-link" href="/evidence/accountability/">Open the accountability registry</a></div><div class="grid">{accountabilityDecision && <article class="record-card"><h3><a href={"/evidence/accountability/" + accountabilityDecision.slug + "/"}>{accountabilityDecision.decision_accountability_dossier_id}</a></h3><p>{accountabilityDecision.accountability_state}; no authorization or option rationale.</p></article>}{accountabilityLedgers.map((item) => <article class="record-card"><h3><a href={"/evidence/accountability/" + item.slug + "/"}>{item.implementation_commitment_realization_ledger_id}</a></h3><p>{item.measure_label}: {item.commitment_state}</p></article>)}</div></section>
</BaseLayout>
