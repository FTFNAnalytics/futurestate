---
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-98-law-justice-public-safety-emergency-management-security-defense-peace-registry.json";
const justice = registry.rights_rule_of_law_courts_legal_aid_access_to_justice_dossiers;
const safety = registry.public_safety_violence_prevention_policing_fire_corrections_accountability_ledgers;
const emergency = registry.emergency_management_civil_protection_critical_system_security_resilience_registers;
const peace = registry.defense_intelligence_conflict_prevention_civilian_protection_peace_stewardship_ledgers;
---

<BaseLayout title="Law, Justice, Public Safety, Emergency Management, Security, Defense And Peace | FTFN" description="Thirty-two inactive justice, safety, emergency-resilience, and security-peace records.">
  <section class="page-section hero" data-law-justice-safety-emergency-security-peace-registry><div class="hero__copy"><div class="eyebrow">FTFN / Justice, Security And Peace</div><h1 class="page-title">A law on the books is not access to justice, and a ceasefire is not durable peace.</h1><p class="lede">Phase 98 traces rights, courts, legal aid and practical justice; violence prevention, public safety and accountable response; emergency management, civil protection and critical-system resilience; then democratic security, defense, civilian protection, conflict prevention and peace.</p><div class="meta-row"><MetaPill label="8 inactive justice dossiers" tone="possibility" /><MetaPill label="8 inactive safety ledgers" /><MetaPill label="8 inactive emergency registers" /><MetaPill label="8 inactive peace ledgers" /><MetaPill label="0 justice or security decisions" tone="review" /></div></div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Rights, Rule Of Law And Access To Justice</div><h2>Eight justice-access dossiers remain closed.</h2></div><a class="inline-link" href="/briefings/courts-legal-aid-counsel-accessible-process-effective-remedy-001/">Read the justice-access guide</a></div><div class="grid">{justice.map((record) => <article class="record-card"><div class="meta-row"><MetaPill label={record.justice_state} tone="review" /><MetaPill label="20 inactive gates" /></div><h3><a href={'/evidence/law-justice-public-safety-emergency-security-defense-peace/' + record.slug + '/'}>{record.named_entity}</a></h3><p>Rights, standing, notice, counsel, process, judgment, remedy, enforcement, appeal, review and receipts remain empty.</p></article>)}</div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Public Safety, Prevention And Accountability</div><h2>Eight safety ledgers contain no reduced-harm decision.</h2></div><a class="inline-link" href="/briefings/public-safety-violence-prevention-community-health-trust-001/">Read the public-safety guide</a></div><div class="grid">{safety.map((record) => <article class="record-card"><div class="meta-row"><MetaPill label={record.safety_state} tone="review" /><MetaPill label="22 inactive gates" /></div><h3><a href={'/evidence/law-justice-public-safety-emergency-security-defense-peace/' + record.slug + '/'}>{record.public_safety_violence_prevention_policing_fire_corrections_accountability_ledger_id}: {record.named_entity}</a></h3><p>Prevention, calls, response, force, custody, fire protection, survivor support, complaints, accountability and remedy remain unassessed.</p></article>)}</div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Emergency Management, Civil Protection And Critical-System Resilience</div><h2>Eight emergency registers remain inactive.</h2></div><a class="inline-link" href="/briefings/emergency-management-preparedness-warning-evacuation-recovery-001/">Read the emergency-resilience guide</a></div><div class="source-list">{emergency.map((record) => <article class="source-row"><div><h3><a href={'/evidence/law-justice-public-safety-emergency-security-defense-peace/' + record.slug + '/'}>{record.emergency_management_civil_protection_critical_system_security_resilience_register_id}: {record.named_entity}</a></h3><p>Hazards, warnings, evacuation, shelter, essential-service continuity, exercises, emergency powers, loss and recovery remain unassessed.</p></div><MetaPill label={record.emergency_state} tone="review" /></article>)}</div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Security, Defense, Civilian Protection And Durable Peace</div><h2>Eight peace ledgers contain no security or durable-peace decision.</h2></div><a class="inline-link" href="/briefings/conflict-prevention-civilian-protection-ceasefire-peacebuilding-001/">Read the peace-stewardship guide</a></div><div class="grid">{peace.map((record) => <article class="record-card"><h3><a href={'/evidence/law-justice-public-safety-emergency-security-defense-peace/' + record.slug + '/'}>{record.defense_intelligence_conflict_prevention_civilian_protection_peace_stewardship_ledger_id}: {record.named_entity}</a></h3><p>Threats, authority, oversight, readiness, intelligence, civilian harm, diplomacy, ceasefires, agreements, justice and reconciliation remain inactive.</p><MetaPill label={record.peace_state} tone="review" /></article>)}</div></section>

  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Public Contract</div><h2>Inspect the empty justice, safety, security and peace state.</h2><p>The export publishes the complete control surface without treating laws as justice access, police presence as safety, declarations as readiness, capability as protected rights, spending as security, or ceasefires as peace—and without scoring or deciding for a person, community, institution, place, jurisdiction, military, alliance or country.</p></div><article class="record-card"><a class="inline-link" href="/data/law-justice-public-safety-emergency-management-security-defense-peace.json">Law, justice, safety, security and peace JSON</a></article></section>
</BaseLayout>
