---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-98-law-justice-public-safety-emergency-management-security-defense-peace-registry.json";
import phase97 from "../../../data/phase-97-environment-climate-ecosystems-pollution-waste-circularity-planetary-system-stewardship-registry.json";
import phase99 from "../../../data/phase-99-democracy-government-public-administration-civic-information-institutional-legitimacy-registry.json";

export function getStaticPaths() {
  return [
    ...registry.rights_rule_of_law_courts_legal_aid_access_to_justice_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "justice", record } })),
    ...registry.public_safety_violence_prevention_policing_fire_corrections_accountability_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "safety", record } })),
    ...registry.emergency_management_civil_protection_critical_system_security_resilience_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "emergency", record } })),
    ...registry.defense_intelligence_conflict_prevention_civilian_protection_peace_stewardship_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "peace", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "justice" | "safety" | "emergency" | "peace"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-law-justice-public-safety-emergency-security-defense-peace-doctrine-001", "briefing-constitutional-rule-of-law-human-rights-independent-justice-001", "briefing-courts-legal-aid-counsel-accessible-process-effective-remedy-001", "briefing-administrative-environmental-indigenous-restorative-justice-001", "briefing-public-safety-violence-prevention-community-health-trust-001", "briefing-policing-fire-emergency-medical-corrections-accountability-001", "briefing-victim-survivor-rights-crisis-response-restorative-safety-001", "briefing-emergency-management-preparedness-warning-evacuation-recovery-001", "briefing-critical-infrastructure-cyber-physical-security-essential-continuity-001", "briefing-national-security-intelligence-oversight-rights-risk-reduction-001", "briefing-defense-readiness-civilian-control-human-security-public-value-001", "briefing-conflict-prevention-civilian-protection-ceasefire-peacebuilding-001"];
const mapIds = ["dependency-map-law-on-books-is-not-access-to-justice", "dependency-map-police-presence-is-not-public-safety", "dependency-map-emergency-declaration-is-not-preparedness-or-recovery", "dependency-map-security-capability-is-not-protected-rights-or-reduced-risk", "dependency-map-defense-spending-is-not-security", "dependency-map-ceasefire-is-not-durable-peace"];
const state = kind === "justice" ? record.justice_state : kind === "safety" ? record.safety_state : kind === "emergency" ? record.emergency_state : record.peace_state;
const id = kind === "justice" ? record.rights_rule_of_law_courts_legal_aid_access_to_justice_dossier_id : kind === "safety" ? record.public_safety_violence_prevention_policing_fire_corrections_accountability_ledger_id : kind === "emergency" ? record.emergency_management_civil_protection_critical_system_security_resilience_register_id : record.defense_intelligence_conflict_prevention_civilian_protection_peace_stewardship_ledger_id;
const title = `${id}: ${record.named_entity}`;
const phase97Record = phase97.waste_materials_circularity_climate_adaptation_disaster_risk_planetary_system_stewardship_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase99Record = phase99.elections_representation_participation_inclusion_democratic_integrity_dossiers.find((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  justice: { label: "Rights, Rule Of Law, Courts, Legal Aid And Access-To-Justice Dossier", gates: record.justice_checks, gateCount: 20, groups: [["Justice-access classes", record.justice_access_class_records, "class_state"], ["Justice-access dimensions", record.justice_access_dimension_records, "dimension_state"], ["Justice-rights safeguards", record.justice_rights_safeguard_records, "safeguard_state"]], decision: record.justice_decision },
  safety: { label: "Public Safety, Violence Prevention, Policing, Fire, Corrections And Accountability Ledger", gates: record.safety_checks, gateCount: 22, groups: [["Public-safety classes", record.public_safety_class_records, "class_state"], ["Public-safety dimensions", record.public_safety_dimension_records, "dimension_state"], ["Safety-rights safeguards", record.safety_rights_safeguard_records, "safeguard_state"]], decision: record.safety_decision },
  emergency: { label: "Emergency Management, Civil Protection, Critical-System Security And Resilience Register", gates: record.emergency_checks, gateCount: 22, groups: [["Emergency-resilience classes", record.emergency_resilience_class_records, "class_state"], ["Emergency-resilience dimensions", record.emergency_resilience_dimension_records, "dimension_state"], ["Emergency-rights safeguards", record.emergency_rights_safeguard_records, "safeguard_state"]], decision: record.emergency_decision },
  peace: { label: "Defense, Intelligence, Conflict Prevention, Civilian Protection And Peace-Stewardship Ledger", gates: record.peace_checks, gateCount: 24, groups: [["Security and peace classes", record.security_peace_class_records, "class_state"], ["Security and peace dimensions", record.security_peace_dimension_records, "dimension_state"], ["Security and peace safeguards", record.security_peace_safeguard_records, "safeguard_state"], ["Long-horizon peace tests", record.long_horizon_peace_test_records, "test_state"]], decision: record.peace_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 98 law, justice, public-safety, emergency, security, defense, and peace contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 justice or security decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 97 planetary-stewardship ledger</h2><p>{phase97Record ? <a href={'/evidence/environment-climate-ecosystems-pollution-waste-circularity/' + phase97Record.slug + '/'}>{phase97Record.waste_materials_circularity_climate_adaptation_disaster_risk_planetary_system_stewardship_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Phase 99 Destination</h2><p>{phase99Record ? <a href={'/evidence/democracy-government-public-administration-civic-information-institutional-legitimacy/' + phase99Record.slug + '/'}>{phase99Record.elections_representation_participation_inclusion_democratic_integrity_dossier_id}</a> : "No assigned downstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 justice, access, safety, harm reduction, preparedness, recovery, risk reduction, security, defense, civilian protection, peace, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>A law on the books is not access to justice; a ceasefire is not durable peace.</h2><p>No right, standing, hearing, remedy, safety, response, preparedness, recovery, surveillance, readiness, civilian-protection, agreement, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
