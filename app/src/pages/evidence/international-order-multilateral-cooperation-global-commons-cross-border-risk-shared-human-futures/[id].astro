---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-100-international-order-multilateral-cooperation-global-commons-cross-border-risk-shared-human-futures-registry.json";
import phase99 from "../../../data/phase-99-democracy-government-public-administration-civic-information-institutional-legitimacy-registry.json";
import phase101 from "../../../data/phase-101-whole-system-futures-scenario-governance-polycrisis-readiness-civilizational-resilience-future-generations-registry.json";

export function getStaticPaths() {
  return [
    ...registry.international_order_diplomacy_treaties_international_law_peaceful_dispute_resolution_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "order", record } })),
    ...registry.multilateral_institutions_representation_development_cooperation_collective_delivery_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "multilateral", record } })),
    ...registry.migration_displacement_refugee_asylum_humanitarian_protection_shared_responsibility_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "mobility", record } })),
    ...registry.global_commons_transboundary_risk_catastrophic_risk_intergenerational_shared_human_futures_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "futures", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "order" | "multilateral" | "mobility" | "futures"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-international-order-multilateral-cooperation-global-commons-shared-futures-doctrine-001", "briefing-diplomacy-recognition-negotiation-peaceful-dispute-resolution-001", "briefing-treaties-ratification-domestic-implementation-compliance-001", "briefing-multilateral-membership-representation-voice-influence-reform-001", "briefing-development-cooperation-finance-additionality-local-ownership-delivery-001", "briefing-collective-action-coordination-burden-sharing-crisis-capability-001", "briefing-migration-mobility-rights-safe-regular-pathways-001", "briefing-refugee-asylum-displacement-humanitarian-protection-responsibility-001", "briefing-climate-ocean-biodiversity-polar-global-commons-stewardship-001", "briefing-pandemic-biosecurity-cross-border-health-risk-coordination-001", "briefing-digital-space-nuclear-cyber-frontier-catastrophic-risk-001", "briefing-future-generations-intergenerational-equity-shared-human-futures-001"];
const mapIds = ["dependency-map-treaty-signed-is-not-effective-cooperation", "dependency-map-institutional-membership-is-not-equal-representation-or-influence", "dependency-map-global-commitment-is-not-financed-delivery", "dependency-map-data-sharing-is-not-coordinated-cross-border-risk-reduction", "dependency-map-shared-resource-designation-is-not-governed-stewardship", "dependency-map-global-goal-is-not-a-secured-shared-human-future"];
const state = kind === "order" ? record.international_order_state : kind === "multilateral" ? record.multilateral_state : kind === "mobility" ? record.human_mobility_state : record.shared_futures_state;
const id = kind === "order" ? record.international_order_diplomacy_treaties_international_law_peaceful_dispute_resolution_dossier_id : kind === "multilateral" ? record.multilateral_institutions_representation_development_cooperation_collective_delivery_ledger_id : kind === "mobility" ? record.migration_displacement_refugee_asylum_humanitarian_protection_shared_responsibility_register_id : record.global_commons_transboundary_risk_catastrophic_risk_intergenerational_shared_human_futures_ledger_id;
const title = id + ": " + record.named_entity;
const phase99Record = phase99.civic_information_media_pluralism_public_trust_institutional_legitimacy_democratic_resilience_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase101Record = phase101.whole_system_scenario_assumption_boundary_driver_uncertainty_dossiers.find((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  order: { label: "International Order, Diplomacy, Treaties, International Law And Peaceful-Dispute-Resolution Dossier", gates: record.international_order_checks, gateCount: 20, groups: [["International-order classes", record.international_order_class_records, "class_state"], ["International-order dimensions", record.international_order_dimension_records, "dimension_state"], ["International-order safeguards", record.international_order_safeguard_records, "safeguard_state"]], decision: record.international_order_decision },
  multilateral: { label: "Multilateral Institutions, Representation, Development Cooperation And Collective-Delivery Ledger", gates: record.multilateral_checks, gateCount: 22, groups: [["Multilateral classes", record.multilateral_class_records, "class_state"], ["Multilateral dimensions", record.multilateral_dimension_records, "dimension_state"], ["Multilateral safeguards", record.multilateral_safeguard_records, "safeguard_state"]], decision: record.multilateral_decision },
  mobility: { label: "Migration, Displacement, Refugee, Asylum, Humanitarian Protection And Shared-Responsibility Register", gates: record.human_mobility_checks, gateCount: 22, groups: [["Human-mobility classes", record.human_mobility_class_records, "class_state"], ["Human-mobility dimensions", record.human_mobility_dimension_records, "dimension_state"], ["Human-mobility safeguards", record.human_mobility_safeguard_records, "safeguard_state"]], decision: record.human_mobility_decision },
  futures: { label: "Global Commons, Transboundary Risk, Catastrophic Risk, Intergenerational And Shared-Human-Futures Ledger", gates: record.shared_futures_checks, gateCount: 24, groups: [["Global-commons classes", record.global_commons_class_records, "class_state"], ["Global-futures dimensions", record.global_futures_dimension_records, "dimension_state"], ["Global-futures safeguards", record.global_futures_safeguard_records, "safeguard_state"], ["Long-horizon shared-futures tests", record.long_horizon_shared_futures_test_records, "test_state"]], decision: record.shared_futures_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 100 international-order, multilateral, humanitarian, global-commons, and shared-futures contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 treaty or shared-futures decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 99 democratic-legitimacy and resilience ledger</h2><p>{phase99Record ? <a href={'/evidence/democracy-government-public-administration-civic-information-institutional-legitimacy/' + phase99Record.slug + '/'}>{phase99Record.civic_information_media_pluralism_public_trust_institutional_legitimacy_democratic_resilience_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Phase 101 Destination</h2><p>{phase101Record ? <a href={'/evidence/whole-system-futures-scenario-governance-polycrisis-readiness-civilizational-resilience-future-generations/' + phase101Record.slug + '/'}>{phase101Record.whole_system_scenario_assumption_boundary_driver_uncertainty_dossier_id}</a> : "No assigned downstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 treaty implementation, multilateral representation, financed delivery, migration protection, humanitarian responsibility, global-commons stewardship, cross-border risk reduction, shared futures, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>A treaty signed is not effective cooperation; a global goal is not a secured shared future.</h2><p>No party, treaty, representation, finance, delivery, migration, status, protection, commons, risk-reduction, future-generation, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
