---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-99-democracy-government-public-administration-civic-information-institutional-legitimacy-registry.json";
import phase98 from "../../../data/phase-98-law-justice-public-safety-emergency-management-security-defense-peace-registry.json";
import phase100 from "../../../data/phase-100-international-order-multilateral-cooperation-global-commons-cross-border-risk-shared-human-futures-registry.json";

export function getStaticPaths() {
  return [
    ...registry.elections_representation_participation_inclusion_democratic_integrity_dossiers.map((record) => ({ params: { id: record.slug }, props: { kind: "democracy", record } })),
    ...registry.constitutional_legislative_executive_public_administration_capability_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "government", record } })),
    ...registry.public_accountability_fiscal_transparency_audit_procurement_integrity_open_government_registers.map((record) => ({ params: { id: record.slug }, props: { kind: "accountability", record } })),
    ...registry.civic_information_media_pluralism_public_trust_institutional_legitimacy_democratic_resilience_ledgers.map((record) => ({ params: { id: record.slug }, props: { kind: "legitimacy", record } }))
  ];
}

const { kind, record } = Astro.props as { kind: "democracy" | "government" | "accountability" | "legitimacy"; record: any };
const [briefings, dependencyMaps, signals, sources] = await Promise.all([getCollection("briefings"), getCollection("dependencyMaps"), getCollection("signals"), getCollection("sources")]);
const briefingById = new Map(briefings.map((item) => [item.data.id, item]));
const mapById = new Map(dependencyMaps.map((item) => [item.data.id, item]));
const signalById = new Map(signals.map((item) => [item.data.id, item]));
const sourceById = new Map(sources.map((item) => [item.data.id, item]));
const guideIds = ["briefing-democracy-government-public-administration-civic-information-legitimacy-doctrine-001", "briefing-elections-franchise-representation-participation-integrity-001", "briefing-electoral-administration-campaign-finance-boundaries-transition-001", "briefing-legislatures-constitutional-accountability-law-making-oversight-001", "briefing-executive-government-delivery-public-administration-capability-001", "briefing-public-service-merit-integrity-capability-continuity-001", "briefing-fiscal-transparency-budget-audit-procurement-integrity-001", "briefing-open-government-records-access-public-reasoning-accountability-001", "briefing-civic-information-media-pluralism-local-news-information-integrity-001", "briefing-public-consultation-petition-participatory-deliberative-democracy-001", "briefing-public-trust-institutional-legitimacy-rights-performance-fairness-001", "briefing-democratic-resilience-continuity-renewal-nonrecurrence-001"];
const mapIds = ["dependency-map-election-held-is-not-inclusive-representative-democracy", "dependency-map-public-institution-is-not-administrative-capacity", "dependency-map-published-plan-is-not-accountable-government-delivery", "dependency-map-open-data-is-not-usable-civic-information", "dependency-map-approval-or-compliance-is-not-institutional-legitimacy", "dependency-map-government-continuity-is-not-democratic-resilience"];
const state = kind === "democracy" ? record.democracy_state : kind === "government" ? record.government_capacity_state : kind === "accountability" ? record.accountability_state : record.legitimacy_state;
const id = kind === "democracy" ? record.elections_representation_participation_inclusion_democratic_integrity_dossier_id : kind === "government" ? record.constitutional_legislative_executive_public_administration_capability_ledger_id : kind === "accountability" ? record.public_accountability_fiscal_transparency_audit_procurement_integrity_open_government_register_id : record.civic_information_media_pluralism_public_trust_institutional_legitimacy_democratic_resilience_ledger_id;
const title = id + ": " + record.named_entity;
const phase98Record = phase98.defense_intelligence_conflict_prevention_civilian_protection_peace_stewardship_ledgers.find((item) => item.cohort_id === record.cohort_id);
const phase100Record = phase100.international_order_diplomacy_treaties_international_law_peaceful_dispute_resolution_dossiers.find((item) => item.cohort_id === record.cohort_id);
const configs: Record<string, any> = {
  democracy: { label: "Elections, Representation, Participation, Inclusion And Democratic-Integrity Dossier", gates: record.democracy_checks, gateCount: 20, groups: [["Democracy classes", record.democracy_class_records, "class_state"], ["Democracy dimensions", record.democracy_dimension_records, "dimension_state"], ["Democracy safeguards", record.democracy_safeguard_records, "safeguard_state"]], decision: record.democracy_decision },
  government: { label: "Constitutional, Legislative, Executive And Public-Administration Capability Ledger", gates: record.government_checks, gateCount: 22, groups: [["Government-capability classes", record.government_capability_class_records, "class_state"], ["Government-capability dimensions", record.government_capability_dimension_records, "dimension_state"], ["Government safeguards", record.government_safeguard_records, "safeguard_state"]], decision: record.government_capacity_decision },
  accountability: { label: "Public Accountability, Fiscal Transparency, Audit, Procurement Integrity And Open-Government Register", gates: record.accountability_checks, gateCount: 22, groups: [["Accountability classes", record.accountability_class_records, "class_state"], ["Accountability dimensions", record.accountability_dimension_records, "dimension_state"], ["Accountability safeguards", record.accountability_safeguard_records, "safeguard_state"]], decision: record.accountability_decision },
  legitimacy: { label: "Civic Information, Media Pluralism, Public Trust, Institutional Legitimacy And Democratic-Resilience Ledger", gates: record.legitimacy_checks, gateCount: 24, groups: [["Legitimacy classes", record.legitimacy_class_records, "class_state"], ["Legitimacy dimensions", record.legitimacy_dimension_records, "dimension_state"], ["Legitimacy safeguards", record.legitimacy_safeguard_records, "safeguard_state"], ["Long-horizon democratic-resilience tests", record.long_horizon_democratic_resilience_test_records, "test_state"]], decision: record.legitimacy_decision }
};
const config = configs[kind];
---

<BaseLayout title={title + " | FTFN"} description={title + ": inactive Phase 99 democracy, government, public-administration, civic-information, legitimacy, and resilience contract."} robots="index, follow">
  <section class="page-section"><div class="eyebrow">{config.label}</div><h1 class="page-title">{title}</h1><div class="meta-row"><MetaPill label={state} tone="review" /><MetaPill label="0 democracy or legitimacy decisions" tone="review" /><MetaPill label="0 receipts" tone="review" /><MetaPill label="0 scores" tone="review" /></div></section>
  <section class="page-section"><div class="status-panel"><article class="status-item"><h2>Phase 98 security and peace-stewardship ledger</h2><p>{phase98Record ? <a href={'/evidence/law-justice-public-safety-emergency-security-defense-peace/' + phase98Record.slug + '/'}>{phase98Record.defense_intelligence_conflict_prevention_civilian_protection_peace_stewardship_ledger_id}</a> : "No verified upstream record"}</p></article><article class="status-item"><h2>Phase 100 Destination</h2><p>{phase100Record ? <a href={'/evidence/international-order-multilateral-cooperation-global-commons-cross-border-risk-shared-human-futures/' + phase100Record.slug + '/'}>{phase100Record.international_order_diplomacy_treaties_international_law_peaceful_dispute_resolution_dossier_id}</a> : "No assigned downstream record"}</p></article><article class="status-item"><h2>Decision state</h2><p>{config.decision}</p></article><article class="status-item"><h2>Governed results</h2><p>0 democracy, representation, government capability, public-service delivery, accountability, transparency, civic-information, trust, legitimacy, resilience, receipt, score, ranking, or stage decisions</p></article></div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Admission Control</div><h2>{config.gateCount} gates remain Inactive.</h2></div></div><div class="source-list">{config.gates.map((item: any) => <article class="source-row"><div><h3>{item.label}</h3><p>{item.basis}</p></div><MetaPill label={item.decision_state} tone="review" /></article>)}</div></section>
  {config.groups.map(([label, items, stateField]: [string, any[], string]) => <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Controlled Taxonomy</div><h2>{label} remain unassigned.</h2></div></div><div class="grid">{items.map((item: any) => <article class="record-card"><h3>{item.label}</h3><p>No authority, evidence, finding, classification, allocation, decision, or receipt exists.</p><MetaPill label={item[stateField]} tone="review" /></article>)}</div></section>)}
  <section class="page-section"><div class="grid"><article class="record-card"><h2>Connected guides</h2><ul>{guideIds.map((guideId) => { const item = briefingById.get(guideId); return <li>{item ? <a href={'/briefings/' + item.data.slug + '/'}>{item.data.title}</a> : guideId}</li>; })}</ul></article><article class="record-card"><h2>Connected maps</h2><ul>{mapIds.map((mapId) => { const item = mapById.get(mapId); return <li>{item ? <a href={'/atlas/dependency-maps/' + item.data.slug + '/'}>{item.data.title}</a> : mapId}</li>; })}</ul></article><article class="record-card"><h2>Connected evidence</h2><ul>{record.source_ids.map((sourceId: string) => { const item = sourceById.get(sourceId); return <li>{item ? <a href={'/atlas/sources/' + item.data.id + '/'}>{item.data.name}</a> : sourceId}</li>; })}{record.signal_ids.map((signalId: string) => { const item = signalById.get(signalId); return <li>{item ? <a href={'/signals/' + item.data.slug + '/'}>{item.data.title}</a> : signalId}</li>; })}</ul></article></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Boundary</div><h2>An election held is not representative democracy; continuity is not democratic resilience.</h2><p>No voter, candidate, franchise, election, representation, mandate, capacity, delivery, audit, open-data, civic-information, trust, legitimacy, resilience, reviewer, receipt, score, rank, or stage change is recorded on this page.</p></div></section>
</BaseLayout>
