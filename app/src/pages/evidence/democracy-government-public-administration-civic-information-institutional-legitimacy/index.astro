---
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import registry from "../../../data/phase-99-democracy-government-public-administration-civic-information-institutional-legitimacy-registry.json";
const democracy = registry.elections_representation_participation_inclusion_democratic_integrity_dossiers;
const government = registry.constitutional_legislative_executive_public_administration_capability_ledgers;
const accountability = registry.public_accountability_fiscal_transparency_audit_procurement_integrity_open_government_registers;
const legitimacy = registry.civic_information_media_pluralism_public_trust_institutional_legitimacy_democratic_resilience_ledgers;
---

<BaseLayout title="Democracy, Government, Public Administration, Civic Information And Institutional Legitimacy | FTFN" description="Thirty-two inactive democracy, government-capability, accountability, civic-information, legitimacy, and resilience records.">
  <section class="page-section hero" data-democracy-government-civic-information-legitimacy-registry><div class="hero__copy"><div class="eyebrow">FTFN / Democracy, Government And Legitimacy</div><h1 class="page-title">An election held is not representative democracy, and continuity is not democratic resilience.</h1><p class="lede">Phase 99 traces elections, representation and participation; constitutional institutions and public-administration capability; fiscal, audit, procurement and open-government accountability; then civic information, media pluralism, public trust, institutional legitimacy and democratic resilience.</p><div class="meta-row"><MetaPill label="8 inactive democracy dossiers" tone="possibility" /><MetaPill label="8 inactive government ledgers" /><MetaPill label="8 inactive accountability registers" /><MetaPill label="8 inactive legitimacy ledgers" /><MetaPill label="0 democracy or legitimacy decisions" tone="review" /></div></div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Elections, Representation And Participation</div><h2>Eight democracy dossiers remain closed.</h2></div><a class="inline-link" href="/briefings/elections-franchise-representation-participation-integrity-001/">Read the democracy guide</a></div><div class="grid">{democracy.map((record) => <article class="record-card"><div class="meta-row"><MetaPill label={record.democracy_state} tone="review" /><MetaPill label="20 inactive gates" /></div><h3><a href={'/evidence/democracy-government-public-administration-civic-information-institutional-legitimacy/' + record.slug + '/'}>{record.named_entity}</a></h3><p>Franchise, access, candidates, administration, counting, representation, participation, transfer, challenge and receipts remain empty.</p></article>)}</div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Constitutional Government And Public-Administration Capability</div><h2>Eight government ledgers contain no delivery decision.</h2></div><a class="inline-link" href="/briefings/executive-government-delivery-public-administration-capability-001/">Read the government-capability guide</a></div><div class="grid">{government.map((record) => <article class="record-card"><div class="meta-row"><MetaPill label={record.government_capacity_state} tone="review" /><MetaPill label="22 inactive gates" /></div><h3><a href={'/evidence/democracy-government-public-administration-civic-information-institutional-legitimacy/' + record.slug + '/'}>{record.constitutional_legislative_executive_public_administration_capability_ledger_id}: {record.named_entity}</a></h3><p>Mandates, checks, public-service capacity, plans, budgets, coordination, delivery, continuity, correction and remedy remain unassessed.</p></article>)}</div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Public Accountability, Fiscal Transparency And Open Government</div><h2>Eight accountability registers remain inactive.</h2></div><a class="inline-link" href="/briefings/fiscal-transparency-budget-audit-procurement-integrity-001/">Read the public-accountability guide</a></div><div class="source-list">{accountability.map((record) => <article class="source-row"><div><h3><a href={'/evidence/democracy-government-public-administration-civic-information-institutional-legitimacy/' + record.slug + '/'}>{record.public_accountability_fiscal_transparency_audit_procurement_integrity_open_government_register_id}: {record.named_entity}</a></h3><p>Budgets, expenditure, audits, procurement, ownership, records, open data, complaints, correction and recovered public value remain unassessed.</p></div><MetaPill label={record.accountability_state} tone="review" /></article>)}</div></section>

  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Civic Information, Public Trust, Legitimacy And Resilience</div><h2>Eight legitimacy ledgers contain no institutional-legitimacy or resilience decision.</h2></div><a class="inline-link" href="/briefings/democratic-resilience-continuity-renewal-nonrecurrence-001/">Read the democratic-resilience guide</a></div><div class="grid">{legitimacy.map((record) => <article class="record-card"><h3><a href={'/evidence/democracy-government-public-administration-civic-information-institutional-legitimacy/' + record.slug + '/'}>{record.civic_information_media_pluralism_public_trust_institutional_legitimacy_democratic_resilience_ledger_id}: {record.named_entity}</a></h3><p>Civic information, media pluralism, public participation, trust, fairness, legitimacy, renewal, resilience and remedy remain inactive.</p><MetaPill label={record.legitimacy_state} tone="review" /></article>)}</div></section>

  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Public Contract</div><h2>Inspect the empty democracy, government, information and legitimacy state.</h2><p>The export publishes the complete control surface without treating elections as democracy, institutions as capacity, plans as delivery, open data as usable information, approval or compliance as legitimacy, or continuity as resilience—and without scoring or deciding for a voter, candidate, party, institution, media organization, community, government or jurisdiction.</p></div><article class="record-card"><a class="inline-link" href="/data/democracy-government-public-administration-civic-information-institutional-legitimacy.json">Democracy, government, civic-information and legitimacy JSON</a></article></section>
</BaseLayout>
