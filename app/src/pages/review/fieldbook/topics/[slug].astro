---
import BaseLayout from "../../../../components/layout/BaseLayout.astro";
import ReviewHeader from "../../../../components/review/ReviewHeader.astro";
import MetaPill from "../../../../components/ui/MetaPill.astro";
import registry from "../../../../data/phase-124-topic-research-workbenches.json";
import topicReviews from "../../../../data/phase-128-topic-state-of-evidence-reviews.json";

export function getStaticPaths() {
  return registry.workbenches.map((record) => ({ params: { slug: record.slug }, props: { workbenchId: record.workbench_id } }));
}
const record = registry.workbenches.find((item) => item.workbench_id === Astro.props.workbenchId)!;
const review = topicReviews.topic_reviews.find((item) => item.workbench_id === record.workbench_id)!;
---

<BaseLayout title={`${review.title} | FTFN v0.6`} description={review.authored_sections.executive_read}>
  <ReviewHeader eyebrow="Open Evidence Review · Topic state of evidence" title={review.title} summary={review.review_state} phase={128} />
  <section class="page-section"><div class="metric-strip" aria-label={`${record.title} counts`}><div class="metric"><strong>{record.canonical_context.published_signals}</strong><span>Published context signals</span></div><div class="metric"><strong>{record.mission_links.length}</strong><span>open missions</span></div><div class="metric"><strong>{record.acquisition_links.length}</strong><span>topic discovery packets</span></div><div class="metric"><strong>{record.project_links.length + record.place_links.length}</strong><span>Atlas files</span></div></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Canonical context</div><h2>Keep explanation and operations connected.</h2><p>{record.canonical_context.baseline_state}</p><p><a href={record.canonical_context.coverage_route}>Open coverage contract</a> · <a href={record.canonical_context.encyclopedia_route}>Read encyclopedia chapter</a></p></div><article class="record-card record-card--featured"><MetaPill label="No evidence-state change" tone="review" /><h3>What changed since v0.4</h3><p>{record.open_work.change_since_v04}</p></article></section>
  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Phase 128 · Open Evidence Review</div><h2>{review.title}.</h2><p>{review.review_state}</p></div><div class="meta-row"><MetaPill label={review.review_id} /><MetaPill label={`${review.authored_word_count.toLocaleString()} rendered analysis words`} tone="possibility" /></div></div>
    <div class="briefing-band"><div class="briefing-band__copy"><h3>Executive read</h3><p>{review.authored_sections.executive_read}</p></div><article class="record-card record-card--featured"><MetaPill label="Editorial sequence only" tone="review" /><h3>Research-value ordering</h3><p>{review.topic_sequence.ordering_boundary}</p><p><a href="/review/fieldbook/topic-reviews/">Open all topic reviews</a></p></article></div>
  </section>
  <section class="page-section prose-page">
    <h2>Strongest current evidence</h2><p>{review.authored_sections.strongest_current_evidence}</p>
    <h2>Contested reading and limits</h2><p>{review.authored_sections.contested_reading}</p>
    <h2>Cross-system implications</h2><p>{review.authored_sections.cross_system_implications}</p>
    <h2>Research program</h2><p>{review.authored_sections.research_program}</p>
  </section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Phase 128 horizon review</div><h2>Four open evidence readings.</h2><p>Every section resolves one exact Phase 126 audit and retains the upstream mission answer state.</p></div></div><div class="signal-grid">{review.horizon_sections.map((horizon) => <article class="record-card"><div class="meta-row"><MetaPill label={horizon.horizon} /><MetaPill label={horizon.audit_disposition} tone="review" /></div><h3>{horizon.mission_id} · {horizon.audit_id}</h3><p>{horizon.analysis}</p><h4>Next-artifact research queue</h4><ol>{horizon.next_artifact_queue.map((item) => <li><strong>{item.tier}:</strong> {item.artifact_need}<br /><span>{item.rationale}</span></li>)}</ol><p><em>{horizon.queue_boundary}</em></p></article>)}</div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Four horizons</div><h2>Research missions.</h2><p>Acquisition coverage is mission-specific. Covered means an exact Phase 121 packet join exists; Gap means its exact packet list is empty.</p></div></div><div class="signal-grid">{record.mission_links.map((mission) => <article class="record-card"><div class="meta-row"><MetaPill label={mission.horizon} /><MetaPill label={mission.acquisition_coverage} tone={mission.acquisition_coverage === "Covered" ? "possibility" : "urgency"} /><MetaPill label="Not adjudicated" tone="review" /></div><h3><a href={mission.route}>{mission.question}</a></h3><p><strong>Acquisition state:</strong> {mission.acquisition_state}</p><p>{mission.acquisition_packet_count > 0 ? `${mission.acquisition_packet_count} exact mission packet links.` : "No exact mission packet link; the acquisition coverage gap remains explicit."}</p><p>{mission.completion_rule}</p></article>)}</div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Acquisition · {record.acquisition_inventory_scope.scope}</div><h2>{record.acquisition_inventory_scope.label}.</h2><p>{record.acquisition_inventory_scope.assignment_boundary}</p></div></div><div class="signal-grid">{record.acquisition_links.map((packet) => <article class="record-card"><div class="meta-row"><MetaPill label={packet.jurisdiction_name} /><MetaPill label={packet.inventory_role} tone="draft" /><MetaPill label={packet.disposition} tone="review" /></div><h3><a href={packet.route}>{packet.institution_name}</a></h3><p>{packet.authority_class}</p><p>{packet.target_count} prepared artifact targets</p></article>)}</div></section>
  <section class="page-section review-columns"><article><div class="eyebrow">Named projects</div><h2>{record.project_links.length ? "Project files" : "No canonical project file yet"}</h2><div class="source-list">{record.project_links.map((item) => <div class="source-row"><h3><a href={item.route}>{item.title}</a></h3><p>{item.coverage_tier}</p></div>)}</div></article><article><div class="eyebrow">Named places</div><h2>{record.place_links.length ? "Receiving systems" : "No canonical place file yet"}</h2><div class="source-list">{record.place_links.map((item) => <div class="source-row"><h3><a href={item.route}>{item.title}</a></h3><p>{item.coverage_tier}</p></div>)}</div></article></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Matched delivery</div><h2>Context-only dossiers.</h2></div></div>{record.dossier_links.length ? <div class="signal-grid">{record.dossier_links.map((item) => <article class="record-card"><MetaPill label={item.verdict} tone="review" /><h3><a href={item.route}>{item.title}</a></h3><p>Compare evidence structure and stopping points, not project performance.</p></article>)}</div> : <article class="record-card"><h3>No matched dossier yet</h3><p>This absence is visible next work, not permission to borrow a comparison from another topic.</p></article>}</section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Verification method</div><h2>Thirty independent playbooks.</h2><p>Stages, claims and quality dimensions remain separate. They are never averaged into a score.</p></div></div><div class="review-columns"><article><h3>Conversion stages</h3><ul>{record.method_links.stages.map((item) => <li><a href={item.route}>{item.label}</a></li>)}</ul><h3>Claim protocols</h3><ul>{[...record.method_links.primary_claims, ...record.method_links.adjacent_claim_guardrails].map((item) => <li><a href={item.route}>{item.label}</a></li>)}</ul></article><article><h3>Quality audit</h3><ul>{record.method_links.quality.map((item) => <li><a href={item.route}>{item.label}</a> — not adjudicated independently</li>)}</ul></article></div></section>
  <section class="page-section prose-page"><h2>Exact next work</h2>{record.open_work.exact_next_artifacts.map((item) => <section><h3>{item.mission_id}</h3><ul>{item.requirements.map((requirement) => <li>{requirement}</li>)}</ul></section>)}<h2>Correction path</h2><p>{record.open_work.correction_path}</p><h2>Interpretation boundary</h2><p>{record.interpretation_boundary}</p></section>
</BaseLayout>
