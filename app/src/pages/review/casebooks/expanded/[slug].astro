---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../components/layout/BaseLayout.astro";
import ReviewHeader from "../../../../components/review/ReviewHeader.astro";
import MetaPill from "../../../../components/ui/MetaPill.astro";
import program from "../../../../data/v031-content-expansion.json";
import atlas from "../../../../data/phase-119-deep-project-place-atlas.json";
import {canonicalProjectRefreshes} from '../../../../lib/canonical-project-refreshes.mjs';
import {canonicalAnnualBindings} from '../../../../lib/canonical-annual-reader-bindings.mjs';

export function getStaticPaths() { return program.casebooks.map((record) => ({ params: { slug: record.slug }, props: { casebookId: record.casebook_id } })); }
const record = program.casebooks.find((item) => item.casebook_id === Astro.props.casebookId)!;
const atlasProject = atlas.projects.find((item) => item.legacy_ids.includes(record.casebook_id))!;
const refreshedAccount=canonicalProjectRefreshes.records.find(r=>r.record_id===atlasProject.atlas_project_id&&r.related[0]?.route===Astro.url.pathname);
const annualAccount=canonicalAnnualBindings.records.find(r=>r.atlas_record_id===atlasProject.atlas_project_id&&r.prior_casebook_route===Astro.url.pathname);
const allSignals = await getCollection("signals");
const signalById = new Map(allSignals.map((signal) => [signal.data.id, signal]));
const signals = atlasProject.evidence_rails.signal_ids.map((id) => signalById.get(id)).filter(Boolean) as typeof allSignals;
const sources = await getCollection("sources");
const sourceById = new Map(sources.map((source) => [source.data.id, source]));
const selectedSources = atlasProject.evidence_rails.source_ids.map((id) => sourceById.get(id)).filter(Boolean) as typeof sources;
---

<BaseLayout title={`${record.title} | FTFN casebook`} description={record.editorial_question}>
  <ReviewHeader eyebrow="Phase 113 · Expanded casebook" title={record.title} summary={record.editorial_question} phase={113} />
  {annualAccount&&<aside class="page-section" data-canonical-annual-casebook={annualAccount.binding_id}><h2>Assessed annual reading on the Atlas</h2><p><a href={annualAccount.target_route}>{annualAccount.article_title}</a> — assessed {annualAccount.original_review_date}, connected to the Atlas {canonicalAnnualBindings.integration_date}. {annualAccount.identity_boundary} The earlier casebook, reviewed narrative and later evidence checks retain their separate dates and scopes.</p></aside>}
  {refreshedAccount&&<aside class="page-section" data-later-project-account={refreshedAccount.record_id}><h2>Later dated project account</h2><p><a href={refreshedAccount.route}>{refreshedAccount.title}</a> — authored and AI self-reviewed {canonicalProjectRefreshes.review_date}. This earlier curated shelf keeps its original evidence and dates; the later account does not create a governed conversion file.</p></aside>}
  <section class="page-section"><div class="meta-row"><MetaPill label={atlasProject.coverage.label} tone="review" /><MetaPill label={atlasProject.atlas_project_id} /></div><p class="card-note">This shelf now resolves through explicit curated signal and source IDs. <a class="inline-link" href={atlasProject.routes.atlas}>Open the canonical Project Atlas file</a>.</p></section>
  <section class="page-section review-columns"><article><div class="eyebrow">Established</div><h2>What the shelf can support.</h2><p>{record.established}</p></article><article><div class="eyebrow">Still unresolved</div><h2>Where the claim stops.</h2><p>{record.unresolved}</p></article></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Record sequence</div><h2>Named evidence, in capture order.</h2></div><MetaPill label={`${signals.length} Published signals`} /></div><ol class="timeline-list">{signals.map((signal) => <li><div class="meta-row"><MetaPill label={signal.data.captured_date.toISOString().slice(0, 10)} /><MetaPill label={signal.data.maturity_level} /></div><h3><a href={`/signals/${signal.data.slug}/`}>{signal.data.title}</a></h3><p>{signal.data.summary}</p></li>)}</ol></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Primary sources</div><h2>Rails cited by the selected records.</h2></div></div><div class="source-list">{selectedSources.map((source) => <article class="source-row"><h3><a href={`/atlas/sources/${source.data.id}/`}>{source.data.name}</a></h3><p>{source.data.source_type} · last checked {source.data.last_checked_date.toISOString().slice(0, 10)}</p></article>)}</div></section>
  <section class="page-section prose-page"><h2>Interpretation boundary</h2><p>{record.interpretation_boundary}</p></section>
</BaseLayout>
