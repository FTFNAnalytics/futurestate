---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import ReviewHeader from "../../../components/review/ReviewHeader.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import program from "../../../data/v03-editorial-program.json";
import projects from "../../../data/phase-61-project-conversion-registry.json";

const topics = await getCollection("topics");
const signals = await getCollection("signals");
const published = signals.filter((signal) => signal.data.record_status === "Published");
const sources = await getCollection("sources");
const topicRows = topics.map((topic) => ({ topic, count: published.filter((signal) => signal.data.primary_topic === topic.data.name).length })).sort((a, b) => b.count - a.count);
---

<BaseLayout title="State of frontier systems 2026 | FTFN Review" description="The current FTFN editorial synthesis, evidence position and unresolved conversion frontier as of August 29, 2026.">
  <ReviewHeader eyebrow="2026 edition · current through August 29" title="State of frontier systems" summary="The evidence shelf is broad. The decisive frontier is narrower: named authority, accepted infrastructure, recurring operation, compatible measurement and outcomes that survive scrutiny." phase={110} />
  <section class="page-section"><div class="metric-strip"><div class="metric"><strong>{published.length}</strong><span>Published signals</span></div><div class="metric"><strong>{sources.length}</strong><span>source records</span></div><div class="metric"><strong>{topics.length}</strong><span>topic systems</span></div><div class="metric"><strong>{program.counts.casebooks}</strong><span>named casebooks</span></div></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Editorial finding</div><h2>The bottleneck is conversion evidence.</h2><p>Across the current shelf, direction, funding, rules and selected milestones are easier to establish than accepted capacity, recurring service, stable denominators and attributable outcomes. The v0.3 edition therefore organizes the corpus around what each record proves, what remains downstream and which named artifact could close the gap.</p></div><article class="record-card record-card--featured"><div class="eyebrow">Reading boundary</div><p>This is an editorial synthesis of dated records, not a forecast, recommendation, score or ranking. The eight project files below retain their existing gate states.</p></article></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Topic shelf</div><h2>Where Published evidence is concentrated.</h2></div></div><div class="signal-grid">{topicRows.map(({ topic, count }) => <article class="record-card"><div class="meta-row"><MetaPill label={`${count} Published signals`} /></div><h3><a href={`/review/topics/${topic.data.slug}/`}>{topic.data.name}</a></h3><p>{topic.data.summary}</p></article>)}</div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Named conversion frontier</div><h2>Eight files keep the narrative grounded.</h2></div></div><div class="source-list">{projects.records.map((project) => { const editorial = program.casebooks.find((item) => item.file_id === project.file_id)!; return <article class="source-row"><div class="meta-row"><MetaPill label={project.current_stage} /></div><h3><a href={`/review/casebooks/${editorial.slug}/`}>{project.title}</a></h3><p>{project.unresolved}</p></article>; })}</div></section>
</BaseLayout>
