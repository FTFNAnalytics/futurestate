---
import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import ReviewHeader from "../../../components/review/ReviewHeader.astro";
import MetaPill from "../../../components/ui/MetaPill.astro";
import v09 from "../../../data/v09-living-public-intelligence.json";
import desks from "../../../data/phase-140-living-topic-desks.json";
import projects from "../../../data/phase-136-named-project-chronicles.json";
import places from "../../../data/phase-137-place-delivery-ledgers.json";

const topics = await getCollection("topics");
const signals = await getCollection("signals");
const published = signals.filter((signal) => signal.data.record_status === "Published");
const sources = await getCollection("sources");
const topicRows = topics.map((topic) => ({ topic, count: published.filter((signal) => signal.data.primary_topic === topic.data.name).length })).sort((a, b) => b.count - a.count);
---

<BaseLayout title="State of frontier systems 2026 | FTFN Review" description="The current FTFN editorial synthesis, evidence position and unresolved conversion frontier as of August 30, 2026.">
  <ReviewHeader eyebrow="v0.9 edition · current through August 30, 2026" title="State of frontier systems" summary={v09.summary} phase={143} />
  <section class="page-section"><div class="metric-strip"><div class="metric"><strong>{published.length}</strong><span>Published signals</span></div><div class="metric"><strong>{sources.length}</strong><span>source records</span></div><div class="metric"><strong>{desks.counts.living_topic_desks}</strong><span>living topic desks</span></div><div class="metric"><strong>{projects.counts.project_chronicles + places.counts.place_ledgers}</strong><span>named delivery files</span></div></div></section>
  <section class="page-section briefing-band"><div class="briefing-band__copy"><div class="eyebrow">Editorial finding</div><h2>The frontier is now legible as a chain of decisions.</h2><p>Direction, funding, rules and selected milestones remain easier to establish than accepted capacity, recurring service, stable denominators and attributable outcomes. v0.9 connects every topic desk to named projects, places, comparisons and next evidence while keeping all owner-gated admissions and future checks visible.</p></div><article class="record-card record-card--featured"><div class="eyebrow">Reading boundary</div><p>This is a dated synthesis of the Published corpus, not a forecast, recommendation, score or ranking. Twenty-four project chronicles and fifteen place ledgers retain their inherited states.</p><a class="inline-link" href="/review/v09/">Open v0.9</a></article></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Topic shelf</div><h2>Where Published evidence is concentrated.</h2></div></div><div class="signal-grid">{topicRows.map(({ topic, count }) => <article class="record-card"><div class="meta-row"><MetaPill label={`${count} Published signals`} /></div><h3><a href={`/review/topics/${topic.data.slug}/`}>{topic.data.name}</a></h3><p>{topic.data.summary}</p></article>)}</div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Named conversion frontier</div><h2>Twenty-four project chronicles keep the narrative grounded.</h2></div></div><div class="source-list">{projects.project_chronicles.map((project) => <article class="source-row"><div class="meta-row"><MetaPill label={project.inherited_stage} /></div><h3><a href={project.route}>{project.title}</a></h3><p>{project.unresolved_bridge}</p></article>)}</div></section>
  <section class="page-section"><div class="section-heading"><div><div class="eyebrow">Receiving systems</div><h2>Fifteen places show where delivery has to land.</h2></div></div><div class="signal-grid">{places.place_ledgers.map((place) => <article class="record-card"><MetaPill label={place.coverage_tier} /><h3><a href={place.route}>{place.title}</a></h3><p>{place.exact_next_artifact}</p></article>)}</div></section>
</BaseLayout>
