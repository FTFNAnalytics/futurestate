---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import ReviewHeader from "../../components/review/ReviewHeader.astro";
import MetaPill from "../../components/ui/MetaPill.astro";
import program from "../../data/v03-editorial-program.json";
import expansion from "../../data/v031-content-expansion.json";
import v04 from "../../data/v04-public-conversion-observatory.json";
import v05 from "../../data/v05-evidence-fieldbook.json";
import v06 from "../../data/v06-open-evidence-review.json";
import v07 from "../../data/v07-evidence-admission-dockets.json";
import v08 from "../../data/v08-conversion-longitudinal-atlas.json";
import v09 from "../../data/v09-living-public-intelligence.json";
---

<BaseLayout title="The FTFN Review | Living Public Intelligence" description={v09.summary}>
  <ReviewHeader eyebrow="v0.9 living public intelligence" title="The FTFN Review" summary={v09.summary} />

  <section class="page-section">
    <div class="metric-strip" aria-label="Editorial program counts">
      <div class="metric"><strong>{v09.release_state.desks}</strong><span>living topic desks</span></div>
      <div class="metric"><strong>{v09.release_state.almanac_entries}</strong><span>almanac entries</span></div>
      <div class="metric"><strong>{v08.evidence_state.atlas_records}</strong><span>Atlas reviews</span></div>
      <div class="metric"><strong>{v07.evidence_state.owner_requirement_decisions_pending}</strong><span>owner decisions open</span></div>
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Phases 130–144</div><h2>From admission dockets to living intelligence.</h2><p>The next three editions add owner-gated evidence review, a complete conversion and longitudinal Atlas, and a maintained public intelligence layer without hiding the gates that still hold v1.</p></div><MetaPill label="15 complete content phases" tone="possibility" /></div>
    <div class="signal-grid">
      <article class="record-card"><MetaPill label="v0.7 · Phases 130–134" /><h3><a href="/review/v07/">Evidence Admission Dockets</a></h3><p>{v07.summary}</p><a class="inline-link" href="/review/v07/">Open v0.7</a></article>
      <article class="record-card"><MetaPill label="v0.8 · Phases 135–139" /><h3><a href="/review/v08/">Conversion and Longitudinal Atlas</a></h3><p>{v08.summary}</p><a class="inline-link" href="/review/v08/">Open v0.8</a></article>
      <article class="record-card"><MetaPill label="v0.9 · Phases 140–144" /><h3><a href="/review/v09/">Living Public Intelligence</a></h3><p>{v09.summary}</p><a class="inline-link" href="/review/v09/">Open v0.9</a></article>
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Phases 125–129</div><h2>Open Evidence Review</h2><p>Read what the current Published corpus supports, where each mission requirement remains incomplete, how named projects and places convert, and why cross-system evidence is—or is not—compatible.</p></div><MetaPill label={`${v06.counts.substantive_surfaces} surfaces`} tone="possibility" /></div>
    <div class="signal-grid">
      <article class="record-card"><MetaPill label="Phase 125" /><h3><a href="/review/fieldbook/evidence-notes/">Evidence annotations</a></h3><p>Eighty-two Published signals receive source-resolved support and excluded-inference notes.</p></article>
      <article class="record-card"><MetaPill label="Phase 126" /><h3><a href="/review/fieldbook/mission-audits/">Mission evidence audits</a></h3><p>All 204 required-evidence items are screened for title/factual-nucleus overlap without changing a mission answer state.</p></article>
      <article class="record-card"><MetaPill label="Phase 127" /><h3><a href="/review/fieldbook/delivery-biographies/">Delivery biographies</a></h3><p>Twenty-four projects and fifteen places gain authored conversion histories and explicit unresolved bridges.</p></article>
      <article class="record-card"><MetaPill label="Phase 128" /><h3><a href="/review/fieldbook/topic-reviews/">Topic evidence reviews</a></h3><p>Seventeen topics connect their four mission horizons to current evidence and next-artifact work.</p></article>
      <article class="record-card"><MetaPill label="Phase 129" /><h3><a href="/review/fieldbook/system-reviews/">Compatibility syntheses</a></h3><p>Twelve systems expose identity, stage, geography, period and denominator compatibility.</p></article>
    </div>
    <p><a class="inline-link" href="/review/v06/">Open the complete v0.6 review</a></p>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Phases 120–124</div><h2>Evidence Fieldbook</h2><p>Move from a Candidate authority rail to an exact acquisition contract, bounded research mission, verification method, context-only comparison, and active topic workbench.</p></div><MetaPill label={`${v05.counts.substantive_surfaces} surfaces`} tone="possibility" /></div>
    <div class="signal-grid">
      <article class="record-card"><MetaPill label="Phase 120" /><h3><a href="/review/fieldbook/acquisition/">Authority-to-artifact packets</a></h3><p>Eighty prepared packets and 320 exact artifact targets; no artifact has been admitted.</p></article>
      <article class="record-card"><MetaPill label="Phase 121" /><h3><a href="/review/fieldbook/missions/">Priority research missions</a></h3><p>All 68 canonical questions become transparent, unadjudicated research contracts.</p></article>
      <article class="record-card"><MetaPill label="Phase 122" /><h3><a href="/review/fieldbook/method/">Verification playbooks</a></h3><p>Thirty procedural guides across stages, claims, and independent quality dimensions.</p></article>
      <article class="record-card"><MetaPill label="Phase 123" /><h3><a href="/review/fieldbook/casebooks/">Matched delivery dossiers</a></h3><p>Twelve cross-system stories now use explicit evidence IDs and comparison passports.</p></article>
      <article class="record-card"><MetaPill label="Phase 124" /><h3><a href="/review/fieldbook/topics/">Topic workbenches</a></h3><p>Seventeen operational indexes connect the whole Fieldbook without changing evidence state.</p></article>
    </div>
    <p><a class="inline-link" href="/review/v05/">Open the complete v0.5 Evidence Fieldbook</a></p>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Phases 116–119</div><h2>Public Conversion Observatory</h2><p>Move from a coverage question to an official authority rail, an authored explanation, and a named project or receiving place—without collapsing one evidence stage into another.</p></div><MetaPill label={`${v04.counts.public_html_routes} routes`} tone="possibility" /></div>
    <div class="signal-grid">
      <article class="record-card"><MetaPill label="Phase 116" /><h3><a href="/review/coverage/">Coverage architecture</a></h3><p>Seventeen topics, eight conversion stages, twelve claim types, and a public completion rubric.</p></article>
      <article class="record-card"><MetaPill label="Phase 117" /><h3><a href="/review/authority/">Global authority graph</a></h3><p>Twenty jurisdiction layers and eighty official Candidate discovery rails.</p></article>
      <article class="record-card"><MetaPill label="Phase 118" /><h3><a href="/review/encyclopedia/">Living encyclopedia</a></h3><p>Twenty-seven maintained chapters with evidence lineage, contested interpretations, and decisive evidence.</p></article>
      <article class="record-card"><MetaPill label="Phase 119" /><h3><a href="/atlas/projects/">Project and place atlas</a></h3><p>Twenty-four projects and fifteen places, with governed and curated coverage tiers kept visible.</p></article>
    </div>
    <p><a class="inline-link" href="/review/v04/">Open the complete v0.4 program</a></p>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Canonical chapters</div><h2>Start with a system.</h2></div><a class="inline-link" href="/review/method/">How synthesis works</a></div>
    <div class="signal-grid">
      {program.topics.map((topic) => (
        <article class="record-card">
          <MetaPill label="Topic review" />
          <h3><a href={`/review/topics/${topic.slug}/`}>{topic.name}</a></h3>
          <p>Read the current evidence, limits, constraints and next questions as one bounded chapter.</p>
          <div class="button-row"><a class="inline-link" href={`/review/topics/${topic.slug}/`}>Open chapter</a><a class="inline-link" href={`/learn/${topic.slug}/`}>Learning edition</a></div>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section briefing-band">
    <div class="briefing-band__copy">
      <div class="eyebrow">Place portraits</div>
      <h2>See where the stack has to land.</h2>
      <p>Five local systems collect the power, water, land, workforce, finance, authority and legitimacy constraints that decide whether frontier signals convert.</p>
    </div>
    <div class="source-list">
      {program.local_systems.map((system) => (
        <article class="source-row"><h3><a href={`/review/places/${system.slug}/`}>{system.name}</a></h3><p>{system.summary}</p></article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Narrative casebooks</div><h2>Follow named files, not generic promise.</h2></div></div>
    <div class="signal-grid">
      {program.casebooks.map((record) => (
        <article class="record-card"><MetaPill label={record.kind === "local_project" ? "Project file" : "Adoption case"} /><h3><a href={`/review/casebooks/${record.slug}/`}>{record.title}</a></h3><p>{record.editorial_question}</p><a class="inline-link" href={`/review/journeys/${record.slug}/`}>Follow the full evidence journey</a></article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Cross-system atlas</div><h2>Read across the silos.</h2></div></div>
    <div class="signal-grid">
      {program.cross_system_stories.map((story) => (
        <article class="record-card"><MetaPill label="Cross-system story" tone="possibility" /><h3><a href={`/review/systems/${story.slug}/`}>{story.title}</a></h3><p>{story.editorial_question}</p></article>
      ))}
    </div>
  </section>

  <section class="page-section briefing-band">
    <div class="briefing-band__copy"><div class="eyebrow">Living publication</div><h2>Maintenance is part of the product.</h2><p>Freshness, corrections and scheduled review are public surfaces—not invisible editorial chores.</p></div>
    <div class="source-list">
      <a class="source-row" href="/review/state-of-frontier-systems/"><strong>State of frontier systems</strong><span>Current edition</span></a>
      <a class="source-row" href="/review/outcomes/tsmc-arizona/"><strong>Outcomes observatory</strong><span>Eight named measurement files</span></a>
      <a class="source-row" href="/review/uncertainty/advanced-manufacturing/"><strong>Uncertainty library</strong><span>Seventeen topic challenges</span></a>
      <a class="source-row" href="/review/freshness/"><strong>Freshness board</strong><span>What needs review next</span></a>
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading"><div><div class="eyebrow">Evidence in public context</div><h2>The next content shelf is open.</h2><p>Phases 111–115 connect live evidence operations to more places, named cases, comparative reports and accessible reading forms.</p></div><MetaPill label={`${expansion.counts.public_routes} new routes`} tone="possibility" /></div>
    <div class="signal-grid">
      <article class="record-card"><MetaPill label="Phase 111" /><h3><a href="/review/evidence-cycle/">Evidence Cycle 001</a></h3><p>See all thirteen gates with dated decisions and future scheduled checks kept separate.</p></article>
      <article class="record-card"><MetaPill label="Phase 112" /><h3><a href={`/review/regions/${expansion.regions[0].slug}/`}>Fifteen local-system portraits</a></h3><p>Ten additional place-bound views extend the original five-system editorial shelf.</p></article>
      <article class="record-card"><MetaPill label="Phase 113" /><h3><a href={`/review/casebooks/expanded/${expansion.casebooks[0].slug}/`}>Twenty-four named casebooks</a></h3><p>Sixteen new asset, delivery and operating narratives join the original eight.</p></article>
      <article class="record-card"><MetaPill label="Phase 114" /><h3><a href={`/review/reports/${expansion.reports[0].slug}/`}>Four comparative reports</a></h3><p>Long-form synthesis across infrastructure, adoption, utilities and delivery.</p></article>
      <article class="record-card"><MetaPill label="Phase 115" /><h3><a href="/review/accessibility/">Accessible and jurisdiction editions</a></h3><p>Linear reading forms, five jurisdiction lenses and transparent translation-review status.</p></article>
    </div>
  </section>
</BaseLayout>
