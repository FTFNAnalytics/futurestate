import p178 from "../../../../data/phase-178-systems-atlas-and-compendium-depth-expansion.json";
import p179 from "../../../../data/phase-179-october-weekly-editions-and-month-end-synthesis.json";
import p180 from "../../../../data/phase-180-october-state-report-and-v1-promotion-gate.json";
import { v1refDefinitions } from "../../../../data/v1ref-registry";

export function getStaticPaths() {
  const definitions: any[] = [
    ["v07", "authority-gaps", p130, p130.gap_maps], ["v07", "admission-dockets", p131, p131.admission_dockets], ["v07", "source-checks", p132, p132.source_check_receipts], ["v07", "requirements", p133, p133.adjudication_items], ["v07", "missions", p134, p134.mission_decisions],
    ["v08", "readiness", p135, p135.readiness_records], ["v08", "projects", p136, p136.project_chronicles], ["v08", "places", p137, p137.place_ledgers], ["v08", "longitudinal", p138, p138.eligibility_records], ["v08", "comparisons", p139, p139.comparison_reviews],
    ["v09", "desks", p140, p140.topic_desks], ["v09", "almanac", p141, p141.almanac_entries], ["v09", "roadmaps", p142, p142.topic_roadmaps], ["v09", "editions", p143, p143.editions], ["v09", "launch-audit", p144, p144.launch_gates],
    ["v1rc", "gate-journal", p145, p145.gate_operations], ["v1rc", "authority-resolution", p146, p146.gap_dispositions], ["v1rc", "adjudication", p147, p147.adjudication_records], ["v1rc", "changefeed", p148, p148.changefeed_reviews], ["v1rc", "longitudinal-lab", p149, p149.longitudinal_reviews],
    ["v1rc", "comparison-passports", p150, p150.comparison_passports], ["v1rc", "desk-reviews", p151, p151.desk_review_ledgers], ["v1rc", "field-guides", p152, p152.field_guides], ["v1rc", "reports", p153, p153.flagship_reports], ["v1rc", "edition-packets", p154, p154.edition_packets], ["v1rc", "method-library", p155, p155.method_records], ["v1rc", "launch-decision", p156, p156.launch_gates],
    ["v1month", "candidate-preservation", p157, p157.preservation_records], ["v1month", "september-operations", p158, p158.operation_packets], ["v1month", "owner-sprint", p159, p159.authority_mission_boards], ["v1month", "longitudinal-pilots", p160, p160.pilot_matrices],
    ["v1month", "stack-watch", p161, p161.stack_watch_packets], ["v1month", "local-systems", p162, p162.local_system_briefs], ["v1month", "editorial-runbooks", p163, p163.editorial_runbooks], ["v1month", "monthly-decision", p164, p164.readiness_gates],
    ["v1cycle", "live-operations", p165, p165.operation_runs], ["v1cycle", "weekly-editions", p166, p166.weekly_cycles], ["v1cycle", "authority-hearings", p167, p167.authority_hearings], ["v1cycle", "mission-adjudication", p168, p168.adjudication_dockets],
    ["v1cycle", "longitudinal-adjudication", p169, p169.longitudinal_adjudication_packets], ["v1cycle", "systems-atlas", p170, p170.place_system_dossiers], ["v1cycle", "systems-compendium", p171, p171.compendium_records], ["v1cycle", "september-state", p172, p172.state_report_gates],
    ["v1oct", "operating-foundation", p173, p173.carryover_records], ["v1oct", "cycle-closure-intake", p174, [...p174.cycle_001_closeout.audit_items, ...p174.cycle_002_intake.candidates]],
    ["v1oct", "owner-dispositions", p175, p175.owner_disposition_packets], ["v1oct", "longitudinal-decisions", p176, [...p176.pilot_admission_packets, p176.zero_series_owner_disposition]],
    ["v1oct", "october-stack-watch", p177, p177.packets], ["v1oct", "atlas-depth", p178, [...p178.place_system_dossiers, ...p178.comparison_overlays, ...p178.interpretive_essays]], ["v1oct", "october-editions", p179, p179.editorial_cycles], ["v1oct", "october-state", p180, p180.state_report_gates],
    ...v1refDefinitions.map(({ release, section, registry, items }) => [release, section, registry, items]),
  ];
  return definitions.map(([release, section, registry, items]) => ({
    params: { release, section },
    props: { registry, items, phase: registry.phase, canonicalRoute: release === "v1ref" ? `/reference/${section}/` : undefined },
  }));
}
const { registry, items, phase, canonicalRoute } = Astro.props;
const { release } = Astro.params;
---
<BaseLayout title={`${registry.title} | FTFN`} description={registry.summary} canonical={canonicalRoute}><RegistryHub registry={registry} items={items} phase={phase} release={release} /></BaseLayout>
