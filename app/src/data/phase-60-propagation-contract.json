  "decision_rules": {
    "material_change": "Update every affected reader surface in the same reviewed change set. A material source record may not change only the signal while leaving canonical synthesis stale.",
    "no_material_change": "Retain the prior record state, publish a bounded receipt, propagate the check through the assigned surfaces, and set the next exact artifact and date.",
    "watch_change": "Issue a Watch Note when the expected artifact, source authority, cadence, or next date changes without changing the underlying public record.",
    "correction": "Preserve the prior claim and correction trail, update every affected surface, and keep the change reversible in Git.",
    "blocked_check": "A blocked check requires a visible receipt naming the attempted surface, blocker, evidence boundary, and next action; silence is not a valid state."
  },
  "publication_boundary": "No source check, receipt, private database row, scheduled task, or generated draft can publish directly. Human review, static serialization, release validation, and a Git commit remain mandatory.",
