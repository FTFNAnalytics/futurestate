{
  "name": "ftfn-app",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/run-astro.mjs dev",
    "build": "node ./scripts/run-astro.mjs check && node ./scripts/run-astro.mjs build",
    "build:research-archive": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-research-archive.ps1",
    "prepare:sites": "node ./scripts/prepare-sites-package.mjs",
    "audit:candidate-links": "node ./scripts/audit-source-candidate-links.mjs",
    "preview": "node ./scripts/run-astro.mjs preview",
    "check": "node ./scripts/run-astro.mjs check",
    "validate:candidates": "node ./scripts/validate-source-candidates.mjs",
    "validate:content": "node ./scripts/validate-content-references.mjs",
    "source:health": "node ./scripts/source-health-report.mjs",
    "verify:release": "node ./scripts/verify-release.mjs",
    "verify:phase56k": "node ./scripts/assert-phase56k.mjs",
    "verify:phase56l": "node ./scripts/assert-phase56l.mjs",
    "verify:phase56m": "node ./scripts/assert-phase56m.mjs",
    "verify:phase56n": "node ./scripts/assert-phase56n.mjs",
    "verify:phase56o": "node ./scripts/assert-phase56o.mjs",
    "verify:phase56p": "node ./scripts/assert-phase56p.mjs",
    "verify:phase56q": "node ./scripts/assert-phase56q.mjs",
    "verify:phase56r": "node ./scripts/assert-phase56r.mjs",
    "verify:phase56s": "node ./scripts/assert-phase56s.mjs",
    "verify:phase56t": "node ./scripts/assert-phase56t.mjs",
    "verify:phase56u": "node ./scripts/assert-phase56u.mjs",
    "verify:phase56v": "node ./scripts/assert-phase56v.mjs",
    "verify:phase56w": "node ./scripts/assert-phase56w.mjs",
    "verify:phase56x": "node ./scripts/assert-phase56x.mjs",
    "verify:phase56y": "node ./scripts/assert-phase56y.mjs",
    "verify:phase56z": "node ./scripts/assert-phase56z.mjs",
    "verify:phase57a": "node ./scripts/assert-phase57a.mjs",
    "verify:phase57b": "node ./scripts/assert-phase57b.mjs",
    "verify:phase57c": "node ./scripts/assert-phase57c.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.7.0"
  }
}
